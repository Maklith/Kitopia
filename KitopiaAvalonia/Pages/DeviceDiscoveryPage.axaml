<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Core.ViewModel.Pages.device;assembly=Core"
             xmlns:pluginCore="clr-namespace:PluginCore;assembly=PluginCore"
             xmlns:converter="clr-namespace:KitopiaAvalonia.Converter"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KitopiaAvalonia.Pages.DeviceDiscoveryPage"
             x:DataType="vm:DeviceDiscoveryPageViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="DiscoveryPanelBackgroundBrush" Color="{DynamicResource SemiBackground1Color}"
                         Opacity="0.76" />
        <SolidColorBrush x:Key="DiscoveryCardBackgroundBrush" Color="{DynamicResource SemiBackground0Color}"
                         Opacity="0.8" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="10">
        <Border Padding="10"
                CornerRadius="10"
                Background="{StaticResource DiscoveryPanelBackgroundBrush}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="设备发现" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="正在扫描..."
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText1}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DiscoveredDevices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pluginCore:DeviceModel">
                        <Border Margin="0,0,10,10"
                                Padding="12"
                                CornerRadius="12"
                                Background="{StaticResource DiscoveryCardBackgroundBrush}"
                                BorderBrush="{DynamicResource SemiColorBorder}"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                MinWidth="360"
                                MaxWidth="420">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Orientation="Vertical" Spacing="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Label Theme="{DynamicResource TagLabel}" Classes="Blue" 
                                                   IsVisible="{Binding SupportQuic}">Quic</Label>
                                            <Label Theme="{DynamicResource TagLabel}" Classes="Green"
                                                   IsVisible="{Binding HasIpv6}">IPv6</Label>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                        
                                        <TextBlock Text="{Binding ComputerName, StringFormat='计算机名: {0}'}"
                                                   Foreground="{DynamicResource SemiColorText1}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="4">
                                    <TextBlock Text="{Binding Ipv4Address, StringFormat='IPv4: {0}'}"
                                               Foreground="{DynamicResource SemiColorText1}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasIpv4}" />
                                    <TextBlock Text="{Binding Ipv6Address, StringFormat='IPv6: {0}'}"
                                               Foreground="{DynamicResource SemiColorText1}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasIpv6}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" >
                                        <TextBlock Text="{Binding TcpPort, StringFormat='TCP端口: {0}'}"
                                                   Foreground="{DynamicResource SemiColorText1}" />
                                        <TextBlock Text="{Binding QuicPort, StringFormat='QUIC端口: {0}'}"
                                                   IsVisible="{Binding SupportQuic}" Foreground="{DynamicResource SemiColorText1}" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBox Watermark="给该设备设置备注名"
                                             Text="{Binding CustomName}" />
                                    <Button Grid.Column="1"
                                            Content="保存备注"
                                            Command="{Binding $parent[UserControl].((vm:DeviceDiscoveryPageViewModel)DataContext).SaveCustomNameCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2"
                                            Content="清除"
                                            Command="{Binding $parent[UserControl].((vm:DeviceDiscoveryPageViewModel)DataContext).ClearCustomNameCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
