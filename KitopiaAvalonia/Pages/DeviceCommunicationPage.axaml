<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:KitopiaAvalonia.Controls"
             xmlns:vm="clr-namespace:Core.ViewModel.Pages.device;assembly=Core"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="KitopiaAvalonia.Pages.DeviceCommunicationPage"
             x:DataType="vm:DeviceCommunicationPageViewModel">
    <UserControl.Resources>
        <SolidColorBrush x:Key="IncomingBubbleBrush" Color="{DynamicResource SemiBackground2Color}" Opacity="0.9" />
        <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="{DynamicResource SemiBlue5Color}" Opacity="0.86" />

        <DataTemplate x:Key="DefaultChatMessageTemplate" x:DataType="vm:DeviceChatMessageItem">
            <StackPanel Margin="0,0,0,8">
                <Border MaxWidth="420" Padding="10"
                        IsVisible="{Binding IsIncoming}"
                        Background="{StaticResource IncomingBubbleBrush}"
                        CornerRadius="10"
                        HorizontalAlignment="Left">
                    <StackPanel Spacing="6">
                        <Image Source="{Binding ImagePreview}"
                               IsVisible="{Binding HasImage}"
                               MaxWidth="320" Stretch="Uniform"
                               Cursor="Hand"
                               PointerPressed="OnPreviewImagePointerPressed">
                            <Image.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="放大查看" Click="OnPreviewImageZoomClicked" />
                                    <MenuItem Header="复制图片"
                                              Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).CopyImageCommand}"
                                              CommandParameter="{Binding .}" />
                                </MenuFlyout>
                            </Image.ContextFlyout>
                        </Image>
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                             IsVisible="{Binding HasText}" />
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding CanHandleIncomingOffer}">
                            <Button Classes="Primary" Content="接受"
                                    Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).AcceptIncomingOfferCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Classes="Secondary" Content="拒绝"
                                    Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).RejectIncomingOfferCommand}"
                                    CommandParameter="{Binding .}" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding IsReceiving}">
                            <ProgressBar Minimum="0" Maximum="1"
                                         Value="{Binding ReceiveProgress}"
                                         Height="6" MinWidth="220" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding TimeText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock Text="{Binding StateText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       IsVisible="{Binding HasState}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border MaxWidth="420" Padding="10"
                        IsVisible="{Binding IsOutgoing}"
                        Background="{StaticResource OutgoingBubbleBrush}"
                        CornerRadius="10"
                        HorizontalAlignment="Right">
                    <StackPanel Spacing="6">
                        <Image Source="{Binding ImagePreview}"
                               IsVisible="{Binding HasImage}"
                               MaxWidth="320" Stretch="Uniform"
                               Cursor="Hand"
                               PointerPressed="OnPreviewImagePointerPressed">
                            <Image.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="放大查看" Click="OnPreviewImageZoomClicked" />
                                    <MenuItem Header="复制图片"
                                              Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).CopyImageCommand}"
                                              CommandParameter="{Binding .}" />
                                </MenuFlyout>
                            </Image.ContextFlyout>
                        </Image>
                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                             IsVisible="{Binding HasText}"
                                             Foreground="White" />
                        <StackPanel Spacing="4" IsVisible="{Binding IsReceiving}">
                            <ProgressBar Minimum="0" Maximum="1"
                                         Value="{Binding ReceiveProgress}"
                                         Height="6" MinWidth="220" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding TimeText}"
                                       FontSize="11"
                                       Foreground="White" Opacity="0.85" />
                            <TextBlock Text="{Binding StateText}"
                                       FontSize="11"
                                       Foreground="White" Opacity="0.85"
                                       IsVisible="{Binding HasState}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="FileChatMessageTemplate" x:DataType="vm:FileChatMessageItem">
            <StackPanel Margin="0,0,0,8">
                <Border MaxWidth="420" Padding="0"
                        IsVisible="{Binding IsIncomingFileOffer}"
                        Background="{StaticResource IncomingBubbleBrush}"
                        CornerRadius="10"
                        HorizontalAlignment="Left"
                        DoubleTapped="OnFileCardDoubleTapped"
                        Cursor="Hand">
                    <StackPanel>
                        <Border Background="{DynamicResource SemiColorFill1}" CornerRadius="8" Padding="12" Margin="8">
                            <StackPanel Spacing="0">
                                <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                                    <Border Width="64" Height="64" CornerRadius="6"
                                            Background="{DynamicResource SemiColorFill0}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding FileIcon}" Width="48" Height="48"
                                               Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                        <TextBlock Text="{Binding FileSizeText}"
                                                   Foreground="{DynamicResource SemiColorText1}"
                                                   FontSize="{DynamicResource SemiFontSizeSmall}" />
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReceiveProgress}"
                                                     Height="4" IsVisible="{Binding IsReceiving}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="6" Margin="0,8,0,0"
                                            IsVisible="{Binding CanHandleIncomingOffer}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="Primary" Content="接受"
                                                Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).AcceptIncomingOfferCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Classes="Secondary" Content="拒绝"
                                                Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).RejectIncomingOfferCommand}"
                                                CommandParameter="{Binding .}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                           Foreground="{DynamicResource SemiColorText2}"
                                           IsVisible="{Binding HasState}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,4,12,8">
                            <TextBlock Text="{Binding TimeText}" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>
                    </StackPanel>
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem Header="打开"
                                      Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).OpenFileCommand}"
                                      CommandParameter="{Binding .}" />
                            <MenuItem Header="另存为..."
                                      Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).SaveAsFileCommand}"
                                      CommandParameter="{Binding .}" />
                            <MenuItem Header="复制文件"
                                      Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).CopyFileCommand}"
                                      CommandParameter="{Binding .}" />
                            <Separator />
                            <MenuItem Header="取消传输"
                                      IsVisible="{Binding IsTransferActive}"
                                      Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).CancelTransferCommand}"
                                      CommandParameter="{Binding .}" />
                            <MenuItem Header="查看详情"
                                      Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).ViewFileDetailsCommand}"
                                      CommandParameter="{Binding .}" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                </Border>

                <Border MaxWidth="420" Padding="0"
                        IsVisible="{Binding IsOutgoing}"
                        Background="{StaticResource OutgoingBubbleBrush}"
                        CornerRadius="10"
                        HorizontalAlignment="Right"
                        DoubleTapped="OnFileCardDoubleTapped"
                        Cursor="Hand">
                    <StackPanel>
                        <Border Background="#33FFFFFF" CornerRadius="8" Padding="12" Margin="8">
                            <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                                <Border Width="64" Height="64" CornerRadius="6"
                                        Background="#22FFFFFF"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding FileIcon}" Width="48" Height="48"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="280"
                                               Foreground="White" />
                                    <TextBlock Text="{Binding FileSizeText}"
                                               Foreground="White" Opacity="0.85"
                                               FontSize="{DynamicResource SemiFontSizeSmall}" />
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReceiveProgress}"
                                                 Height="4" IsVisible="{Binding IsReceiving}"
                                                 Foreground="White" />
                                    <TextBlock Text="{Binding StateText}" FontSize="11"
                                               Foreground="White" Opacity="0.85"
                                               IsVisible="{Binding HasState}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,4,12,8">
                            <TextBlock Text="{Binding TimeText}" FontSize="11"
                                       Foreground="White" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>
                    <Border.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem Header="取消传输"
                                      IsVisible="{Binding IsTransferActive}"
                                      Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).CancelTransferCommand}"
                                      CommandParameter="{Binding .}" />
                            <MenuItem Header="查看详情"
                                      Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).ViewFileDetailsCommand}"
                                      CommandParameter="{Binding .}" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                </Border>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid ColumnDefinitions="320,4,*" Margin="{DynamicResource SemiThicknessBase}">
        <Border Grid.Column="0" Theme="{DynamicResource KitopiaCard}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="设备聊天" Classes="H5" Theme="{DynamicResource TitleTextBlock}" />
                    <TextBlock Text="局域网在线会话"
                               Foreground="{DynamicResource SemiColorText1}"
                               FontSize="{DynamicResource SemiFontSizeSmall}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceConversationItem">
                            <Border Margin="0,0,0,8" Padding="12"
                                    Theme="{DynamicResource KitopiaCardBorderless}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Label Theme="{DynamicResource TagLabel}" Classes="Green"
                                               IsVisible="{Binding HasIpv6}"
                                               FontSize="{DynamicResource SemiFontSizeSmall}">IPv6</Label>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource SemiColorDanger}"
                                                Padding="6,2" CornerRadius="10"
                                                IsVisible="{Binding HasUnread}">
                                            <TextBlock Text="{Binding UnreadCountText}"
                                                       Foreground="White"
                                                       FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Text="{Binding LastMessagePreview}"
                                                   Foreground="{DynamicResource SemiColorText1}"
                                                   FontSize="{DynamicResource SemiFontSizeSmall}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Ipv4AddressText}"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       FontSize="11"
                                                       IsVisible="{Binding HasIpv4}" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding LastMessageTimeText}"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               FontSize="11"
                                               VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="暂无在线设备"
                           IsVisible="{Binding HasNoConversations}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText1}" />
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      Width="4"
                      Background="{DynamicResource SemiColorBorder}"
                      CornerRadius="2"
                      Margin="0,8" />

        <Border Grid.Column="2" Theme="{DynamicResource KitopiaCard}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
                <StackPanel Spacing="4" Margin="0,0,0,12">
                    <TextBlock Text="{Binding CurrentConversationTitle}"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentConversationSubtitle}"
                               Foreground="{DynamicResource SemiColorText1}"
                               FontSize="{DynamicResource SemiFontSizeSmall}" />
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource SemiColorFill0}"
                        CornerRadius="8" Padding="12">
                    <Grid>
                        <ScrollViewer x:Name="ConversationScrollViewer"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CurrentMessages}">
                                <ItemsControl.ItemTemplate>
                                    <controls:ChatMessageTemplateSelector
                                        DefaultMessageTemplate="{StaticResource DefaultChatMessageTemplate}"
                                        FileMessageTemplate="{StaticResource FileChatMessageTemplate}" />
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="请选择在线设备开始聊天"
                                   IsVisible="{Binding ShowConversationPlaceholder}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorText1}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource SemiColorFill0}"
                        CornerRadius="8" Padding="10" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding MessageText}"
                                 Watermark="输入消息..."
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 MinHeight="36"
                                 VerticalAlignment="Stretch"
                                 IsEnabled="{Binding HasConversationSelected}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                                <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteSendCommand}" />
                            </TextBox.KeyBindings>
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="剪切" Command="{Binding $parent[TextBox].Cut}" InputGesture="Ctrl+X" />
                                    <MenuItem Header="复制" Command="{Binding $parent[TextBox].Copy}" InputGesture="Ctrl+C" />
                                    <MenuItem Header="粘贴发送"
                                              Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).PasteSendCommand}"
                                              InputGesture="Ctrl+V" />
                                    <Separator />
                                    <MenuItem Header="全选" Command="{Binding $parent[TextBox].SelectAll}" InputGesture="Ctrl+A" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                        <Button Grid.Column="1" MinWidth="36" MinHeight="36"
                                Classes="Tertiary"
                                Command="{Binding SendFileCommand}"
                                IsEnabled="{Binding HasConversationSelected}">
                            <controls:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="&#xf418;" FontSize="16" />
                        </Button>
                        <Button Grid.Column="2" MinWidth="36" MinHeight="36"
                                Classes="Primary"
                                Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding HasConversationSelected}">
                            <controls:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="&#xf699;" FontSize="16" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
