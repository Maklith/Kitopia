<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Core.ViewModel.Pages;assembly=Core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="pages:MarketPageViewModel"
             x:Class="KitopiaAvalonia.Pages.MarketPage">
    <Panel>
        <ContentPresenter ZIndex="1" x:Name="DialogOvercover" />

        <Grid RowDefinitions="Auto,*" Margin="{DynamicResource SemiThicknessExtraLoose}" RowSpacing="16">
            <TextBlock Classes="H5" Theme="{DynamicResource TitleTextBlock}" Text="插件市场" />
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Plugins}" Margin="4,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="300" Height="210"
                                    Theme="{DynamicResource KitopiaCard}" Margin="4">
                                <Grid ColumnDefinitions="68,*" RowDefinitions="*,36">
                                    <Image Grid.Column="0"
                                           Width="56" Height="56"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Margin="0,4,0,0"
                                           Source="{Binding Icon}" />
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                        <Button Content="{Binding PluginBaseInfo.Name}"
                                                Padding="0" MinHeight="0"
                                                Theme="{DynamicResource BorderlessButton}"
                                                HorizontalAlignment="Left"
                                                FontWeight="SemiBold" FontSize="16"
                                                Foreground="{DynamicResource SemiColorText0}"
                                                Command="{Binding Path=$parent[ItemsControl].((pages:MarketPageViewModel)DataContext).ShowPluginDetailCommand}"
                                                CommandParameter="{Binding }" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ItemsControl ItemsSource="{Binding OnlinePluginInfo.SupportSystems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Label Theme="{StaticResource TagLabel}" Content="{Binding .}"
                                                               Classes="Ghost Cyan" Margin="0,0,4,0"
                                                               FontSize="{DynamicResource SemiFontSizeSmall}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <TextBlock Text="{Binding OnlinePluginInfo.DescriptionShort}"
                                                   TextWrapping="Wrap" MaxLines="2"
                                                   Foreground="{DynamicResource SemiColorText1}"
                                                   FontSize="{DynamicResource SemiFontSizeSmall}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding OnlinePluginInfo.LastVersion}"
                                                       FontSize="{DynamicResource SemiFontSizeSmall}"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBlock Text="{Binding AuthorName}"
                                                       FontSize="{DynamicResource SemiFontSizeSmall}"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="Primary"
                                                IsEnabled="{Binding !InLocal}"
                                                Command="{Binding Path=$parent[ItemsControl].((pages:MarketPageViewModel)DataContext).DownloadPluginCommand}"
                                                CommandParameter="{Binding OnlinePluginInfo}">
                                            <Button.Styles>
                                                <Style Selector="Button[IsEnabled=True]">
                                                    <Setter Property="Content" Value="下载" />
                                                </Style>
                                                <Style Selector="Button[IsEnabled=False]">
                                                    <Setter Property="Content" Value="已安装" />
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
