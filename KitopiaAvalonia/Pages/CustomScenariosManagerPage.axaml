<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:customScenario="clr-namespace:Core.ViewModel.Pages.customScenario;assembly=Core"
             xmlns:converter="clr-namespace:KitopiaAvalonia.Converter"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="customScenario:CustomScenariosManagerPageViewModel"
             x:Class="KitopiaAvalonia.Pages.CustomScenariosManagerPage">
    <UserControl.Resources>
        <converter:ReverseBoolToVisibilityConverter x:Key="reverseBoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,*" Margin="{DynamicResource SemiThicknessExtraLoose}" RowSpacing="16">
        <TextBlock Classes="H5" Theme="{DynamicResource TitleTextBlock}" Text="情景列表" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="Primary" Command="{Binding NewCustomScenariosCommand}" Content="新建情景" />
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding CustomScenarios}" Margin="4,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Height="210"
                                Theme="{DynamicResource KitopiaCard}" Margin="4">
                            <Panel>
                                <Grid ColumnDefinitions="68,*" RowDefinitions="*,36">
                                    <Image Grid.Column="0"
                                           Width="56" Height="56"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Margin="0,4,0,0">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource PathToImageConverter}">
                                                <Binding Path="Icon" />
                                                <Binding Path="." />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Path=Name}"
                                                   FontWeight="SemiBold" FontSize="16"
                                                   Foreground="{DynamicResource SemiColorText0}" />
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap" MaxLines="2"
                                                   Foreground="{DynamicResource SemiColorText1}"
                                                   FontSize="{DynamicResource SemiFontSizeSmall}" />
                                        <TextBlock Text="{Binding LastRun, StringFormat='上次执行: yyyy/MM/dd HH:mm:ss'}"
                                                   FontSize="{DynamicResource SemiFontSizeSmall}"
                                                   Foreground="{DynamicResource SemiColorText2}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Classes="Secondary" Content="编辑"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).ToTaskEditPageCommand}"
                                                CommandParameter="{Binding }" />
                                        <Button Classes="Danger" Content="停止"
                                                IsVisible="{Binding IsRunning}"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).StopCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                        <Button Classes="Primary" Content="运行"
                                                IsVisible="{Binding IsRunning,Converter={StaticResource reverseBoolToVisibilityConverter}}"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).RunCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button Classes="Danger" Content="删除"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).RemoveCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                    </StackPanel>
                                </Grid>

                                <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1"
                                       IsVisible="{Binding !HasInit}">
                                    <Panel.Background>
                                        <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.4" />
                                    </Panel.Background>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Name}" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding InitError}" />
                                        <Button Classes="Danger" Content="删除" HorizontalAlignment="Center"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).RemoveCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                    </StackPanel>
                                </Panel>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
