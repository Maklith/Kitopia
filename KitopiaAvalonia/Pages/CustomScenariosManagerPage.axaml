<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:customScenario="clr-namespace:Core.ViewModel.Pages.customScenario;assembly=Core"
             xmlns:converter="clr-namespace:KitopiaAvalonia.Converter"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="customScenario:CustomScenariosManagerPageViewModel"
             x:Class="KitopiaAvalonia.Pages.CustomScenariosManagerPage">
    <UserControl.Resources>
        <converter:ReverseBoolToVisibilityConverter x:Key="reverseBoolToVisibilityConverter" />

    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,*" Margin="42">
        <TextBlock Margin="0" FontSize="18" FontWeight="Bold" Text="情景列表" />
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Foreground="{DynamicResource SemiColorText0}" Command="{Binding NewCustomScenariosCommand}">
                <Button.Content>
                    <Label Content="新建情景" />
                </Button.Content>
            </Button>

        </StackPanel>
        <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding CustomScenarios}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Theme="{DynamicResource CardBorder1}" Width="300"
                                CornerRadius="{DynamicResource RadiusCardCornerRadius}"
                                Height="185">
                            <Panel>
                                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                      ColumnDefinitions="80,*"
                                      RowDefinitions="84,*,48">
                                    <Image Grid.Column="0" HorizontalAlignment="Center" Margin="0,15,0,0"
                                           VerticalAlignment="Top" Focusable="False" Width="64"
                                           Height="64">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource PathToImageConverter}">
                                                <Binding Path="Icon" />
                                                <Binding Path="." />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <StackPanel Grid.Column="1" Margin="5,15,5,5" VerticalAlignment="Top" Spacing="5"
                                                HorizontalAlignment="Stretch">
                                        <TextBlock VerticalAlignment="Center" Focusable="False"
                                                   Text="{Binding Path=Name}"
                                                   Background="{x:Null}"
                                                   FontWeight="Normal" FontSize="18" />
                                        <ScrollViewer IsHitTestVisible="False"
                                                      VerticalAlignment="Stretch"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalScrollBarVisibility="Hidden">
                                            <TextBlock VerticalAlignment="Center"
                                                       MaxWidth="{Binding $parent.Bounds.Width}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Description}" />
                                        </ScrollViewer>


                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                Grid.ColumnSpan="2" Margin="5,15,5,5"
                                                Grid.Row="1">
                                        <TextBlock Text="{Binding LastRun, StringFormat='上次执行时间:yyyy/MM/dd HH:mm:ss'}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Margin="5,0,5,0" Spacing="5" Grid.ColumnSpan="2"
                                                Grid.Row="2"
                                                Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="编辑"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).ToTaskEditPageCommand}"
                                                CommandParameter="{Binding }" />
                                        <Button Classes="Danger"
                                                Content="停止"
                                                IsVisible="{Binding IsRunning}"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).StopCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                        <Button Content="运行" Classes="Success"
                                                IsVisible="{Binding IsRunning,Converter={StaticResource reverseBoolToVisibilityConverter}}"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).RunCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Margin="5,0,5,0" Spacing="5" Grid.ColumnSpan="2"
                                                Grid.Row="2"
                                                Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Classes="Danger" Content="删除"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).RemoveCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                    </StackPanel>

                                </Grid>
                                <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1"
                                       IsVisible="{Binding !HasInit}">
                                    <Panel.Background>
                                        <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.4" />
                                    </Panel.Background>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Name}" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding InitError}" />
                                        <Button Classes="Danger" Content="删除" HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).RemoveCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                    </StackPanel>
                                </Panel>

                            </Panel>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


    </Grid>
</UserControl>
