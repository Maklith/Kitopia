<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Core.ViewModel.Pages;assembly=Core"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="KitopiaAvalonia.Pages.HomePage"
             x:DataType="pages:HomePageViewModel">
    <Grid RowDefinitions="Auto,*" Margin="{DynamicResource SemiThicknessExtraLoose}">
        <TextBlock Classes="H5" Theme="{DynamicResource TitleTextBlock}" Text="首页" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel Spacing="{DynamicResource SemiSpacingBase}">
                <Border Classes="Shadow" Theme="{DynamicResource CardBorder}">
                    <StackPanel Spacing="{DynamicResource SemiSpacingBase}">
                        <TextBlock Theme="{DynamicResource SectionHeaderText}" Text="Toast 通知测试" />
                        <TextBlock Text="用于验证基础通知、按钮回调、自动消失时长和进度条通知。"
                                   Foreground="{DynamicResource SemiColorText1}" />

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SemiSpacingTight}">
                            <Button Classes="Primary" Content="基础通知"
                                    Command="{Binding ShowBasicToastCommand}" />
                            <Button Classes="Secondary" Content="按钮通知"
                                    Command="{Binding ShowActionToastCommand}" />
                            <Button Classes="Secondary" Content="8秒自动消失"
                                    Command="{Binding ShowLongTimeoutToastCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SemiSpacingTight}">
                            <Button Classes="Primary" Content="进度通知"
                                    Command="{Binding ShowProgressToastCommand}" />
                            <Button Classes="Secondary" Content="打开设置页"
                                    Command="{Binding ClickCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
