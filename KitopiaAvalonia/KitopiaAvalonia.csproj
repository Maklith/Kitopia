<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <WindowsPackageType>None</WindowsPackageType>
        <EnableMsixTooling>true</EnableMsixTooling>
    </PropertyGroup>

    <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))'">
        <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))'">
        <DefineConstants>$(DefineConstants);OSX</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableUnmanagedDebugging>true</EnableUnmanagedDebugging>
        <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
        <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
        <Version>0.1.4.10</Version>
        <AvaloniaVersion>11.3.2</AvaloniaVersion>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU;x64</Platforms>
    </PropertyGroup>


    <ItemGroup>
        <AvaloniaResource Include="Assets\FluentSystemIcons-Filled.ttf"/>
        <AvaloniaResource Include="Assets\FluentSystemIcons-Regular.ttf"/>
        <AvaloniaResource Include="Assets\HarmonyOS_Sans_SC_Regular.ttf"/>
        <AvaloniaResource Include="Assets\icon.png" />
    
        <Content Include="Assets\icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Assets\icon.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>

        <ProjectReference Condition=" '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' " Include="..\Core.Linux\Core.Linux.csproj"/>
        <ProjectReference Condition=" '$(OS)' == 'Windows_NT' " Include="..\Core.Window\Core.Window.csproj"/>
        <ProjectReference Include="..\NodifyM.Avalonia\NodifyM.Avalonia\NodifyM.Avalonia.csproj"/>
        <ProjectReference Include="..\Core\Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
        <PackageReference Condition="$(DefineConstants.Contains(ENABLE_XAML_HOT_RELOAD))" Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.0" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="HotAvalonia" Version="3.1.0" PrivateAssets="All" Publish="True" />
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.3" />
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Irihi.Ursa" Version="2.0.0" />
        <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.0.0" />
        <PackageReference Include="Markdown.Avalonia" Version="11.0.3-a1"/>
        <PackageReference Include="Semi.Avalonia" Version="12.0.1" />
        <PackageReference Include="Semi.Avalonia.ColorPicker" Version="12.0.1" />
        <PackageReference Include="Semi.Avalonia.DataGrid" Version="12.0.0" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="Windows\DialogWindow.axaml.cs">
            <DependentUpon>Dialog.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Windows\MainWindow.axaml.cs">
            <DependentUpon>MainWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Pages\HotKeyManagerPage.axaml.cs">
            <SubType>Code</SubType>
            <DependentUpon>HotKeyManagerPage.xaml</DependentUpon>
        </Compile>
        <Compile Update="Controls\Capture\DraggableResizeableControl.axaml.cs">
            <DependentUpon>DraggableResizeableControl.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Controls\Capture\DraggableArrowControl.axaml.cs">
            <DependentUpon>DraggableArrowControl.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Controls\Capture\CaptureToolBase.cs">
            <DependentUpon>CaptureToolBase.axaml</DependentUpon>
        </Compile>
        <Compile Update="Controls\DialogOvercover.axaml.cs">
            <DependentUpon>DialogWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Pages\OnnxModelManagerPage.axaml.cs">
            <DependentUpon>OnnxModelManagerPage.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Controls\Plugin\PluginDetail.axaml.cs">
            <DependentUpon>PluginDetail.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Windows\TaskEditor\TaskEditor.axaml.cs">
            <DependentUpon>TaskEditor.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Windows\TaskEditors\TaskEditorValueToScenarioMethodNode.axaml.cs">
            <DependentUpon>TaskEditorValueToScenarioMethodNode.axaml</DependentUpon>
        </Compile>
        <Compile Update="Windows\LongScreenshotProgressWindow.axaml.cs">
          <DependentUpon>LongScreenshotProgressWindow.axaml</DependentUpon>
        </Compile>
        <Compile Update="Services\ToastShowWindow.axaml.cs">
          <DependentUpon>ToastShowWindow.axaml</DependentUpon>
          <SubType>Code</SubType>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Converter\MarketPage\"/>
        <Folder Include="Converter\PluginManagerPage\"/>
        <Folder Include="Tools\"/>
    </ItemGroup>

</Project>
