<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
        x:Class="KitopiaAvalonia.Windows.LongScreenshotProgressWindow"
        Title="长截图进度"
        Width="300" Height="400"
        WindowStartupLocation="Manual"
        Topmost="True"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur">
    
    <Border CornerRadius="8" Background="Transparent" BorderThickness="1" >
        <Grid RowDefinitions="*,Auto">
            <Image    StretchDirection="Both" Name="PreviewImage" Grid.Row="0" Margin="0,0,0,10" Stretch="Uniform"/>
            
            <Button Name="StopButton" Grid.Row="1" Content="完成 / 停止" HorizontalAlignment="Center" Click="StopButton_Click"/>
        </Grid>
    </Border>
</Window>