<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KitopiaAvalonia.Controls.Capture">
    <Design.PreviewWith>
        <controls:TextCaptureTool />
    </Design.PreviewWith>

    <Style Selector="controls|TextCaptureTool">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Panel.Styles>
                        <Style Selector="Panel:pointerover">
                            <Setter Property="Background">
                                <SolidColorBrush Color="Gray" Opacity="0.1"></SolidColorBrush>
                            </Setter>
                        </Style>
                    </Panel.Styles>
                    <Panel.Background>
                        <SolidColorBrush Color="White" Opacity="0.01"></SolidColorBrush>
                    </Panel.Background>                   
                    <TextBox ZIndex="1"  Theme="{StaticResource LooklessTextBox}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                             Text="{TemplateBinding Text}"/>
                </Panel>

            </ControlTemplate>
        </Setter>
    </Style>
</Styles>