<u:UrsaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:KitopiaAvalonia.Services"
        xmlns:u="https://irihi.tech/ursa"
        mc:Ignorable="d"
        x:CompileBindings="False"
        x:Class="KitopiaAvalonia.Services.SuppressedNotificationCenterWindow"
        d:DesignWidth="350"
        d:DesignHeight="433"
        Deactivated="WindowBase_OnDeactivated"
        Width="350"
        Height="433"
        CanResize="False"
        TransparencyLevelHint="AcrylicBlur"
        WindowStartupLocation="Manual"
        IsFullScreenButtonVisible="False"
        IsCloseButtonVisible="False"
        IsTitleBarVisible="False"
        ShowInTaskbar="False"
        IsManagedResizerVisible="False"
        CanMaximize="False"
        CanMinimize="False"
        Topmost="True"
        Title="NotificationCenter">
    <u:UrsaWindow.Background>
        <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.55" />
    </u:UrsaWindow.Background>
    <Border Padding="10">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Text="未读通知" FontSize="16" FontWeight="Bold" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:SuppressedNotificationItemViewModel">
                            <Button Margin="0,0,0,8"
                                    Command="{Binding OpenCommand}"
                                    HorizontalContentAlignment="Stretch"
                                    HorizontalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                                <Border Margin="{DynamicResource ToastCardMargin}"
                                        Background="{DynamicResource ToastCardBackground}"
                                        CornerRadius="{DynamicResource ToastCardCornerRadius}">
                                    <Border BorderBrush="{DynamicResource SemiColorBorder}"
                                            BorderThickness="{DynamicResource ToastCardBorderThickness}"
                                            MinHeight="{DynamicResource ToastCardMinHeight}"
                                            Padding="{DynamicResource ToastCardPadding}"
                                            CornerRadius="{DynamicResource ToastCardCornerRadius}"
                                            BoxShadow="{DynamicResource NotificationCardBoxShadows}">
                                        <Grid RowDefinitions="Auto,Auto"
                                              ColumnDefinitions="Auto,*,Auto"
                                              RowSpacing="8"
                                              ColumnSpacing="12">
                                            <PathIcon Grid.Row="0"
                                                      Grid.Column="0"
                                                      Width="{DynamicResource ToastCardIconWidth}"
                                                      Height="{DynamicResource ToastCardIconHeight}"
                                                      Margin="{DynamicResource ToastCardIconMargin}"
                                                      VerticalAlignment="Top"
                                                      Data="{DynamicResource NotificationCardInformationIconPathData}"
                                                      Foreground="{DynamicResource NotificationCardInformationIconForeground}" />

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="1"
                                                       Text="{Binding Header}"
                                                       Foreground="{DynamicResource ToastCardContentForeground}"
                                                       FontWeight="{DynamicResource ToastCardContentFontWeight}"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="2"
                                                       Text="{Binding CreatedAtText}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Opacity="0.7" />

                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding Text}"
                                                       Foreground="{DynamicResource SemiColorText1}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</u:UrsaWindow>
