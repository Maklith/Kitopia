<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kitopia.Mobile.ViewModels"
             xmlns:deviceUi="clr-namespace:Core.UI.DeviceCommunication;assembly=Core"
             x:Class="Kitopia.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <SolidColorBrush x:Key="IncomingBubbleBrush" Color="{DynamicResource SemiBackground2Color}" Opacity="0.9" />
            <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="{DynamicResource SemiBlue5Color}" Opacity="0.86" />
        </Grid.Resources>

        <!-- 设备发现 -->
        <Border IsVisible="{Binding ShowDeviceList}"
                Margin="{DynamicResource SemiThicknessBase}"
                Theme="{DynamicResource KitopiaCard}">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="设备发现" Classes="H5" Theme="{DynamicResource TitleTextBlock}" />
                    <TextBlock Text="{Binding EmptyDevicesText}"
                               Foreground="{DynamicResource SemiColorText1}"
                               FontSize="{DynamicResource SemiFontSizeSmall}" />
                </StackPanel>

                <deviceUi:DeviceDiscoveryPage Grid.Row="1" x:Name="DevicePage" />
            </Grid>
        </Border>

        <!-- 聊天界面 -->
        <Border IsVisible="{Binding IsConversationOpen}"
                Margin="{DynamicResource SemiThicknessBase}"
                Theme="{DynamicResource KitopiaCard}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <!-- 标题栏 + 返回 -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Button MinWidth="0" MinHeight="0" Padding="8,4"
                            Classes="Tertiary"
                            Command="{Binding BackToDevicesCommand}">
                        <TextBlock Text="&#xf3de;" FontFamily="{StaticResource FluentFont}" FontSize="16" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DeviceList.SelectedDevice.PreferredTransportAddress}"
                                   Foreground="{DynamicResource SemiColorText1}"
                                   FontSize="{DynamicResource SemiFontSizeSmall}" />
                    </StackPanel>
                </Grid>

                <!-- 消息列表 -->
                <Border Grid.Row="1" Background="{DynamicResource SemiColorFill0}"
                        CornerRadius="8" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Conversation.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MobileMessageItemViewModel">
                                    <StackPanel Margin="0,0,0,8">
                                        <!-- 接收消息 -->
                                        <Border MaxWidth="360" Padding="10"
                                                IsVisible="{Binding IsIncoming}"
                                                Background="{StaticResource IncomingBubbleBrush}"
                                                CornerRadius="10"
                                                HorizontalAlignment="Left">
                                            <StackPanel Spacing="6">
                                                <SelectableTextBlock Text="{Binding Text}"
                                                                     TextWrapping="Wrap"
                                                                     IsVisible="{Binding HasText}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            IsVisible="{Binding CanHandleIncomingOffer}">
                                                    <Button Classes="Primary" Content="接受"
                                                            Command="{Binding $parent[UserControl].DataContext.Conversation.AcceptIncomingOfferCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Classes="Secondary" Content="拒绝"
                                                            Command="{Binding $parent[UserControl].DataContext.Conversation.RejectIncomingOfferCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <ProgressBar Minimum="0" Maximum="100"
                                                             Value="{Binding ProgressPercent}"
                                                             Height="6"
                                                             IsVisible="{Binding IsReceiving}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding TimestampText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText2}" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText2}"
                                                               IsVisible="{Binding HasState}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 发送消息 -->
                                        <Border MaxWidth="360" Padding="10"
                                                IsVisible="{Binding IsOutgoing}"
                                                Background="{StaticResource OutgoingBubbleBrush}"
                                                CornerRadius="10"
                                                HorizontalAlignment="Right">
                                            <StackPanel Spacing="6">
                                                <SelectableTextBlock Text="{Binding Text}"
                                                                     TextWrapping="Wrap"
                                                                     Foreground="White"
                                                                     IsVisible="{Binding HasText}" />
                                                <ProgressBar Minimum="0" Maximum="100"
                                                             Value="{Binding ProgressPercent}"
                                                             Height="6"
                                                             IsVisible="{Binding IsReceiving}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding TimestampText}"
                                                               FontSize="11"
                                                               Foreground="White" Opacity="0.85" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               Foreground="White" Opacity="0.85"
                                                               IsVisible="{Binding HasState}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 输入栏 -->
                <Border Grid.Row="2" Background="{DynamicResource SemiColorFill0}"
                        CornerRadius="8" Padding="8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <Button MinWidth="32" MinHeight="32" Padding="4"
                                Classes="Tertiary"
                                Command="{Binding Conversation.SendClipboardCommand}">
                            <TextBlock Text="&#xf418;" FontFamily="{StaticResource FluentFont}" FontSize="16" />
                        </Button>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Conversation.DraftText, Mode=TwoWay}"
                                 PlaceholderText="输入消息..."
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 MinHeight="32"
                                 VerticalAlignment="Stretch">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding Conversation.SendTextCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="2" MinWidth="32" MinHeight="32"
                                Classes="Tertiary"
                                Command="{Binding Conversation.SendFileCommand}">
                            <TextBlock Text="&#xf418;" FontFamily="{StaticResource FluentFont}" FontSize="16" />
                        </Button>
                        <Button Grid.Column="3" MinWidth="32" MinHeight="32"
                                Classes="Primary"
                                Command="{Binding Conversation.SendTextCommand}">
                            <TextBlock Text="&#xf699;" FontFamily="{StaticResource FluentFont}" FontSize="16" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
