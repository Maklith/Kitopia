<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kitopia.Mobile.ViewModels"
             x:Class="Kitopia.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*" Margin="16">
        <Border Padding="16"
                CornerRadius="8"
                BorderThickness="1">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding TitleText}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SubtitleText}"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Border IsVisible="{Binding ShowDeviceList}"
                    Padding="12"
                    CornerRadius="8"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Nearby devices"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EmptyDevicesText}"
                                   Opacity="0.72"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="Tap a device to open the conversation."
                               Opacity="0.58"
                               TextWrapping="Wrap" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding DeviceList.Devices}"
                             SelectedItem="{Binding DeviceList.SelectedDevice, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        CornerRadius="8"
                                        BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PreferredTransportAddress}"
                                                   Opacity="0.72"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TcpPort, StringFormat=TCP {0}}"
                                                   Opacity="0.58" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border IsVisible="{Binding IsConversationOpen}"
                    Padding="12"
                    CornerRadius="8"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button Content="Back"
                                Command="{Binding BackToDevicesCommand}" />
                        <StackPanel Grid.Column="1"
                                    Spacing="2">
                            <TextBlock Text="{Binding TitleText}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SubtitleText}"
                                       Opacity="0.72"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Conversation.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MobileMessageItemViewModel">
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            CornerRadius="8"
                                            BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="15"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding TimestampText}"
                                                           Opacity="0.58"
                                                           VerticalAlignment="Top" />
                                            </Grid>

                                            <TextBlock Text="{Binding StatusText}"
                                                       Opacity="0.72" />

                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding ProgressPercent}"
                                                         IsVisible="{Binding IsReceiving}" />

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        IsVisible="{Binding CanHandleIncomingOffer}">
                                                <Button Content="Accept"
                                                        Command="{Binding $parent[UserControl].DataContext.Conversation.AcceptIncomingOfferCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Reject"
                                                        Command="{Binding $parent[UserControl].DataContext.Conversation.RejectIncomingOfferCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        IsVisible="{Binding CanCancelTransfer}">
                                                <Button Content="Cancel"
                                                        Command="{Binding $parent[UserControl].DataContext.Conversation.CancelTransferCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="8">
                        <Button Content="Clipboard"
                                Command="{Binding Conversation.SendClipboardCommand}" />
                        <Button Grid.Column="1"
                                Content="Image"
                                Command="{Binding Conversation.SendImageCommand}" />
                        <Button Grid.Column="2"
                                Content="File"
                                Command="{Binding Conversation.SendFileCommand}" />
                    </Grid>

                    <Grid Grid.Row="3"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <TextBox Text="{Binding Conversation.DraftText, Mode=TwoWay}"
                                 PlaceholderText="Type a message" />
                        <Button Grid.Column="1"
                                Content="Send"
                                Command="{Binding Conversation.SendTextCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
