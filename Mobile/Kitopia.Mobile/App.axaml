<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u-semi="clr-namespace:Ursa.Themes.Semi;assembly=Ursa.Themes.Semi"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="Kitopia.Mobile.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Core/UI/DeviceCommunication/DeviceCommunicationIcons.axaml" />
                <ResourceInclude Source="avares://Core/UI/DeviceCommunication/DeviceCommunicationStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <u-semi:UrsaSemiTheme Locale="zh-CN" />
        <semi:SemiTheme Locale="zh-CN" />
        <StyleInclude Source="avares://Core/UI/DeviceCommunication/FontIcon.axaml" />
    </Application.Styles>
</Application>
