<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:lang="clr-namespace:PluginCore.Localization;assembly=PluginCore" xmlns:localization="clr-namespace:PluginCore.Localization;assembly=PluginCore" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:screenCaptureInfoSelfConnector="clr-namespace:KitopiaEx.INodeInputConnector.ScreenCaptureInfoSelfConnector" xmlns:pluginCore="clr-namespace:PluginCore;assembly=PluginCore" xmlns:customScenario="clr-namespace:PluginCore.CustomScenario;assembly=PluginCore">
    <DataTemplate x:Key="Template">
        <Button x:DataType="screenCaptureInfoSelfConnector:ScreenCaptureInfoSelfConnector" Height="60" Width="200" Command="{Binding GetScreenCaptureInfoCommand }">
            <Button.Resources>
                <customScenario:ToolTipConverter x:Key="ToolTipConverter" />
            </Button.Resources>
            <TextBlock x:DataType="screenCaptureInfoSelfConnector:ScreenCaptureInfoSelfConnector" Foreground="{DynamicResource SemiColorText0}"><TextBlock.Text><MultiBinding Converter="{StaticResource ToolTipConverter}" ConverterParameter="lang.kitopiaex.capture_region_not_set"><Binding Path="Value.Value.Value" /><ReflectionBinding Source="{x:Static localization:Lang.BindingSource}" Path="Keys" /></MultiBinding></TextBlock.Text></TextBlock>
        </Button>
    </DataTemplate>
</ResourceDictionary>