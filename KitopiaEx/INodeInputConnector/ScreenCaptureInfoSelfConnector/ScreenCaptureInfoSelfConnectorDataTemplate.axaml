<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:screenCaptureInfoSelfConnector="clr-namespace:KitopiaEx.INodeInputConnector.ScreenCaptureInfoSelfConnector"
                    xmlns:pluginCore="clr-namespace:PluginCore;assembly=PluginCore"
                    xmlns:customScenario="clr-namespace:PluginCore.CustomScenario;assembly=PluginCore">
    <DataTemplate x:Key="Template">
        <Button x:DataType="screenCaptureInfoSelfConnector:ScreenCaptureInfoSelfConnector" Height="60" Width="200"
                Command="{Binding GetScreenCaptureInfoCommand }">
            <Button.Resources>
                <customScenario:ToolTipConverter x:Key="ToolTipConverter" />
            </Button.Resources>
            <TextBlock x:DataType="screenCaptureInfoSelfConnector:ScreenCaptureInfoSelfConnector"  Foreground="{DynamicResource SemiColorText0}"
                       Text="{Binding Value.Value.Value,Converter={StaticResource ToolTipConverter},ConverterParameter='截图区域未设置' }" />
        </Button>
    </DataTemplate>
</ResourceDictionary>