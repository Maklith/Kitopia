<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"
              xmlns:u="https://irihi.tech/ursa"
              x:Class="Kitopia.Desktop.Windows.HotKeyEditorWindow"
              KeyDown="HotKeyEditorWindow_OnKeyDown"
              Width="720" Height="550" MinWidth="560" MinHeight="500"
              Title="修改快捷键" WindowStartupLocation="CenterOwner"
              Background="{DynamicResource HotKeyCanvasBrush}">
    <u:UrsaWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="HotKeyCanvasBrush" Color="#F5F6F8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HotKeyCanvasBrush" Color="#181818" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </u:UrsaWindow.Resources>
    <u:UrsaWindow.Styles>
        <Style Selector="Border#MouseCaptureArea:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource KitopiaPrimaryBrush}" />
            <Setter Property="BoxShadow" Value="0 0 0 2 #300064FA" />
        </Style>
    </u:UrsaWindow.Styles>
    <Grid Margin="24,12,24,20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="快捷键设置" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Name="Name" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
                <Border Padding="16" CornerRadius="12" Background="{DynamicResource KitopiaCardBackgroundBrush}"
                        BorderBrush="{DynamicResource KitopiaCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <RadioButton Name="KeyBoard" GroupName="InputType" Content="键盘快捷键" Click="KeyBoard_OnClick" />
                            <RadioButton Name="Mouse" GroupName="InputType" Content="鼠标快捷键" Click="Mouse_OnClick" />
                        </StackPanel>
                        <Border Name="MouseCaptureArea" Padding="16" MinHeight="96" CornerRadius="8" Focusable="True"
                                Background="{DynamicResource SemiColorFill0}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                                PointerPressed="InputElement_OnPointerPressed">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Spacing="12" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <controls:HotKeyShowItme Name="Ctrl" IsVisible="False" Content="Ctrl" Height="38" FontSize="15" />
                                    <controls:HotKeyShowItme Name="Win" IsVisible="False" Content="Win" Height="38" FontSize="15" />
                                    <controls:HotKeyShowItme Name="Shift" IsVisible="False" Content="Shift" Height="38" FontSize="15" />
                                    <controls:HotKeyShowItme Name="Alt" IsVisible="False" Content="Alt" Height="38" FontSize="15" />
                                    <controls:HotKeyShowItme Name="KeyName" Height="38" FontSize="15" />
                                </StackPanel>
                                <TextBlock Text="点击此处后按下快捷键；鼠标按键也在此录入" FontSize="12" TextAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText2}" />
                            </StackPanel>
                        </Border>
                        <Grid IsVisible="{Binding #Mouse.IsChecked}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Text="长按时间" VerticalAlignment="Center" FontSize="12" />
                            <Slider Grid.Column="1" Name="Slider" Minimum="100" Maximum="5000" Value="1000"
                                    TickFrequency="100" IsSnapToTickEnabled="True" />
                            <TextBlock Grid.Column="2" Text="{Binding #Slider.Value, StringFormat='{}{0:0} ms'}"
                                       MinWidth="58" VerticalAlignment="Center" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Padding="16" CornerRadius="12" Background="{DynamicResource KitopiaCardBackgroundBrush}"
                        BorderBrush="{DynamicResource KitopiaCardBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="生效范围" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="按当前前台窗口所属进程判断" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Name="ProcessScope" Width="180" SelectionChanged="ProcessScope_OnSelectionChanged">
                                <ComboBoxItem Content="所有进程" />
                                <ComboBoxItem Content="仅指定进程" />
                                <ComboBoxItem Content="排除指定进程" />
                            </ComboBox>
                        </Grid>
                        <StackPanel Name="ProcessListSection" Spacing="6">
                            <TextBox Name="ProcessNames" AcceptsReturn="True" Height="76" TextWrapping="Wrap"
                                     PlaceholderText="例如 explorer.exe、code.exe，每行一个或用逗号分隔" />
                            <TextBlock Text="不区分大小写，可省略 .exe；范围外保留按键原本的行为。" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Name="IgnoreTextInput" Content="在文本输入框中暂停此快捷键" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Name="ValidationMessage" VerticalAlignment="Center" Foreground="{DynamicResource KitopiaBadgeDangerForeground}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="取消" Click="ButtonCancle_OnClick" IsCancel="True" Height="34" CornerRadius="6" Padding="20,0" />
            <Button Grid.Column="2" Name="SaveButton" Content="保存" Click="ButtonBase_OnClick"
                    Classes="Primary" Theme="{DynamicResource SolidButton}" Height="34" CornerRadius="6" Padding="20,0" />
        </Grid>
    </Grid>
</u:UrsaWindow>
