<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

              xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"

              xmlns:u="https://irihi.tech/ursa"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="Kitopia.Desktop.Windows.HotKeyEditorWindow"
              KeyDown="HotKeyEditorWindow_OnKeyDown"
              KeyUp="HotKeyEditorWindow_OnKeyUp"
              PointerPressed="InputElement_OnPointerPressed"
              TransparencyLevelHint="AcrylicBlur"
              Width="600"
              Height="370"
              Title="HotKeyEditorWindow">

    <u:UrsaWindow.Background>
        <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.65" />

    </u:UrsaWindow.Background>

    <Grid Focusable="False" Margin="10">
        <Border Focusable="False" CornerRadius="12" Padding="20"
                Background="{DynamicResource KitopiaCardBackgroundBrush}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1"
                BoxShadow="{DynamicResource KitopiaCardBoxShadow}">

            <Grid Focusable="False" RowDefinitions="*,Auto">
                <Grid
                    Grid.Row="0"

                    ColumnDefinitions="*,*"
                    Focusable="False">
                    <StackPanel Orientation="Vertical">
                        <TextBlock
                            TextWrapping="WrapWithOverflow"
                            Text="修改快捷键"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SemiColorText0}" />
                        <TextBlock
                            x:Name="Name"
                            Margin="0,4,0,0"
                            TextWrapping="WrapWithOverflow"
                            Text="快捷键"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{DynamicResource SemiColorText1}" />
                        <TextBlock
                            Margin="0,4,0,12"
                            TextWrapping="WrapWithOverflow"
                            Text="按下按键以修改"
                            FontSize="12"
                            Foreground="{DynamicResource SemiColorText2}" />
                        <RadioButton GroupName="1" Content="键盘快捷键" Name="KeyBoard" IsChecked="True" Focusable="False"
                                     Click="KeyBoard_OnClick" Margin="0,2" />
                        <RadioButton GroupName="1" Content="鼠标快捷键" Name="Mouse" Click="Mouse_OnClick" Focusable="False" Margin="0,2" />
                        <StackPanel IsVisible="{Binding #Mouse.IsChecked}" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock
                                Margin="0,0,0,4"
                                TextWrapping="WrapWithOverflow"
                                Text="鼠标快捷键触发时间间隔(ms)"
                                FontSize="12"
                                Foreground="{DynamicResource SemiColorText2}" />
                            <Slider Maximum="5000" Minimum="100" IsSnapToTickEnabled="True" TickFrequency="100"
                                    HorizontalAlignment="Stretch" Name="Slider" Width="200">
                                <Slider.Styles>
                                    <Style Selector="Slider /template/ Thumb">
                                        <Setter Property="ToolTip.Tip"
                                                Value="{Binding $parent[Slider].Value, Mode=OneWay, StringFormat='\{0:d\}'}" />
                                        <Setter Property="IsVisible" Value="True" />
                                        <Setter Property="ToolTip.Placement" Value="Top" />
                                        <Setter Property="ToolTip.ShowDelay" Value="0" />
                                        <Setter Property="ToolTip.VerticalOffset" Value="-10" />
                                        <Setter Property="ToolTip.HorizontalOffset" Value="-15" />
                                    </Style>
                                </Slider.Styles>
                            </Slider>
                            <TextBlock HorizontalAlignment="Center" Text="{Binding #Slider.Value}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText1}" />
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center">


                        <controls:HotKeyShowItme x:Name="Ctrl" IsVisible="False"
                                                 FontSize="20" Content="Ctrl" Margin="0" Height="64" />
                        <controls:HotKeyShowItme x:Name="Win" Height="64"
                                                 IsVisible="False"
                                                 Margin="5,0,0,0">
                            <controls:HotKeyShowItme.Icon>
                                <Image Source="{StaticResource WinImageIcon}" Width="26"
                                       Height="26" />
                            </controls:HotKeyShowItme.Icon>
                        </controls:HotKeyShowItme>
                        <controls:HotKeyShowItme x:Name="Shift" FontSize="20"
                                                 IsVisible="False"
                                                 Content="Shift" Margin="5,0,0,0" Height="64" />
                        <controls:HotKeyShowItme x:Name="Alt" FontSize="20" Content="Alt"
                                                 Margin="5,0,0,0" IsVisible="False"
                                                 Height="64" />
                        <controls:HotKeyShowItme x:Name="KeyName" FontSize="20"
                                                 Margin="5,0,20,0" Height="64" />


                    </StackPanel>


                </Grid>
                <Border
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"

                    Focusable="False">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpan="8">
                            <Button
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Classes="Primary" Theme="{DynamicResource SolidButton}"
                                Height="32" CornerRadius="6" FontSize="13"
                                Content="确认"
                                Click="ButtonBase_OnClick" />

                            <Button
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Height="32" CornerRadius="6" FontSize="13"
                                Content="取消"
                                Click="ButtonCancle_OnClick"
                                IsCancel="True" />

                        </Grid>
                    </StackPanel>

                </Border>
            </Grid>
        </Border>
    </Grid>

</u:UrsaWindow>