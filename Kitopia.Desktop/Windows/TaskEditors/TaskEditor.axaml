<u:UrsaWindow xmlns="https://github.com/avaloniaui" xmlns:lang="clr-namespace:Kitopia.Feature.Avalonia.Localization;assembly=Kitopia.Feature.Avalonia" xmlns:localization="clr-namespace:Kitopia.Feature.Localization;assembly=Kitopia.Feature" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls1="clr-namespace:Kitopia.Desktop.Controls" xmlns:taskEditor1="clr-namespace:Kitopia.Desktop.Features.CustomScenario.ViewModels.TaskEditor;assembly=Kitopia.Desktop.Features" xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Runtime" xmlns:controls2="clr-namespace:NodifyM.Avalonia.Controls;assembly=NodifyM.Avalonia" xmlns:u="https://irihi.tech/ursa" xmlns:settingsExpander="clr-namespace:Kitopia.Desktop.Controls.SettingsExpander" xmlns:customScenario1="clr-namespace:Kitopia.Desktop.Features.CustomScenario;assembly=Kitopia.Desktop.Features" xmlns:taskEditor="clr-namespace:Kitopia.Desktop.Converter.TaskEditor" xmlns:converter="clr-namespace:Kitopia.Desktop.Converter" xmlns:taskEditors="clr-namespace:Kitopia.Desktop.Windows.TaskEditors" xmlns:kitopiaAvalonia="clr-namespace:Kitopia.Desktop" xmlns:customScenario="clr-namespace:PluginCore.CustomScenario;assembly=PluginCore" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" x:Class="Kitopia.Desktop.Windows.TaskEditors.TaskEditor" Title="{DynamicResource 'lang.kitopia.scenario_editor'}" WindowStartupLocation="CenterScreen" Classes="acrylic" Name="TaskEditorWindow" WindowState="Maximized" x:DataType="taskEditor1:TaskEditorViewModel" Height="720" Width="1280">
    <u:UrsaWindow.Resources>
        <converter:IfNullVisibilityHidden x:Key="IfNullVisibilityHidden" />


        <taskEditor:ScenarioMethodCategoryGroupCtr x:Key="ScenarioMethodCategoryGroupCtr" />
    </u:UrsaWindow.Resources>
    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Closing">
            <InvokeCommandAction Command="{Binding ReloadScenarioCommand}" PassEventArgsToCommand="True" />
        </EventTriggerBehavior>
        <EventTriggerBehavior EventName="DataContextChanged">
            <InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding #TaskEditorWindow}" />
        </EventTriggerBehavior>
        <EventTriggerBehavior EventName="Loaded">
            <InvokeCommandAction Command="{Binding LoadCommand}" CommandParameter="{Binding #TaskEditorWindow}" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>

    <Grid Margin="0,40,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="11*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <Button Grid.Row="0" Grid.Column="0" IsVisible="False" x:Name="Add" Content="{DynamicResource 'lang.kitopia.add'}" Command="{Binding AddNodesCommand}" />
        <!-- 左边部分 -->
        <Border x:Name="Border" Grid.Column="0" Padding="0,0,0,0" Margin="0">

            <ListBox x:Name="ListBox" Margin="3,0,0,0" ScrollViewer.VerticalSnapPointsAlignment="Center" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalSnapPointsType="MandatorySingle">

                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <ContentPresenter Name="PART_ContentPresenter" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CornerRadius="{TemplateBinding CornerRadius}" />
                            </ControlTemplate>

                        </Setter>
                    </ControlTheme>
                </ListBox.ItemContainerTheme>
                <Expander Header="{DynamicResource 'lang.kitopia.scenario_information'}" IsExpanded="True" HorizontalContentAlignment="Stretch">
                    <Expander.Content>
                        <StackPanel HorizontalAlignment="Stretch">
                            <settingsExpander:SettingsExpander Header="{DynamicResource 'lang.kitopia.scenario_name'}">
                                <settingsExpander:SettingsExpander.Footer>
                                    <TextBox MinWidth="80" Text="{Binding Scenario.Name}" />
                                </settingsExpander:SettingsExpander.Footer>
                                <settingsExpander:SettingsExpander.IconSource>
                                    <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                </settingsExpander:SettingsExpander.IconSource>
                            </settingsExpander:SettingsExpander>
                            <settingsExpander:SettingsExpander Margin="0" Header="{DynamicResource 'lang.kitopia.description'}">
                                <settingsExpander:SettingsExpander.Footer>
                                    <TextBox TextWrapping="Wrap" MinWidth="80" Text="{Binding Scenario.Description}" />
                                </settingsExpander:SettingsExpander.Footer>
                                <settingsExpander:SettingsExpander.IconSource>
                                    <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                </settingsExpander:SettingsExpander.IconSource>
                            </settingsExpander:SettingsExpander>
                            <settingsExpander:SettingsExpander Margin="0" Header="{DynamicResource 'lang.kitopia.scenario_icon'}">
                                <settingsExpander:SettingsExpander.Footer>
                                    <Button Command="{Binding ChangeIconCommand}" CommandParameter="{Binding $self}">
                                        <Image HorizontalAlignment="Left" Focusable="False" Width="48" Height="48" ZIndex="1">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource PathToImageConverter}">
                                                    <Binding Path="Scenario.Icon" />
                                                    <Binding Path="Scenario" />
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>

                                    </Button>
                                </settingsExpander:SettingsExpander.Footer>
                                <settingsExpander:SettingsExpander.IconSource>
                                    <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                </settingsExpander:SettingsExpander.IconSource>
                            </settingsExpander:SettingsExpander>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <settingsExpander:SettingsExpander Margin="0" Header="{DynamicResource 'lang.kitopia.has_inputs'}" BorderThickness="0">

                    <settingsExpander:SettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Scenario.IsHaveInputValue,Mode=TwoWay}" />
                    </settingsExpander:SettingsExpander.Footer>


                    <settingsExpander:SettingsExpander.IconSource>
                        <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                    </settingsExpander:SettingsExpander.IconSource>
                    <taskEditors:TaskEditorValueNodeShow Values="{Binding Scenario.InputValue}" ValueType="InputValue"></taskEditors:TaskEditorValueNodeShow>


                </settingsExpander:SettingsExpander>


                <Expander Header="{DynamicResource 'lang.kitopia.tick_controls'}" IsExpanded="True">
                    <Expander.Content>
                        <StackPanel>
                            <settingsExpander:SettingsExpander Margin="0" Header="{DynamicResource 'lang.kitopia.interval_seconds'}">
                                <settingsExpander:SettingsExpander.Footer>
                                    <u:NumericFloatUpDown Minimum="0.1" Value="{Binding Scenario.TickIntervalSecond}" />

                                </settingsExpander:SettingsExpander.Footer>

                                <settingsExpander:SettingsExpander.IconSource>
                                    <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                </settingsExpander:SettingsExpander.IconSource>
                            </settingsExpander:SettingsExpander>
                        </StackPanel>


                    </Expander.Content>
                </Expander>
                <Expander Header="{DynamicResource 'lang.kitopia.variables'}" FontSize="15" IsExpanded="True" FontWeight="Medium">
                    <Expander.Content>
                        <taskEditors:TaskEditorValueNodeShow Values="{Binding Scenario.Values}" ValueType="StoredValue"></taskEditors:TaskEditorValueNodeShow>
                    </Expander.Content>
                </Expander>
                <Expander Header="{DynamicResource 'lang.kitopia.temporary_variables_not_saved'}" FontSize="15" IsExpanded="True" FontWeight="Medium">
                    <Expander.Content>
                        <taskEditors:TaskEditorValueNodeShow Values="{Binding Scenario.TempValue}" ValueType="TempValue">
                        </taskEditors:TaskEditorValueNodeShow>


                    </Expander.Content>
                </Expander>
                <Expander Header="{DynamicResource 'lang.kitopia.trigger'}" IsExpanded="True">
                    <Expander.Content>

                        <StackPanel>

                            <settingsExpander:SettingsExpander Margin="0" Header="{DynamicResource 'lang.kitopia.manual_trigger'}" BorderThickness="0">
                                <settingsExpander:SettingsExpander.Footer>
                                    <ToggleSwitch IsChecked="{Binding Scenario.ExecutionManual,Mode=TwoWay}" />
                                </settingsExpander:SettingsExpander.Footer>


                                <settingsExpander:SettingsExpander.IconSource>
                                    <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                </settingsExpander:SettingsExpander.IconSource>
                                <StackPanel>
                                    <settingsExpander:SettingsExpander Margin="0" Header="{DynamicResource 'lang.kitopia.keyword'}" BorderThickness="0">
                                        <settingsExpander:SettingsExpander.IconSource>
                                            <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                        </settingsExpander:SettingsExpander.IconSource>
                                        <controls1:ListShow AddCommand="{Binding AddKeyCommand}" DelCommand="{Binding DelKeyCommand}" ItemsSource="{Binding Scenario.Keys}" WithAdd="True" />

                                    </settingsExpander:SettingsExpander>


                                </StackPanel>

                            </settingsExpander:SettingsExpander>
                            <settingsExpander:SettingsExpander Margin="0" Header="{DynamicResource 'lang.kitopia.automatic_trigger'}" BorderThickness="0">

                                <settingsExpander:SettingsExpander.IconSource>
                                    <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                </settingsExpander:SettingsExpander.IconSource>

                                <ItemsControl Margin="15,0,0,0" ItemsSource="{Binding Source={x:Static customScenario1:CustomScenarioGlobe.Triggers}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DataTemplate.DataType>
                                                <x:Type TypeName="generic:KeyValuePair" x:TypeArguments="x:String, customScenario:CustomScenarioTriggerInfo" />
                                            </DataTemplate.DataType>
                                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                <StackPanel.Resources>
                                                    <taskEditor:AutoTriggersCtr x:Key="AutoTriggersCtr" />
                                                </StackPanel.Resources>
                                                <CheckBox IsChecked="{Binding Path=$parent[Expander].((taskEditor1:TaskEditorViewModel)DataContext).Scenario,Converter={StaticResource AutoTriggersCtr},                                                               ConverterParameter={Binding .}}" />
                                                <TextBlock VerticalAlignment="Center" Text="{lang:Lang Value={Binding Value.Name}}" />

                                                <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" ToolTip.Tip="{lang:Lang Value={Binding Value.Description}}" ToolTip.ShowDelay="0" IsVisible="{Binding Value.Description, Converter={StaticResource IfNullVisibilityHidden}}" />
                                            </StackPanel>
                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </settingsExpander:SettingsExpander>
                            <settingsExpander:SettingsExpander Margin="0" Header="{DynamicResource 'lang.kitopia.hotkey_trigger'}" BorderThickness="0">
                                <settingsExpander:SettingsExpander.IconSource>
                                    <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                </settingsExpander:SettingsExpander.IconSource>
                                <StackPanel Margin="0" Orientation="Vertical">
                                    <settingsExpander:SettingsExpander Header="{DynamicResource 'lang.kitopia.activation_hotkey'}" Description="{DynamicResource 'lang.kitopia.edit_activation_hotkey'}">
                                        <settingsExpander:SettingsExpander.Footer>
                                            <Panel>
                                                <u:DisableContainer DisabledTip="{DynamicResource 'lang.kitopia.save_the_scenario_before_configuring_this'}" ToolTip.ShowDelay="100">
                                                    <controls1:HotKeyShow InitHotKey="{Binding Scenario.InitHotKeyUiCommandCommand }" HotKeyModel="{Binding Scenario.RunHotKey}" IsEnabled="{Binding IsSaveInLocal}" />
                                                </u:DisableContainer>

                                            </Panel>


                                        </settingsExpander:SettingsExpander.Footer>

                                        <settingsExpander:SettingsExpander.IconSource>
                                            <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                        </settingsExpander:SettingsExpander.IconSource>
                                    </settingsExpander:SettingsExpander>
                                    <settingsExpander:SettingsExpander Header="{DynamicResource 'lang.kitopia.stop_hotkey'}" Description="{DynamicResource 'lang.kitopia.edit_stop_hotkey'}">
                                        <settingsExpander:SettingsExpander.Footer>
                                            <Panel>
                                                <u:DisableContainer DisabledTip="{DynamicResource 'lang.kitopia.save_the_scenario_before_configuring_this'}" ToolTip.ShowDelay="100">
                                                    <controls1:HotKeyShow InitHotKey="{Binding Scenario.InitHotKeyUiCommandCommand }" HotKeyModel="{Binding Scenario.StopHotKey}" IsEnabled="{Binding IsSaveInLocal}" />
                                                </u:DisableContainer>
                                            </Panel>
                                        </settingsExpander:SettingsExpander.Footer>

                                        <settingsExpander:SettingsExpander.IconSource>
                                            <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" />
                                        </settingsExpander:SettingsExpander.IconSource>
                                    </settingsExpander:SettingsExpander>
                                </StackPanel>
                            </settingsExpander:SettingsExpander>
                        </StackPanel>
                    </Expander.Content>
                </Expander>
                <ContentPresenter x:Name="ContentPresenter">
                    <ContentPresenter.Resources>
                        <taskEditors:NodeTemplatesSelector x:Key="ScenarioMethodNode" TemplateType="View" />
                    </ContentPresenter.Resources>
                    <ContentPresenter.Styles>
                        <Style Selector="controls2|Node.View">

                        </Style>
                    </ContentPresenter.Styles>
                    <ContentPresenter.Content>
                        <Binding Path="ScenarioMethodCategoryGroup" Converter="{StaticResource ScenarioMethodCategoryGroupCtr}" ConverterParameter="{StaticResource ScenarioMethodNode}" UpdateSourceTrigger="PropertyChanged" />
                    </ContentPresenter.Content>

                </ContentPresenter>


            </ListBox>


        </Border>
        <!-- 拖动部分 -->
        <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
        <!-- 右边部分 -->
        <Border Grid.Column="2">
            <Grid ShowGridLines="True">
                <Grid ZIndex="-2">
                    <Grid.Background>
                        <SolidColorBrush Color="{DynamicResource NodifyEditor.BackgroundColor}" Opacity="0.5" />
                    </Grid.Background>
                </Grid>
                <controls2:NodifyEditor x:Name="Editor" d:DataContext="{}" DragDrop.AllowDrop="True" PendingConnection="{Binding PendingConnection}" DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}" Connections="{Binding Scenario.Connections}" ItemsSource="{Binding Scenario.Nodes}">

                    <controls2:NodifyEditor.Resources>
                        <kitopiaAvalonia:FlowToDirectionConverter x:Key="FlowToDirectionConverter" />
                    </controls2:NodifyEditor.Resources>
                    <controls2:NodifyEditor.GridLineTemplate>
                        <DataTemplate>
                            <controls2:LargeGridLine Width="{Binding $parent[controls2:NodifyEditor].Bounds.Width}" OffsetX="{Binding $parent[controls2:NodifyEditor].OffsetX}" OffsetY="{Binding $parent[controls2:NodifyEditor].OffsetY}" Zoom="{Binding $parent[controls2:NodifyEditor].Zoom}" Height="{Binding $parent[controls2:NodifyEditor].Bounds.Height}" ZIndex="-2">
                                <controls2:LargeGridLine.Brush>
                                    <SolidColorBrush Color="Gainsboro" Opacity="0.5" />
                                </controls2:LargeGridLine.Brush>
                            </controls2:LargeGridLine>
                        </DataTemplate>
                    </controls2:NodifyEditor.GridLineTemplate>


                    <controls2:NodifyEditor.ConnectionTemplate>
                        <DataTemplate DataType="{x:Type customScenario1:ConnectionItem}">
                            <Grid>
                                <controls2:Connection Source="{Binding Source.Anchor}" Focusable="True" SplitCommand="{Binding SplitConnectionCommand }" Target="{Binding Target.Anchor}">
                                    <controls2:Connection.ContextFlyout>
                                        <MenuFlyout>
                                            <!-- ReSharper disable once Xaml.RedundantResource -->
                                            <MenuItem Header="{DynamicResource 'lang.kitopia.delete_connection'}" Foreground="{DynamicResource SemiColorText0}" Command="{Binding $parent[Window].((taskEditor1:TaskEditorViewModel)DataContext).DelConnectionCommand}" CommandParameter="{Binding }" />
                                        </MenuFlyout>
                                    </controls2:Connection.ContextFlyout>
                                    <controls2:Connection.Stroke>
                                        <SolidColorBrush Color="{DynamicResource SemiBlue5Color}" Opacity="0.5" />
                                    </controls2:Connection.Stroke>
                                </controls2:Connection>
                            </Grid>

                        </DataTemplate>
                    </controls2:NodifyEditor.ConnectionTemplate>

                    <controls2:NodifyEditor.PendingConnectionTemplate>
                        <DataTemplate DataType="{x:Type taskEditor1:PendingConnectionViewModel}">
                            <controls2:PendingConnection StartedCommand="{Binding StartCommand}" CompletedCommand="{Binding FinishCommand}" EnablePreview="True" EnableSnapping="True" Direction="{Binding Source,Converter={StaticResource FlowToDirectionConverter}}" PreviewTarget="{Binding PreviewTarget, Mode=TwoWay}">
                                <controls2:PendingConnection.Stroke>
                                    <SolidColorBrush Color="{DynamicResource SemiBlue5Color}" Opacity="0.5" />
                                </controls2:PendingConnection.Stroke>
                                <controls2:PendingConnection.Background>
                                    <SolidColorBrush Color="{DynamicResource SemiBlue5Color}" Opacity="0.8" />
                                </controls2:PendingConnection.Background>
                                <TextBlock Text="{Binding PreviewText}" />
                            </controls2:PendingConnection>

                        </DataTemplate>
                    </controls2:NodifyEditor.PendingConnectionTemplate>
                    <controls2:NodifyEditor.DataTemplates>
                        <taskEditors:NodeTemplatesSelector />
                    </controls2:NodifyEditor.DataTemplates>
                </controls2:NodifyEditor>

            </Grid>
        </Border>
        <Grid Grid.Column="2" ZIndex="10">
            <Border Padding="6" Margin="0,12,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" BorderThickness="1" CornerRadius="8" Background="{DynamicResource KitopiaCardBackgroundBrush}" BorderBrush="{DynamicResource SemiColorBorder}" BoxShadow="{DynamicResource KitopiaCardBoxShadow}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <StackPanel.Resources>
                        <converter:ReverseBoolToVisibilityConverter x:Key="ReverseBoolToVisibilityConverter" />
                    </StackPanel.Resources>
                    <Button ToolTip.Tip="{DynamicResource 'lang.kitopia.remove_disconnected_nodes'}" ToolTip.ShowDelay="100" FontWeight="Normal" Height="32" Width="32" Padding="0" CornerRadius="6" Theme="{DynamicResource BorderlessButton}" Command="{Binding CleanUnusedNodeCommand}">
                        <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" FontSize="18" />
                    </Button>
                    <ItemsControl IsVisible="{Binding Scenario.IsHaveInputValue,Converter={StaticResource ReverseBoolToVisibilityConverter}}">
                        <Button ToolTip.Tip="{DynamicResource 'lang.kitopia.run_test'}" ToolTip.ShowDelay="100" FontWeight="Normal" Height="32" Width="32" Padding="0" CornerRadius="6" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding Scenario.IsRunning,Converter={StaticResource ReverseBoolToVisibilityConverter}}" Foreground="{DynamicResource SemiColorSuccess}" Command="{Binding VerifyNodeCommand}">
                            <controls1:FontIcon Foreground="{DynamicResource SemiColorSuccess}" FontFamily="{StaticResource FluentFont}" FontSize="18" Glyph="" />
                        </Button>
                        <Button ToolTip.Tip="{DynamicResource 'lang.kitopia.stop_test'}" ToolTip.ShowDelay="100" FontWeight="Normal" Height="32" Width="32" Padding="0" CornerRadius="6" Theme="{DynamicResource BorderlessButton}" IsVisible="{Binding Scenario.IsRunning}" Command="{Binding StopCustomScenarioCommand}">
                            <controls1:FontIcon Foreground="{DynamicResource SemiColorDanger}" FontFamily="{StaticResource FluentFont}" FontSize="18" Glyph="" />
                        </Button>
                    </ItemsControl>

                    <Button ToolTip.Tip="{DynamicResource 'lang.kitopia.save'}" ToolTip.ShowDelay="100" FontWeight="Normal" Height="32" Width="32" Padding="0" CornerRadius="6" Theme="{DynamicResource BorderlessButton}" Command="{Binding SaveCustomScenarioCommand}">
                        <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" FontSize="18" />
                    </Button>
                    <Button ToolTip.Tip="{DynamicResource 'lang.kitopia.exit_and_save'}" ToolTip.ShowDelay="100" FontWeight="Normal" Height="32" Width="32" Padding="0" CornerRadius="6" Theme="{DynamicResource BorderlessButton}" Command="{Binding SaveAndQuitCustomScenarioCommand}" CommandParameter="{Binding $parent[u:UrsaWindow]}">
                        <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="" FontSize="18" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>


</u:UrsaWindow>
