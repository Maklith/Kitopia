<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Kitopia.Feature.Avalonia.Localization;assembly=Kitopia.Feature.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kitopia.Desktop.Features.ViewModel.Windows;assembly=Kitopia.Desktop.Features"
        xmlns:discoveredDevice="clr-namespace:Kitopia.Feature.DeviceCommunication.Discovery;assembly=Kitopia.Feature"
        mc:Ignorable="d"
        d:DesignWidth="920"
        d:DesignHeight="560"
        Width="920"
        Height="560"
        MinWidth="780"
        MinHeight="420"
        x:Class="Kitopia.Desktop.Windows.LanFileShareWindow"
        x:DataType="vm:LanFileShareWindowViewModel"
        Background="{DynamicResource SemiColorBackground0}"
        Title="{DynamicResource 'lang.kitopia.lan_file_sharing'}">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*">
        <Border Grid.ColumnSpan="2" Margin="10" Padding="12" CornerRadius="8"
                Background="{DynamicResource KitopiaCardBackgroundBrush}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource 'lang.kitopia.select_a_device_to_send_the_selected_files'}" FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiColorText0}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource 'lang.kitopia.sending_please_wait'}" Foreground="{DynamicResource KitopiaBadgeWarningForeground}"
                           IsVisible="{Binding IsSending}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="10,0,5,10" Padding="12" CornerRadius="8"
                Background="{DynamicResource KitopiaCardBackgroundBrush}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Content="{DynamicResource 'lang.kitopia.clear'}"
                            Height="28" Padding="12,0" CornerRadius="6" FontSize="12"
                            Command="{Binding ClearFilesCommand}"
                            IsEnabled="{Binding HasFiles}" />
                    <TextBlock Text="{Binding FilesHeader}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding SelectedFiles}" IsVisible="{Binding HasFiles}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShareFileItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SemiColorText0}" />
                                        <TextBlock Text="{Binding FilePath}" FontSize="12"
                                                   Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FileSizeText}" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorText2}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Content="{DynamicResource 'lang.kitopia.remove'}"
                                            Classes="Danger"
                                            Height="26" Padding="8,0" CornerRadius="4" FontSize="11"
                                            Command="{Binding $parent[Window].((vm:LanFileShareWindowViewModel)DataContext).RemoveFileCommand}"
                                            CommandParameter="{Binding FilePath}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{DynamicResource 'lang.kitopia.no_files_to_send'}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText2}"
                               IsVisible="{Binding !HasFiles}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="5,0,10,10" Padding="12" CornerRadius="8"
                Background="{DynamicResource KitopiaCardBackgroundBrush}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="{Binding DevicesHeader}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiColorText0}" />

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding DiscoveredDevices}" IsVisible="{Binding HasDevices}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="discoveredDevice:DiscoveredDevice">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SemiColorText0}" />
                                            <Label Theme="{DynamicResource TagLabel}" Classes="Green"
                                                   IsVisible="{Binding HasIpv6}">IPv6</Label>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ComputerName}" FontSize="12"
                                                   Foreground="{DynamicResource SemiColorText2}" />
                                        <TextBlock Text="{Binding Ipv4Address, StringFormat='IPv4: {0}'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   IsVisible="{Binding HasIpv4}" />
                                        <TextBlock Text="{Binding Ipv6Address, StringFormat='IPv6: {0}'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   IsVisible="{Binding HasIpv6}" />
                                        <TextBlock Text="{lang:Lang &apos;lang.kitopia.port_value&apos;, Value={Binding TcpPort}}"
                                                   FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Content="{DynamicResource 'lang.kitopia.send'}"
                                            Classes="Primary"
                                            Height="28" Padding="14,0" CornerRadius="6" FontSize="12"
                                            IsEnabled="{Binding $parent[Window].((vm:LanFileShareWindowViewModel)DataContext).CanSend}"
                                            Command="{Binding $parent[Window].((vm:LanFileShareWindowViewModel)DataContext).SendToDeviceCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{DynamicResource 'lang.kitopia.no_online_devices_found'}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText2}"
                               IsVisible="{Binding !HasDevices}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
