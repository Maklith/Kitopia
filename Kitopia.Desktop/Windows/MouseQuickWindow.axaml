<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kitopia.Desktop.Features.Search.ViewModels;assembly=Kitopia.Desktop.Features"
        xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"
        x:Class="Kitopia.Desktop.Windows.MouseQuickWindow"
        x:DataType="vm:MouseQuickWindowViewModel"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
        Width="960" Height="680" MinWidth="620" MinHeight="400"
        CanResize="True" TransparencyLevelHint="Transparent" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="True" Topmost="True" ExtendClientAreaToDecorationsHint="True" WindowDecorations="None"
        WindowStartupLocation="Manual" Title="{Binding FileName, StringFormat='{}{0} · 文件速览'}"
        Focusable="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PreviewCanvasBrush" Color="#F5F6F8" />
                    <BoxShadows x:Key="PreviewShadow">0 4 12 0 #1F000000, 0 1 3 0 #0A000000</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PreviewCanvasBrush" Color="#181818" />
                    <BoxShadows x:Key="PreviewShadow">0 4 12 0 #40000000, 0 1 3 0 #20000000</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Theme" Value="{StaticResource BorderlessButton}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KitopiaPrimaryLightBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource KitopiaPrimaryBrush}" />
        </Style>
    </Window.Styles>
    <Border Margin="12" CornerRadius="12" Background="{DynamicResource PreviewCanvasBrush}"
            BorderBrush="{DynamicResource KitopiaCardBorderBrush}" BorderThickness="1"
            BoxShadow="{DynamicResource PreviewShadow}">
        <Grid RowDefinitions="Auto,*,Auto">
            <Grid Margin="16,12" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Background="Transparent"
                      PointerPressed="TitleBar_OnPointerPressed">
                    <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource KitopiaPrimaryLightBrush}">
                        <PathIcon Width="18" Height="20" Foreground="{DynamicResource KitopiaPrimaryBrush}"
                                  Data="M 4,1 L 15,1 21,7 21,23 4,23 Z M 6,3 L 6,21 19,21 19,9 13,9 13,3 Z M 15,4 L 15,7 18,7 Z" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="文件速览" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedPath}" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="打开文件" Command="{Binding OpenFileCommand}" CornerRadius="6" Height="32"
                            FontSize="12" FontWeight="Medium" Theme="{DynamicResource SolidButton}" Classes="Primary" />
                    <Button Classes="tool" Click="FullScreenButton_OnClick" ToolTip.Tip="切换全屏" AutomationProperties.Name="切换全屏">
                        <PathIcon Width="16" Height="16" Data="M 0,6 L 0,0 6,0 6,2 2,2 2,6 Z M 10,0 L 16,0 16,6 14,6 14,2 10,2 Z M 0,10 L 2,10 2,14 6,14 6,16 0,16 Z M 14,10 L 16,10 16,16 10,16 10,14 14,14 Z" />
                    </Button>
                    <Button Classes="tool" Click="CloseButton_OnClick" ToolTip.Tip="关闭 (Esc)" AutomationProperties.Name="关闭速览">
                        <PathIcon Width="12" Height="12" Data="M 1,0 L 6,5 11,0 12,1 7,6 12,11 11,12 6,7 1,12 0,11 5,6 0,1 Z" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="16,0" CornerRadius="12" ClipToBounds="True"
                    Background="{DynamicResource KitopiaCardBackgroundBrush}"
                    BorderBrush="{DynamicResource KitopiaCardBorderBrush}" BorderThickness="1">
                <controls:FilePreviewControl Name="PreviewSurface" />
            </Border>

            <Grid Grid.Row="2" Margin="20,12" ColumnDefinitions="*,Auto,*" ColumnSpacing="16">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding FileDetails}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SemiColorText2}" ToolTip.Tip="{Binding SelectedPath}" />
                    <TextBlock Text="{Binding Notice}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                               IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="tool" Command="{Binding PreviousCommand}" ToolTip.Tip="上一个文件 (←)" AutomationProperties.Name="上一个文件">
                        <PathIcon Width="8" Height="14" Data="M 7,0 L 8,1 2,7 8,13 7,14 0,7 Z" />
                    </Button>
                    <TextBlock Text="{Binding PositionLabel}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <Button Classes="tool" Command="{Binding NextCommand}" ToolTip.Tip="下一个文件 (→)" AutomationProperties.Name="下一个文件">
                        <PathIcon Width="8" Height="14" Data="M 1,0 L 8,7 1,14 0,13 6,7 0,1 Z" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="tool" Command="{Binding RevealFileCommand}" ToolTip.Tip="在文件夹中显示" AutomationProperties.Name="在文件夹中显示">
                        <PathIcon Width="18" Height="16" Data="M 1,3 L 7,3 9,5 23,5 23,20 1,20 Z M 3,7 L 3,18 21,18 21,7 Z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
