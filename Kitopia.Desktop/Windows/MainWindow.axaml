<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
              x:Class="Kitopia.Desktop.Windows.MainWindow"
              Closing="Window_OnClosing"
              TransparencyLevelHint="AcrylicBlur"
              x:DataType="main:MainWindowViewModel"
              xmlns:u="https://irihi.tech/ursa"
              xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"
              xmlns:converter="clr-namespace:Kitopia.Desktop.Converter"
              xmlns:main="clr-namespace:Kitopia.Desktop.Features.ViewModel.Main;assembly=Kitopia.Desktop.Features"
              xmlns:pluginCore="clr-namespace:PluginCore;assembly=PluginCore"
              Icon="/Assets/icon.png"
              WindowState="Minimized"
              IsTitleBarVisible="True"
              MinWidth="480"
              MinHeight="460"
              Title="Kitopia">

    <u:UrsaWindow.Resources>
        <converter:ViewLocator x:Key="ViewLocator" />
    </u:UrsaWindow.Resources>
    <u:UrsaWindow.Background>
        <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.55" />

    </u:UrsaWindow.Background>
    <u:UrsaWindow.TitleBarContent>
        <u:TitleBar>
            
            <u:TitleBar.LeftContent>
                
                <Grid ColumnSpan="2" Name="TitleBarHost" PointerPressed="TitleBarHost_OnPointerPressed"
                      ColumnDefinitions="Auto,Auto,*,Auto"
                      Background="Transparent">
                    <Image Margin="12 4"
                           IsHitTestVisible="False"
                           Source="/Assets/icon.png"
                           Width="18" Height="18"
                           DockPanel.Dock="Left"
                           Name="WindowIcon"
                           RenderOptions.BitmapInterpolationMode="HighQuality">
                        <Image.IsVisible>
                            <OnPlatform Default="False">
                                <On Options="Windows" Content="True" />
                            </OnPlatform>
                        </Image.IsVisible>
                    </Image>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                               FontSize="12"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Grid.Column="1">
                        <TextBlock.IsVisible>
                            <OnPlatform Default="False">
                                <On Options="Windows" Content="True" />
                            </OnPlatform>
                        </TextBlock.IsVisible>
                    </TextBlock>
                </Grid>
            </u:TitleBar.LeftContent>
            <u:TitleBar.CenterContent>
                <Border Grid.Column="2" Padding="6">
                    <AutoCompleteBox Name="SearchBox"
                                     MaxWidth="500"
                                     PlaceholderText="Search">
                        <!--wnd:AppWindow.AllowInteractionInTitleBar="True"-->
                        <AutoCompleteBox.ItemTemplate>

                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                </Border>
            </u:TitleBar.CenterContent>
        </u:TitleBar>
        
    </u:UrsaWindow.TitleBarContent>
    <Panel Margin="0,40,0,0">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*" ColumnSpan="5"
              Margin="{DynamicResource SemiThicknessExtraTight}">
            <!-- 1. Left Sidebar Navigation Pane -->
            <Border Grid.Row="1" Grid.Column="0" VerticalAlignment="Stretch"
                    Background="Transparent"
                    Margin="6,0,6,0">

                <u:NavMenu Name="NavView"
                           IsHorizontalCollapsed="True"
                           CanToggle="False"
                           ExpandWidth="48"
                           CollapseWidth="48"
                           ItemsSource="{Binding MenuItems}"
                           CommandBinding="{Binding ActivateCommand}"
                           HeaderBinding="{Binding}"
                           IconBinding="{Binding}">
                    <u:NavMenu.Styles>
                        <Style Selector="u|NavMenuItem" x:DataType="main:MenuItemViewModel">
                            <Setter Property="IsSeparator" Value="{Binding IsSeparator}" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="Margin" Value="4,2" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                        
                        <!-- PART_Border styling: 6px corner radius -->
                        <Style Selector="u|NavMenuItem /template/ Border#PART_Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>

                        <!-- High specificity overrides for collapsed state: eliminate Ursa's 8px vertical margins/paddings and enforce full 40px height -->
                        <Style Selector="u|NavMenuItem:horizontal-collapsed:first-level /template/ Border#PART_Border">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                        <Style Selector="u|NavMenuItem:horizontal-collapsed:first-level /template/ Grid#PART_RootGrid">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                        <Style Selector="u|NavMenuItem:horizontal-collapsed:first-level /template/ ContentPresenter#PART_IconPresenter">
                            <Setter Property="Grid.ColumnSpan" Value="3" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>

                        <!-- Hover background on PART_Border (works across all Ursa states) -->
                        <Style Selector="u|NavMenuItem /template/ Border#PART_Border:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ListBoxItemPointeroverBackground}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:pointerover /template/ Border#PART_Border">
                            <Setter Property="Background" Value="{DynamicResource ListBoxItemPointeroverBackground}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:horizontal-collapsed:first-level /template/ Border#PART_Border:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ListBoxItemPointeroverBackground}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:horizontal-collapsed:first-level:pointerover /template/ Border#PART_Border">
                            <Setter Property="Background" Value="{DynamicResource ListBoxItemPointeroverBackground}" />
                        </Style>

                        <!-- Selected background on PART_Border -->
                        <Style Selector="u|NavMenuItem:selected /template/ Border#PART_Border">
                            <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedBackground}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:selected /template/ Border#PART_Border:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedPointeroverBackground}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:selected:pointerover /template/ Border#PART_Border">
                            <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedPointeroverBackground}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:selected:horizontal-collapsed:first-level /template/ Border#PART_Border:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedPointeroverBackground}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:selected:horizontal-collapsed:first-level:pointerover /template/ Border#PART_Border">
                            <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedPointeroverBackground}" />
                        </Style>

                        <Style Selector="u|NavMenuItem controls|FontIcon">
                            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:pointerover controls|FontIcon">
                            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:selected controls|FontIcon">
                            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
                        </Style>
                        <Style Selector="u|NavMenuItem:selected:pointerover controls|FontIcon">
                            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimaryHover}" />
                        </Style>
                    </u:NavMenu.Styles>
                    <u:NavMenu.HeaderTemplate>
                        <DataTemplate x:DataType="main:MenuItemViewModel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock HorizontalAlignment="Left" Text="{Binding MenuHeader}" />
                            </StackPanel>
                        </DataTemplate>
                    </u:NavMenu.HeaderTemplate>
                    <u:NavMenu.IconTemplate>
                        <DataTemplate x:DataType="main:MenuItemViewModel">
                            <controls:FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="20"
                                Height="20"
                                FontSize="20"
                                IsFilled="{Binding IsSelected}"
                                GlyphFilled="{Binding MenuIconFilledGlyph}"
                                Glyph="{Binding MenuIconGlyph }" />
                        </DataTemplate>
                    </u:NavMenu.IconTemplate>
                    <u:NavMenu.Footer>
                        <Border Margin="4,4,4,6">
                            <Button HorizontalAlignment="Stretch" Height="40" ToolTip.Tip="设置"
                                    Classes.selected="{Binding SettingPage}"
                                    CornerRadius="6"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding ActivateSettingPageCommand}">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ListBoxItemPointeroverBackground}" />
                                    </Style>
                                    <Style Selector="Button.selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedBackground}" />
                                    </Style>
                                    <Style Selector="Button.selected:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ListBoxItemSelectedPointeroverBackground}" />
                                    </Style>
                                </Button.Styles>
                                <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !SettingPage}"
                                        Foreground="{DynamicResource SemiColorText1}"
                                        Width="20" Height="20" FontSize="20"
                                        Glyph="&#xf6aa;" />
                                    <controls:FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding SettingPage}"
                                        Foreground="{DynamicResource SemiColorPrimary}"
                                        Width="20" Height="20" FontSize="20"
                                        IsFilled="True"
                                        GlyphFilled="&#xf6b3;" />
                                </Panel>
                            </Button>
                        </Border>
                    </u:NavMenu.Footer>

                </u:NavMenu>
            </Border>

            <!-- 2. Right Main Content Area -->
            <Border Grid.Row="1" Grid.Column="1" Padding="2"
                    CornerRadius="{DynamicResource RadiusCardCornerRadius}"
                    Background="{DynamicResource KSemiColorBackground4}">
                <Panel>
                    <ContentPresenter
                        Content="{Binding Content,Converter={StaticResource ViewLocator}}" />
                    <u:OverlayDialogHost HostId="LocalHost" />
                </Panel>
            </Border>

            <TextBlock Margin="0,0,5,3" Grid.Row="1" Grid.Column="1" Foreground="DarkGray" Text="{x:Static pluginCore:ServiceManager.Version}" HorizontalAlignment="Right" VerticalAlignment="Bottom"></TextBlock>
        </Grid>
        
    </Panel>


</u:UrsaWindow>