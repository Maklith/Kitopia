<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:Kitopia.Desktop.Services"
        xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"
        mc:Ignorable="d"
        x:CompileBindings="False"
        d:DesignWidth="380"
        d:DesignHeight="520"
        x:Class="Kitopia.Desktop.Services.ToastShowWindow"
        Width="380"
        Height="520"
        CanResize="False"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Background="Transparent"
        WindowDecorations="None"
        BorderBrush="Transparent"
        BorderThickness="0"
        Focusable="False"
        ShowActivated="False"
        Topmost="True"
        Title="ToastShowWindow">
    <Window.Styles>
        <Style Selector="LayoutTransformControl.toast-card">
            <Style.Animations>
                <Animation Easing="CubicEaseOut" FillMode="Forward" Duration="0:0:0.25">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="60" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="LayoutTransformControl.toast-card.closing">
            <Style.Animations>
                <Animation Easing="CubicEaseIn" FillMode="Forward" Duration="0:0:0.2">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="80" />
                    </KeyFrame>
                </Animation>
                <Animation Easing="QuadraticEaseOut" FillMode="Forward" Duration="0:0:0.15">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Border Background="Transparent" Padding="4" ClipToBounds="False">
        <ScrollViewer x:Name="ToastScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Bottom">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:ToastItemViewModel">
                        <LayoutTransformControl UseRenderTransform="True"
                                                Classes="toast-card"
                                                Classes.closing="{Binding IsClosing}">
                            <controls:ToastCard Margin="10,4,10,8" />
                        </LayoutTransformControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
