<u:UrsaWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:Kitopia.Desktop.Services"
        xmlns:u="https://irihi.tech/ursa"
        mc:Ignorable="d"
        x:DataType="services:SuppressedNotificationCenterViewModel"
        x:Class="Kitopia.Desktop.Services.SuppressedNotificationCenterWindow"
        d:DesignWidth="350"
        d:DesignHeight="433"
        Deactivated="WindowBase_OnDeactivated"
        Width="350"
        Height="433"
        CanResize="False"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        WindowStartupLocation="Manual"
        IsFullScreenButtonVisible="False"
        IsMinimizeButtonVisible="False"
        IsRestoreButtonVisible="False"
        IsCloseButtonVisible="False"
        IsTitleBarVisible="False"
        ShowInTaskbar="False"
        IsManagedResizerVisible="False"
        CanMaximize="False"
        CanMinimize="False"
        Topmost="True"
        Title="NotificationCenter">
    <u:UrsaWindow.Background>
        <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.55" />
    </u:UrsaWindow.Background>
    <Border Padding="12">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="未读通知" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText0}" />
                <Button Grid.Column="1" x:Name="ClearAllButton" Content="清除全部"
                        Command="{Binding ClearAllCommand}"
                        Height="28" Padding="10,0" CornerRadius="6" FontSize="12"
                        Theme="{DynamicResource BorderlessButton}"
                        ToolTip.Tip="清除所有未读通知" />
            </Grid>
            <TextBlock Grid.Row="1" Text="暂无未读通知"
                       IsVisible="{Binding !HasNotifications}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{DynamicResource SemiColorText2}" />
            <ScrollViewer Grid.Row="1" IsVisible="{Binding HasNotifications}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:SuppressedNotificationItemViewModel">
                            <Button Margin="0,0,0,8"
                                    Command="{Binding OpenCommand}"
                                    HorizontalContentAlignment="Stretch"
                                     HorizontalAlignment="Stretch"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0">
                                 <Border Margin="0,3,0,5"
                                         Background="{DynamicResource KitopiaCardBackgroundBrush}"
                                         BorderBrush="{DynamicResource SemiColorBorder}"
                                         BorderThickness="1"
                                         CornerRadius="12"
                                         BoxShadow="{DynamicResource KitopiaCardBoxShadow}"
                                         Padding="14,12">
                                     <Grid RowDefinitions="Auto,Auto"
                                           ColumnDefinitions="Auto,*,Auto"
                                           RowSpacing="6"
                                           ColumnSpacing="10">
                                         <PathIcon Grid.Row="0"
                                                   Grid.Column="0"
                                                   Width="18"
                                                   Height="18"
                                                   Margin="0,2,0,0"
                                                   VerticalAlignment="Top"
                                                   Data="{DynamicResource NotificationCardInformationIconPathData}"
                                                   Foreground="{DynamicResource NotificationCardInformationIconForeground}" />

                                         <TextBlock Grid.Row="0"
                                                    Grid.Column="1"
                                                    Text="{Binding Header}"
                                                    Foreground="{DynamicResource SemiColorText0}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap" />

                                         <TextBlock Grid.Row="0"
                                                    Grid.Column="2"
                                                    Text="{Binding CreatedAtText}"
                                                    Foreground="{DynamicResource SemiColorText2}"
                                                    FontSize="11"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" />

                                         <TextBlock Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="2"
                                                    Text="{Binding Text}"
                                                    FontSize="12"
                                                    LineHeight="17"
                                                    Foreground="{DynamicResource SemiColorText1}"
                                                    TextWrapping="Wrap" />
                                     </Grid>
                                 </Border>
                             </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</u:UrsaWindow>
