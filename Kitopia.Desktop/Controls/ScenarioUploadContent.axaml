<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Kitopia.Desktop.Services"
             x:Class="Kitopia.Desktop.Controls.ScenarioUploadContent"
             x:DataType="services:ScenarioUploadService" MinWidth="460" MaxWidth="620">
    <StackPanel Spacing="12" Margin="24">
        <TextBlock Text="情景市场" Theme="{DynamicResource KitopiaPageKickerText}" />
        <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" />
        <StackPanel Spacing="6" IsVisible="{Binding IsInformationEdit}">
            <TextBlock Text="名称" />
            <TextBox Text="{Binding Name}" Watermark="情景名称" MaxLength="128" IsEnabled="{Binding CanEdit}" CornerRadius="6" />
            <TextBlock Text="情景简介" />
            <TextBox Text="{Binding Description}" Watermark="介绍情景的用途和功能" MaxLength="4000"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="180"
                     IsEnabled="{Binding CanEdit}" CornerRadius="6" />
        </StackPanel>
        <StackPanel Spacing="6" IsVisible="{Binding IsRelease}">
            <TextBlock Text="情景" />
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText1}" />
            <TextBlock Text="版本号" />
            <TextBox Text="{Binding Version}" Watermark="如 1.0.0 或 1.1.0-beta.1" MaxLength="32" IsEnabled="{Binding CanEdit}" CornerRadius="6" />
            <TextBlock Text="版本更新内容" />
            <TextBox Text="{Binding Detail}" Watermark="说明本版本主要更新与修复内容" MaxLength="2000"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="180"
                     IsEnabled="{Binding CanEdit}" CornerRadius="6" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="标签" />
            <TextBlock Grid.Column="1" Text="{Binding Tags.Count, StringFormat='已添加 {0} 个'}"
                       FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
        </Grid>
        <Border MinHeight="42" Padding="8,8,8,2" CornerRadius="8"
                Background="{DynamicResource SemiColorFill0}"
                BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Margin="0,0,6,6" Padding="8,3" CornerRadius="6"
                                    Background="{DynamicResource KitopiaBadgeTagBackground}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="#{Binding}" FontSize="12"
                                               Foreground="{DynamicResource KitopiaBadgeTagForeground}" />
                                    <Button Theme="{DynamicResource BorderlessButton}" Width="16" Height="16" Padding="0"
                                            Command="{Binding Path=$parent[UserControl].((services:ScenarioUploadService)DataContext).RemoveTagCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="移除标签">
                                        <TextBlock Text="×" FontSize="13" Foreground="{DynamicResource KitopiaBadgeTagForeground}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="暂无标签，请在下方输入并添加" FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}" IsVisible="{Binding !HasTags}" />
            </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding TagInput}" Watermark="输入标签，按回车添加" MaxLength="20"
                     IsEnabled="{Binding CanEdit}" CornerRadius="6">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddTagCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Content="添加" Command="{Binding AddTagCommand}" IsEnabled="{Binding CanEdit}" CornerRadius="6" />
        </Grid>
        <TextBlock Text="每个标签最多 20 个字母、数字或汉字，最多添加 10 个标签。"
                   FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
        <CheckBox Content="公开" IsChecked="{Binding IsPublic}" IsEnabled="{Binding CanChangeVisibility}" />
        <TextBlock Text="已发布的文件不能覆盖，请使用新的版本号。公开情景的新版本需要审核。"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SemiColorText2}"
                   IsVisible="{Binding IsRelease}" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorDanger}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="重新授权" Command="{Binding AuthorizeCommand}" IsVisible="{Binding NeedsAuthorization}" IsEnabled="{Binding CanEdit}" CornerRadius="6" />
            <Button Content="取消" Command="{Binding CloseCommand}" IsEnabled="{Binding CanEdit}" CornerRadius="6" />
            <Button Content="上传" Command="{Binding UploadCommand}" IsEnabled="{Binding CanEdit}" Classes="Primary" CornerRadius="6" />
        </StackPanel>
    </StackPanel>
</UserControl>
