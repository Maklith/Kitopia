<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d"
             d:DesignWidth="440"
             d:DesignHeight="220"
             MinWidth="420"
             MaxWidth="520"
             x:Class="Kitopia.Desktop.Controls.ToastDialogContent"
             x:DataType="controls:ToastDialogContentViewModel">
    <UserControl.Styles>
        <Style Selector="PathIcon#ToastIcon.information">
            <Setter Property="Foreground" Value="{DynamicResource NotificationCardInformationIconForeground}" />
            <Setter Property="Data" Value="{DynamicResource NotificationCardInformationIconPathData}" />
        </Style>
        <Style Selector="PathIcon#ToastIcon.success">
            <Setter Property="Foreground" Value="{DynamicResource NotificationCardSuccessIconForeground}" />
            <Setter Property="Data" Value="{DynamicResource NotificationCardSuccessIconPathData}" />
        </Style>
        <Style Selector="PathIcon#ToastIcon.warning">
            <Setter Property="Foreground" Value="{DynamicResource NotificationCardWarningIconForeground}" />
            <Setter Property="Data" Value="{DynamicResource NotificationCardWarningIconPathData}" />
        </Style>
        <Style Selector="PathIcon#ToastIcon.error">
            <Setter Property="Foreground" Value="{DynamicResource NotificationCardErrorIconForeground}" />
            <Setter Property="Data" Value="{DynamicResource NotificationCardErrorIconPathData}" />
        </Style>

        <Style Selector="Button.toast-dialog-action">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.toast-dialog-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>
        <Style Selector="Button.toast-dialog-action:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        </Style>

        <Style Selector="Button.toast-dialog-action.primary">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.toast-dialog-action.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryHover}" />
        </Style>
        <Style Selector="Button.toast-dialog-action.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryActive}" />
        </Style>
    </UserControl.Styles>

    <Border Background="Transparent"
            Padding="24,20,24,20">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              HorizontalAlignment="Stretch">

            <!-- Row 0: Header Area (Icon + Title + Close Button) -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  VerticalAlignment="Center">
                <PathIcon x:Name="ToastIcon"
                          Grid.Column="0"
                          IsVisible="{Binding HasIcon}"
                          Classes.information="{Binding IsInformation}"
                          Classes.success="{Binding IsSuccess}"
                          Classes.warning="{Binding IsWarning}"
                          Classes.error="{Binding IsError}"
                          Width="20"
                          Height="20"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          Data="{DynamicResource NotificationCardInformationIconPathData}"
                          Foreground="{DynamicResource NotificationCardInformationIconForeground}" />

                <TextBlock Grid.Column="1"
                           IsVisible="{Binding HasHeader}"
                           Text="{Binding Header}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SemiColorText0}"
                           FontWeight="SemiBold"
                           FontSize="18"
                           LineHeight="24"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <Button Grid.Column="2"
                        IsVisible="{Binding ShowCloseButton}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        CornerRadius="6"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource SemiColorText2}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="CloseButton_OnClick"
                        ToolTip.Tip="关闭">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
                        </Style>
                    </Button.Styles>
                    <controls:FontIcon FontSize="11" Glyph="&#xf36a;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Row 1: Content Text -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Text}"
                       FontSize="14"
                       LineHeight="20"
                       Foreground="{DynamicResource SemiColorText1}"
                       TextWrapping="Wrap"
                       Margin="{Binding ContentMargin}" />

            <!-- Row 2: Progress Bar -->
            <ProgressBar Grid.Row="2"
                         IsVisible="{Binding ShowProgressBar}"
                         Height="4"
                         CornerRadius="2"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Margin="0,16,0,0" />

            <!-- Row 3: Selection Options -->
            <StackPanel Grid.Row="3"
                        Spacing="6"
                        Margin="0,16,0,0"
                        IsVisible="{Binding HasSelectionOptions}">
                <TextBlock Text="版本"
                           FontSize="13"
                           Foreground="{DynamicResource SemiColorText1}" />
                <ComboBox ItemsSource="{Binding SelectionOptions}"
                          Height="32"
                          CornerRadius="6"
                          HorizontalAlignment="Stretch"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
            </StackPanel>

            <!-- Row 4: Action Buttons Footer -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,24,0,0"
                        IsVisible="{Binding HasFooter}">
                <Button Content="{Binding SelectionConfirmText}"
                        Command="{Binding ConfirmSelectionCommand}"
                        IsVisible="{Binding HasSelectionConfirmation}"
                        Classes="toast-dialog-action primary" />
                <ItemsControl ItemsSource="{Binding Actions}"
                              IsVisible="{Binding HasActions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="controls:ToastDialogActionViewModel">
                            <Button Content="{Binding Text}"
                                    Command="{Binding Command}"
                                    Classes="toast-dialog-action"
                                    Classes.primary="{Binding IsPrimary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
