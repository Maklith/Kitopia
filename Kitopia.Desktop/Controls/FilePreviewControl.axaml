<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preview="clr-namespace:Kitopia.Desktop.Features.Search.Preview;assembly=Kitopia.Desktop.Features"
             xmlns:vm="clr-namespace:Kitopia.Desktop.Features.Search.ViewModels;assembly=Kitopia.Desktop.Features"
             x:Class="Kitopia.Desktop.Controls.FilePreviewControl"
             x:DataType="vm:MouseQuickWindowViewModel">
    <Grid RowDefinitions="*,Auto">
        <Grid Name="ImageViewport" ClipToBounds="True"
              IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Image Name="ImagePreview" Source="{Binding PreviewImage}" Stretch="Uniform"
                   Width="{Binding #ImageViewport.Bounds.Width}" Height="{Binding #ImageViewport.Bounds.Height}"
                   RenderOptions.BitmapInterpolationMode="MediumQuality" RenderTransformOrigin="0%,0%" />
        </Grid>
        <ScrollViewer Padding="24" IsVisible="{Binding PreviewText, Converter={x:Static ObjectConverters.IsNotNull}}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontWeight="Normal"
                                 FontFamily="Cascadia Code, Consolas, Microsoft YaHei" FontSize="14" LineHeight="23"
                                 Foreground="{DynamicResource SemiColorText0}" />
        </ScrollViewer>
        <ScrollViewer Padding="20,12" IsVisible="{Binding Entries, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="preview:FilePreviewEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,10">
                            <PathIcon Width="18" Height="18" Foreground="{DynamicResource KitopiaPrimaryBrush}"
                                      IsVisible="{Binding IsDirectory}"
                                      Data="M 1,3 L 7,3 9,5 23,5 23,20 1,20 Z M 3,7 L 3,18 21,18 21,7 Z" />
                            <PathIcon Width="18" Height="18" Foreground="{DynamicResource SemiColorText2}"
                                      IsVisible="{Binding !IsDirectory}"
                                      Data="M 4,1 L 15,1 21,7 21,23 4,23 Z M 6,3 L 6,21 19,21 19,9 13,9 13,3 Z M 15,4 L 15,7 18,7 Z" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       FontSize="13" ToolTip.Tip="{Binding Name}" />
                            <TextBlock Grid.Column="2" Text="{Binding Details}" FontSize="12"
                                       Foreground="{DynamicResource SemiColorText2}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ContentControl Name="NativePreview" />
        <StackPanel IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="440" Margin="24">
            <PathIcon Width="48" Height="48" Foreground="{DynamicResource KitopiaPrimaryBrush}"
                      Data="M 4,1 L 15,1 21,7 21,23 4,23 Z M 6,3 L 6,21 19,21 19,9 13,9 13,3 Z M 15,4 L 15,7 18,7 Z" />
            <TextBlock Text="{Binding FileName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="{Binding Message}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource SemiColorText2}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="160" Height="3" />
            <TextBlock Text="正在读取文件…" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="8,4"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="缩放" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText2}" />
            <Slider Name="ImageZoom" Minimum="1" Maximum="4" Value="1" Width="100" SmallChange="0.25" />
        </StackPanel>
    </Grid>
</UserControl>
