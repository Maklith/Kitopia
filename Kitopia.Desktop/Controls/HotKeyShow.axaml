<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Kitopia.Desktop.Controls"
        xmlns:converter="clr-namespace:Kitopia.Desktop.Converter">
    <Design.PreviewWith><controls:HotKeyShow /></Design.PreviewWith>
    <Style Selector="controls|HotKeyShow">
        <Style.Resources><converter:HotKey_KeyTypeToVisible x:Key="HotKeyKeyTypeToVisible" /></Style.Resources>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <Button Name="Button" Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                            HorizontalAlignment="Left" HorizontalContentAlignment="Left" Cursor="Hand"
                            ToolTip.Tip="修改按键与生效范围" Command="{TemplateBinding EditHotKey}">
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{TemplateBinding IsActivated}">
                                <controls:HotKeyShowItme Content="Ctrl" IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=KeyType, Converter={StaticResource HotKeyKeyTypeToVisible}, ConverterParameter='Ctrl'}" />
                                <controls:HotKeyShowItme Content="Win" IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=KeyType, Converter={StaticResource HotKeyKeyTypeToVisible}, ConverterParameter='Win'}" />
                                <controls:HotKeyShowItme Content="Shift" IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=KeyType, Converter={StaticResource HotKeyKeyTypeToVisible}, ConverterParameter='Shift'}" />
                                <controls:HotKeyShowItme Content="Alt" IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=KeyType, Converter={StaticResource HotKeyKeyTypeToVisible}, ConverterParameter='Alt'}" />
                                <controls:HotKeyShowItme Content="{TemplateBinding KeyName}" IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=KeyType, Converter={StaticResource HotKeyKeyTypeToVisible}, ConverterParameter='KeyName'}" />
                                <TextBlock Text="未设置快捷键" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText2}"
                                           IsVisible="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=KeyType, Converter={StaticResource HotKeyKeyTypeToVisible}, ConverterParameter='None'}" />
                            </StackPanel>
                            <TextBlock Text="{TemplateBinding ScopeDescription}" FontSize="11" MaxWidth="260"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{TemplateBinding ScopeDescription}"
                                       Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Name="EditButton" Height="28" Padding="10,0" CornerRadius="6" Content="修改"
                                ToolTip.Tip="修改按键与生效范围" Command="{TemplateBinding EditHotKey}" />
                        <Button Name="ToggleButton" Height="28" Padding="10,0" CornerRadius="6"
                                ToolTip.Tip="启用或停用此快捷键" Command="{TemplateBinding ToggleHotKey}">
                            <Panel>
                                <TextBlock Text="停用" FontSize="12" IsVisible="{TemplateBinding IsActivated}" />
                                <TextBlock Text="启用" FontSize="12" Foreground="{DynamicResource SemiColorPrimary}"
                                           IsVisible="{TemplateBinding IsActivated, Converter={x:Static BoolConverters.Not}}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
