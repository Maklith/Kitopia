<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Kitopia.Desktop.Controls"

        xmlns:pluginCore="clr-namespace:PluginCore;assembly=PluginCore"
        xmlns:searchWindow="clr-namespace:Kitopia.Desktop.Converter.SearchWindow"
        xmlns:converter="clr-namespace:Kitopia.Desktop.Converter">

    <Design.PreviewWith>
        <controls:SearchItemShow />
    </Design.PreviewWith>
    <Styles.Resources>
        <searchWindow:PathToImageConverter x:Key="PathToImageConverter" />
        <searchWindow:SymbolToVisible x:Key="SymbolToVisible" />
        <converter:ReverseBoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
        <converter:IfNullVisibilityHidden x:Key="IfNullVisibilityHidden" />
        <converter:IntToIconSymbol x:Key="IntToIconSymbol" />
        <converter:ReverseBool x:Key="ReverseBool" />
    </Styles.Resources>
    <Style Selector="controls|SearchItemShow">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type controls:SearchItemShow}">
                <Button Padding="12,10" Margin="0" Command="{TemplateBinding Command}"
                        DataContext="{TemplateBinding SearchViewItem}"
                        Background="{DynamicResource SemiColorFill0}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
                        </Style>
                    </Button.Styles>
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <Grid Grid.Column="0" Margin="0,0,12,0" Width="44" Height="44" VerticalAlignment="Center">
                            <Image HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Width="40"
                                   Height="40" ZIndex="1">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource PathToImageConverter}">
                                        <Binding Path="$parent[Button].((pluginCore:SearchViewItem)DataContext).Icon" />
                                        <Binding Path="$parent[Button].((pluginCore:SearchViewItem)DataContext)" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <controls:FontIcon Height="40" Width="40" FontSize="36"
                                               IsVisible="{Binding SearchViewItem.IconSymbol,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource SymbolToVisible}}"
                                               FontFamily="{StaticResource FluentFont}"
                                               Glyph="{Binding SearchViewItem.IconSymbol,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource IntToIconSymbol},Mode=OneWay}" />

                            <TextBlock
                                IsVisible="{TemplateBinding IsSelected,Converter={StaticResource ReverseBool}}"
                                Foreground="{DynamicResource SemiColorText2}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Text="未设置" FontSize="12" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock VerticalAlignment="Center" Margin="0" Focusable="False"
                                       Text="{Binding Path=SearchViewItem.ItemDisplayName,RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource SemiColorText0}"
                                       Background="{x:Null}"
                                       FontWeight="Medium" FontSize="15"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock VerticalAlignment="Center" Margin="0"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       FontSize="12"
                                       Text="{Binding Path=SearchViewItem.FileType,RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <controls:FontIcon Grid.Column="2" Glyph="&#xf3de;" Name="ControlChevronIcon"
                                           FontSize="13"
                                           Foreground="{DynamicResource SemiColorText2}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </Button>


            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
