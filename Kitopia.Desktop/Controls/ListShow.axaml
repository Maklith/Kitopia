<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Kitopia.Desktop.Controls">
    <Design.PreviewWith>
        <controls:ListShow Width="200" Height="200" WithAdd="True">
            <controls:ListShow.ItemsSource>
                123
            </controls:ListShow.ItemsSource>
        </controls:ListShow>
    </Design.PreviewWith>

    <Style Selector="controls|ListShow">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,Auto,Auto" MinHeight="64">
                    <ListBox Grid.Row="0" Classes="draggableVirtualizing"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemsSource="{TemplateBinding ItemsSource}">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Name="PART_ContentPresenter"
                                                          Width="{Binding $parent.Width, Mode=OneWay}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Background="{TemplateBinding Background}"
                                                          BorderBrush="{TemplateBinding BorderBrush}"
                                                          BorderThickness="{TemplateBinding BorderThickness}"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          CornerRadius="{TemplateBinding CornerRadius}" />
                                    </ControlTemplate>

                                </Setter>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="12,6"
                                        Background="{DynamicResource KitopiaCardBackgroundBrush}"
                                        BorderBrush="{DynamicResource SemiColorBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <DockPanel>
                                        <TextBlock VerticalAlignment="Center" Text="{ReflectionBinding}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SemiColorText0}" />
                                        <Button Name="Button"
                                                ToolTip.Tip="删除"
                                                HorizontalAlignment="Right"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Width="28" Height="28" Padding="0"
                                                CornerRadius="4"
                                                Command="{Binding $parent[controls:ListShow].DelCommand}"
                                                CommandParameter="{ReflectionBinding}">
                                            <Button.Styles>
                                                <Style Selector="Button controls|FontIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
                                                </Style>
                                                <Style Selector="Button:pointerover controls|FontIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeDangerForeground}" />
                                                </Style>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource KitopiaBadgeDangerBackground}" />
                                                </Style>
                                            </Button.Styles>
                                            <controls:FontIcon FontSize="12" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Glyph="&#xf36a;" />
                                        </Button>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,16"
                               IsHitTestVisible="False"
                               IsVisible="{TemplateBinding ShowEmptyHint}"
                               Text="无项目"
                               FontSize="13"
                               Foreground="{DynamicResource SemiColorText2}" />

                    <!-- Input & Add Item Row (Separated Clean Layout) -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0"
                          IsVisible="{TemplateBinding WithAdd}">
                        <TextBox Grid.Column="0" Height="32" CornerRadius="6"
                                 VerticalContentAlignment="Center"
                                 PlaceholderText="输入新项目内容..."
                                 Text="{Binding $parent[controls:ListShow].TextValue, Mode=TwoWay}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter"
                                            Command="{Binding $parent[controls:ListShow].InnerAddCommand}"
                                            CommandParameter="{Binding $parent[controls:ListShow].TextValue}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Classes="Primary"
                                Margin="8,0,0,0"
                                Height="32"
                                Padding="16,0"
                                CornerRadius="6"
                                FontSize="13"
                                Command="{Binding $parent[controls:ListShow].InnerAddCommand}"
                                CommandParameter="{Binding $parent[controls:ListShow].TextValue}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <controls:FontIcon FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Glyph="&#xf107;" />
                                <TextBlock Text="添加" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Pickers Row -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Height="32" Padding="14,0" CornerRadius="6" FontSize="13"
                                IsVisible="{TemplateBinding ShowFolderPicker}"
                                Command="{TemplateBinding PickFoldersCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <controls:FontIcon FontSize="13" VerticalAlignment="Center" Glyph="&#xF419;" />
                                <TextBlock Text="选择目录" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Height="32" Padding="14,0" CornerRadius="6" FontSize="13"
                                IsVisible="{TemplateBinding ShowFilePicker}"
                                Command="{TemplateBinding PickFilesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <controls:FontIcon FontSize="13" VerticalAlignment="Center" Glyph="&#xf3de;" />
                                <TextBlock Text="选择文件" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>

            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
