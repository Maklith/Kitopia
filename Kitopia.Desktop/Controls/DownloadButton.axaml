<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:controls="clr-namespace:Kitopia.Desktop.Controls">
    <Style Selector="controls|DownloadButton">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Panel IsVisible="{Binding !IsDownloading, RelativeSource={RelativeSource TemplatedParent}}">
                        <Button Command="{TemplateBinding DownloadCommand}"
                                CommandParameter="{TemplateBinding DataContext}"
                                IsVisible="{TemplateBinding NeedDownload}"
                                IsEnabled="{TemplateBinding CanDownload}"
                                Classes="Primary"
                                CornerRadius="6"
                                Height="32"
                                Padding="14,0"
                                FontSize="13">
                            <Button.Styles>
                                <Style Selector="Button[IsEnabled=True]">
                                    <Setter Property="Content">下载</Setter>
                                </Style>
                                <Style Selector="Button[IsEnabled=False]">
                                    <Setter Property="Content">无法下载</Setter>
                                </Style>
                            </Button.Styles>
                        </Button>
                        <Button IsVisible="{Binding !NeedDownload, RelativeSource={RelativeSource TemplatedParent}}"
                                IsEnabled="False"
                                CornerRadius="6"
                                Height="32"
                                Padding="14,0"
                                FontSize="13">
                            已下载
                        </Button>
                    </Panel>
                    <StackPanel Orientation="Horizontal" IsVisible="{TemplateBinding IsDownloading}"
                                VerticalAlignment="Center" Margin="8,0" Spacing="8">
                        <ProgressBar IsIndeterminate="{TemplateBinding IsIndeterminate}"
                                     Value="{TemplateBinding Progress}"
                                     Height="6" CornerRadius="3"
                                     Foreground="{DynamicResource KitopiaPrimaryBrush}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SemiColorText1}"
                                   Text="{Binding  Path=Progress,StringFormat='{}{0:f1}%', RelativeSource={RelativeSource TemplatedParent} }" />
                        <Button Command="{TemplateBinding CancelCommand}"
                                CommandParameter="{TemplateBinding DataContext}"
                                Height="26" Padding="8,0" CornerRadius="4"
                                FontSize="12">
                            取消
                        </Button>
                    </StackPanel>

                </Panel>

            </ControlTemplate>
        </Setter>
    </Style>


</Styles>