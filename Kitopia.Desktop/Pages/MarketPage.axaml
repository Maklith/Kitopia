<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:pages="clr-namespace:Kitopia.Desktop.Features.ViewModel.Pages;assembly=Kitopia.Desktop.Features"
             xmlns:plugin="clr-namespace:Kitopia.Desktop.Features.Services.Plugin;assembly=Kitopia.Desktop.Features"
             xmlns:scenario="clr-namespace:Kitopia.Desktop.Features.CustomScenario.Services;assembly=Kitopia.Desktop.Features"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="pages:MarketPageViewModel"
             x:Class="Kitopia.Desktop.Pages.MarketPage">
    <Panel>
        <ContentPresenter ZIndex="1" x:Name="DialogOvercover" />

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="{DynamicResource SemiThicknessExtraLoose}" RowSpacing="16">
            <!-- 1. Header: Community directory + Title + Subtitle + Plugin Count -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="社区目录" Theme="{DynamicResource KitopiaPageKickerText}" />
                    <TextBlock Text="市场" Theme="{DynamicResource KitopiaPageTitleText}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding ItemCountText}"
                           FontSize="13"
                           Foreground="{DynamicResource SemiColorText2}"
                           VerticalAlignment="Bottom" />
            </Grid>

            <TabStrip Grid.Row="1" ItemsSource="{Binding MarketTabs}"
                      SelectedIndex="{Binding SelectedMarketTab, Mode=TwoWay}" />

            <!-- 2. Search & Filter Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource KitopiaCardBackgroundBrush}"
                    BorderBrush="{DynamicResource KitopiaCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    BoxShadow="{DynamicResource KitopiaCardBoxShadow}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBox Grid.Column="0"
                             Text="{Binding Keyword, Mode=TwoWay}"
                             PlaceholderText="搜索名称、标识或简介"
                             Classes="ClearButton"
                             CornerRadius="6"
                             VerticalContentAlignment="Center">
                        <TextBox.InnerLeftContent>
                            <TextBlock Text="⌕" Margin="10,0,0,0"
                                       FontSize="16"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       VerticalAlignment="Center" />
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <ComboBox Grid.Column="1"
                              IsVisible="{Binding IsPluginMarket}"
                              Width="140"
                              CornerRadius="6"
                              ItemsSource="{Binding PlatformOptions}"
                              SelectedItem="{Binding SelectedPlatform, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="pages:PlatformOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 3. Plugin Cards List / Empty State / Loading -->
            <Panel Grid.Row="3" IsVisible="{Binding IsPluginMarket}">
                <!-- Loading State -->
                <ProgressBar IsIndeterminate="True"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsVisible="{Binding IsLoading}" />

                <!-- Empty State -->
                <Border IsVisible="{Binding HasNoPlugins}"
                        Background="{DynamicResource SemiColorBackground0}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="48"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="没有找到匹配的插件"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SemiColorText0}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="尝试更换搜索词或平台筛选。"
                                   FontSize="13"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Cards ScrollViewer -->
                <ScrollViewer IsVisible="{Binding !HasNoPlugins}">
                    <ItemsControl ItemsSource="{Binding Plugins}" Margin="4,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="plugin:PluginInfoUiHelper">
                                <Border Width="390" MinHeight="198"
                                        Theme="{DynamicResource KitopiaPluginCard}" Margin="6">
                                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                                        <!-- 1. Header: Icon/Initial + Name/NameSign + Status Badge + Details Link -->
                                        <Grid Grid.Row="0" ColumnDefinitions="40,*,Auto" VerticalAlignment="Top">
                                            <!-- Plugin Icon / Stamp (Web-aligned 40x40 rounded rectangle) -->
                                            <Border Grid.Column="0" Width="40" Height="40"
                                                    CornerRadius="8" ClipToBounds="True"
                                                    Background="{DynamicResource KitopiaAvatarBackground}"
                                                    VerticalAlignment="Center">
                                                <Panel>
                                                    <TextBlock Text="{Binding PluginInitial}"
                                                               Foreground="{DynamicResource KitopiaAvatarForeground}"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding Icon}"
                                                           Width="40" Height="40"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </Panel>
                                            </Border>

                                            <!-- Name & NameSign -->
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <Button Padding="0" MinHeight="0"
                                                        Theme="{DynamicResource BorderlessButton}"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding Path=$parent[ItemsControl].((pages:MarketPageViewModel)DataContext).ShowPluginDetailCommand}"
                                                        CommandParameter="{Binding }">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource KitopiaPrimaryBrush}" />
                                                        </Style>
                                                    </Button.Styles>
                                                    <TextBlock Text="{Binding PluginBaseInfo.Name}"
                                                               FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{DynamicResource SemiColorText0}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="240" />
                                                </Button>

                                                <TextBlock Text="{Binding PluginBaseInfo.NameSign}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="240" />
                                            </StackPanel>

                                            <!-- Top-Right: Status Badge ("公开") -->
                                            <Border Grid.Column="2"
                                                    CornerRadius="4" Padding="6,2"
                                                    Background="{DynamicResource KitopiaBadgeSuccessBackground}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding PublicationStatusText}"
                                                           FontSize="11" FontWeight="Medium"
                                                           Foreground="{DynamicResource KitopiaBadgeSuccessForeground}" />
                                            </Border>
                                        </Grid>

                                        <!-- 2. Middle: Description & Badges & Rating -->
                                        <StackPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding DescriptionShort}"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SemiColorText1}"
                                                       FontSize="12"
                                                       LineHeight="17" />
                                            <ItemsControl ItemsSource="{Binding Badges}" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="plugin:PluginBadgeItem">
                                                        <Panel Margin="0,0,5,3">
                                                            <!-- Platform Badge (Neutral) -->
                                                            <Border Background="{DynamicResource KitopiaBadgeNeutralBackground}"
                                                                    CornerRadius="4" Padding="6,1.5" Height="19"
                                                                    IsVisible="{Binding !IsTag}">
                                                                <TextBlock Text="{Binding Text}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource KitopiaBadgeNeutralForeground}"
                                                                           VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Category / Tag Badge (Clickable in Market) -->
                                                            <Button Theme="{DynamicResource KitopiaBadgeTagButton}"
                                                                    Command="{Binding Path=$parent[UserControl].((pages:MarketPageViewModel)DataContext).SearchTagCommand}"
                                                                    CommandParameter="{Binding TagName}"
                                                                    ToolTip.Tip="{Binding TagName, StringFormat='在市场中筛选 #{0}'}"
                                                                    IsVisible="{Binding IsTag}">
                                                                <TextBlock Text="{Binding Text}"
                                                                           FontSize="11" FontWeight="Medium"
                                                                           Foreground="{DynamicResource KitopiaBadgeTagForeground}"
                                                                           VerticalAlignment="Center" />
                                                            </Button>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Rating Row -->
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,6,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="★"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SemiColorWarning}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding HasRatings}" />
                                                <TextBlock Text="☆"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SemiColorText3}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasRatings}" />

                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding HasRatings}">
                                                    <TextBlock Text="{Binding RatingScoreText}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SemiColorText0}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding RatingCount, StringFormat='· {0} 条评价'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText2}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="暂无评分"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasRatings}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 3. Divider -->
                                        <Border Grid.Row="2" Height="1"
                                                Background="{DynamicResource SemiColorBorder}"
                                                Margin="0,8,0,8" />

                                        <!-- 4. Footer: Author on left, Version + Downloads + Button on right -->
                                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <!-- Author (Clickable to search author) -->
                                            <Button Grid.Column="0"
                                                    Command="{Binding Path=$parent[ItemsControl].((pages:MarketPageViewModel)DataContext).SearchAuthorCommand}"
                                                    CommandParameter="{Binding }"
                                                    Padding="0" MinHeight="0"
                                                    Theme="{DynamicResource BorderlessButton}"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover TextBlock.AuthorText">
                                                        <Setter Property="Foreground" Value="{DynamicResource KitopiaPrimaryBrush}" />
                                                    </Style>
                                                </Button.Styles>
                                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                    <Border Width="22" Height="22"
                                                            CornerRadius="11" ClipToBounds="True"
                                                            Background="{DynamicResource KitopiaAvatarBackground}">
                                                        <Panel>
                                                            <TextBlock Text="{Binding AuthorInitial}"
                                                                       Foreground="{DynamicResource KitopiaAvatarForeground}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Image Source="{Binding AuthorAvatar}"
                                                                   Width="22" Height="22"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding AuthorAvatar, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Classes="AuthorText"
                                                               Text="{Binding AuthorName}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SemiColorText1}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="130" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Version + Downloads + Action -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding VersionAndDateText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           HorizontalAlignment="Right" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding DownloadCountText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText2}"
                                                               VerticalAlignment="Center" />
                                                    <Button Classes="Primary"
                                                            IsEnabled="{Binding !InLocal}"
                                                            Command="{Binding Path=$parent[ItemsControl].((pages:MarketPageViewModel)DataContext).DownloadPluginCommand}"
                                                            CommandParameter="{Binding OnlinePluginInfo}"
                                                            Padding="8,1" MinHeight="22" Height="22"
                                                            FontSize="11" CornerRadius="6">
                                                        <Button.Styles>
                                                            <Style Selector="Button[IsEnabled=True]">
                                                                <Setter Property="Content" Value="下载" />
                                                            </Style>
                                                            <Style Selector="Button[IsEnabled=False]">
                                                                <Setter Property="Content" Value="已安装" />
                                                            </Style>
                                                        </Button.Styles>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>

            <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="12" IsVisible="{Binding IsScenarioMarket}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="管理我的情景" Command="{Binding ManageScenariosCommand}" CornerRadius="6" />
                    <TextBlock Text="{Binding LoadError}" Foreground="{DynamicResource SemiColorDanger}"
                               TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center" />
                </StackPanel>
                <Panel Grid.Row="1">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="暂无情景" IsVisible="{Binding HasNoScenarios}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer IsVisible="{Binding !IsLoading}">
                        <ItemsControl ItemsSource="{Binding Scenarios}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="scenario:ScenarioMarketItem">
                                    <Border Width="360" MinHeight="208" Theme="{DynamicResource KitopiaPluginCard}" Margin="6">
                                        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Visibility}" FontSize="12"
                                                           Foreground="{DynamicResource KitopiaPrimaryBrush}" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Author}" FontSize="12"
                                                       Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2" Text="{Binding Description}" TextWrapping="Wrap" MaxLines="3"
                                                       FontSize="13" Foreground="{DynamicResource SemiColorText1}" />
                                            <TextBlock Grid.Row="3" Text="{Binding ReviewText}" TextWrapping="Wrap" FontSize="12" />
                                            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                                                <Button Content="详情" CornerRadius="6"
                                                        Command="{Binding $parent[ItemsControl].((pages:MarketPageViewModel)DataContext).ShowScenarioDetailCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="导入" Classes="Primary" CornerRadius="6"
                                                        Command="{Binding $parent[ItemsControl].((pages:MarketPageViewModel)DataContext).ImportScenarioCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </Grid>

            <!-- 4. Web-Styled Pagination Footer -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        Margin="0,8,0,0"
                        IsVisible="{Binding HasMultiplePages}">
                <Button Content="上一页"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanPreviousPage}"
                        Height="32" Padding="14,0"
                        CornerRadius="6" />

                <TextBlock Text="{Binding PageDisplayText}"
                           FontSize="13"
                           Foreground="{DynamicResource SemiColorText1}"
                           VerticalAlignment="Center"
                           Margin="4,0" />

                <Button Content="下一页"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanNextPage}"
                        Height="32" Padding="14,0"
                        CornerRadius="6" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <TextBox Width="76" Height="32"
                             Text="{Binding TargetPageText, Mode=TwoWay}"
                             PlaceholderText="{Binding CurrentPage, StringFormat='第 {0} 页'}"
                             TextAlignment="Center"
                             CornerRadius="6"
                             VerticalContentAlignment="Center">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding JumpToPageCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="跳转"
                            Command="{Binding JumpToPageCommand}"
                            Height="32" Padding="12,0"
                            CornerRadius="6" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Panel>
</UserControl>
