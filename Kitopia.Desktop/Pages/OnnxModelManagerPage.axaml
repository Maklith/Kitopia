<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Kitopia.Feature.Avalonia.Localization;assembly=Kitopia.Feature.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:pages="clr-namespace:Kitopia.Desktop.Features.ViewModel.Pages;assembly=Kitopia.Desktop.Features"
             xmlns:onnx="clr-namespace:PluginCore.Onnx;assembly=PluginCore"
             xmlns:onnxModelManagerPage="clr-namespace:Kitopia.Desktop.Converter.OnnxModelManagerPage"
             xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="pages:OnnxModelManagerPageViewModel"
             x:Class="Kitopia.Desktop.Pages.OnnxModelManagerPage">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OnnxCanvasBrush" Color="#F5F6F8" />
                    <SolidColorBrush x:Key="OnnxCardBorderBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="OnnxControlBorderBrush" Color="#D1D5DB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OnnxCanvasBrush" Color="#181818" />
                    <SolidColorBrush x:Key="OnnxCardBorderBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="OnnxControlBorderBrush" Color="#29FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        <onnxModelManagerPage:OnnxModelInfoWrapperToModelSizeCtr x:Key="OnnxModelInfoWrapperToModelSizeCtr" />
            <ControlTheme x:Key="RuntimeDetailsFlyout" TargetType="FlyoutPresenter"
                          BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                <Setter Property="Background" Value="{DynamicResource KitopiaCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OnnxCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </ControlTheme>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource KitopiaCardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OnnxControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Border.runtimeBadge">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeNeutralBackground}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Border.runtimeBadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeNeutralForeground}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.runtimeBadge.available">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeSuccessBackground}" />
        </Style>
        <Style Selector="Border.runtimeBadge.available TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeSuccessForeground}" />
        </Style>
        <Style Selector="Border.runtimeBadge.unavailable">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeDangerBackground}" />
        </Style>
        <Style Selector="Border.runtimeBadge.unavailable TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeDangerForeground}" />
        </Style>
        <Style Selector="Border.runtimeBadge.checking">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeCurrentBackground}" />
        </Style>
        <Style Selector="Border.runtimeBadge.checking TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeCurrentForeground}" />
        </Style>
    </UserControl.Styles>
    <Panel Background="{DynamicResource OnnxCanvasBrush}">
        <ContentPresenter ZIndex="1" x:Name="DialogOvercover" />
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="Auto,Auto,Auto" Margin="24" RowSpacing="24">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.ai_engine'}" Theme="{DynamicResource KitopiaPageKickerText}" />
                    <TextBlock Text="{DynamicResource 'lang.kitopia.onnx_inference_and_models'}" Theme="{DynamicResource KitopiaPageTitleText}"
                               FontSize="24" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource 'lang.kitopia.onnx.environment'}" Theme="{DynamicResource KitopiaPageKickerText}" />
                        <TextBlock Text="{DynamicResource 'lang.kitopia.inference_backend'}" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="34" Height="34" Padding="6" VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}"
                            ToolTip.Tip="{DynamicResource 'lang.kitopia.onnx.recheck'}"
                            AutomationProperties.Name="{DynamicResource 'lang.kitopia.onnx.recheck'}">
                        <controls:FontIcon Glyph="&#xf13e;" FontSize="18" />
                    </Button>
                </Grid>
                <ItemsControl x:Name="RuntimeCards" ItemsSource="{Binding Runtimes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pages:OnnxRuntimeStatus">
                            <Border Classes="runtimeCard" Theme="{DynamicResource KitopiaCard}" Padding="24"
                                    Width="{Binding $parent[ItemsControl].Bounds.Width}" MaxWidth="272" Height="136"
                                    BorderBrush="{DynamicResource OnnxCardBorderBrush}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                                    <TextBlock Text="{Binding Device}" FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Device}" />
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                                          MinHeight="34" VerticalAlignment="Bottom">
                                        <Border Classes="runtimeBadge" Classes.available="{Binding IsVerified}"
                                                Classes.unavailable="{Binding IsUnavailable}" Classes.checking="{Binding IsChecking}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{lang:Lang Value={Binding StatusKey}}" TextWrapping="Wrap" />
                                        </Border>
                                        <Button Grid.Column="1" Classes="runtimeDetails"
                                                Content="{DynamicResource 'lang.kitopia.view_details'}"
                                                Theme="{DynamicResource BorderlessButton}" Background="Transparent"
                                                BorderThickness="0" Padding="8,4"
                                                IsVisible="{Binding !IsVerified}" IsEnabled="{Binding !IsChecking}">
                                            <Button.Flyout>
                                                <Flyout FlyoutPresenterTheme="{StaticResource RuntimeDetailsFlyout}">
                                                    <ScrollViewer Width="300" MaxHeight="420"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <StackPanel Spacing="12">
                                                            <TextBlock Text="{Binding Device}" FontSize="16" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{lang:Lang Value={Binding RequirementsKey}}" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource SemiColorText2}" FontSize="14" />
                                                            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                                                                <Button Content="{DynamicResource 'lang.kitopia.onnx.official_guide'}" Padding="12,4"
                                                                        Command="{Binding $parent[UserControl].((pages:OnnxModelManagerPageViewModel)DataContext).OpenDocumentationCommand}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="{DynamicResource 'lang.kitopia.onnx.drivers'}" Padding="12,4"
                                                                        IsVisible="{Binding HasDriverUrl}"
                                                                        Command="{Binding $parent[UserControl].((pages:OnnxModelManagerPageViewModel)DataContext).OpenDriversCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </WrapPanel>
                                                            <StackPanel Spacing="8" IsVisible="{Binding HasError}">
                                                                <TextBlock Text="{DynamicResource 'lang.kitopia.onnx.error_details'}" FontWeight="SemiBold" />
                                                                <SelectableTextBlock Text="{lang:Lang Value={Binding Error}}" TextWrapping="Wrap"
                                                                                     Foreground="{DynamicResource KitopiaBadgeDangerForeground}" FontSize="12" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Row="2" Spacing="12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource 'lang.kitopia.onnx.local_models'}" Theme="{DynamicResource KitopiaPageKickerText}" />
                    <TextBlock Text="{DynamicResource 'lang.kitopia.models'}" FontSize="20" FontWeight="SemiBold" />
                </StackPanel>
                <Border Theme="{DynamicResource KitopiaCard}" Padding="0" ClipToBounds="True"
                        BorderBrush="{DynamicResource OnnxCardBorderBrush}">
                    <DataGrid x:Name="ModelsGrid" ItemsSource="{Binding Models}" MinHeight="200" BorderThickness="0"
                              CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource OnnxCardBorderBrush}"
                              HorizontalScrollBarVisibility="Auto" RowHeight="80" ColumnHeaderHeight="40"
                              IsReadOnly="True">
                        <DataGrid.Resources>
                            <onnxModelManagerPage:PluginStrToPluginName x:Key="PluginStrToPluginName" />
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{DynamicResource 'lang.kitopia.model_name'}" Width="*" MinWidth="220"
                                                    SortMemberPath="ModelInfo.Model.Name">
                                <DataTemplate x:DataType="pages:OnnxModelRuntimeSelection">
                                    <TextBlock Text="{lang:Lang Value={Binding ModelInfo.Model.Name}}"
                                               ToolTip.Tip="{lang:Lang Value={Binding ModelInfo.Model.Name}}"
                                               Margin="12,8" VerticalAlignment="Center" FontWeight="Medium"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{DynamicResource 'lang.kitopia.model_description'}" Width="1.6*" MinWidth="240"
                                                    SortMemberPath="ModelInfo.Model.Description">
                                <DataTemplate x:DataType="pages:OnnxModelRuntimeSelection">
                                    <TextBlock Text="{lang:Lang Value={Binding ModelInfo.Model.Description}}"
                                               ToolTip.Tip="{lang:Lang Value={Binding ModelInfo.Model.Description}}"
                                               Margin="12,8" VerticalAlignment="Center" FontSize="13"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" />
                                </DataTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:DataType="pages:OnnxModelRuntimeSelection" Width="128" MinWidth="128"
                                                Binding="{Binding ModelInfo.PluginStr,Converter={StaticResource PluginStrToPluginName},Mode=OneWay}"
                                                Header="{DynamicResource 'lang.kitopia.model_source'}" />
                            <DataGridTemplateColumn Header="{DynamicResource 'lang.kitopia.inference_backend'}" Width="200" MinWidth="200"
                                                    SortMemberPath="CurrentDevice">
                                <DataTemplate x:DataType="pages:OnnxModelRuntimeSelection">
                                    <ComboBox ItemsSource="{Binding Runtimes}"
                                              SelectedItem="{Binding SelectedRuntime, Mode=TwoWay}"
                                              IsEnabled="{Binding !ModelInfo.Model.NeedDownload}"
                                              AutomationProperties.Name="{DynamicResource 'lang.kitopia.inference_backend'}"
                                              Margin="12,0" Height="34" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              CornerRadius="6" Background="{DynamicResource KitopiaCardBackgroundBrush}"
                                              BorderBrush="{DynamicResource OnnxControlBorderBrush}" BorderThickness="1">
                                        <ComboBox.ItemContainerTheme>
                                            <ControlTheme TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"
                                                          x:DataType="pages:OnnxRuntimeStatus">
                                                <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
                                                <Setter Property="ToolTip.Tip" Value="{lang:Lang Value={Binding StatusKey}}" />
                                            </ControlTheme>
                                        </ComboBox.ItemContainerTheme>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="pages:OnnxRuntimeStatus">
                                                <TextBlock Text="{Binding Device}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:DataType="pages:OnnxModelRuntimeSelection" Header="{DynamicResource 'lang.kitopia.model_size'}" Width="110" MinWidth="110"
                                                    CanUserReorder="True" CanUserSort="True"
                                                    CustomSortComparer="{x:Static onnxModelManagerPage:DataGridModelSizeComparer.Default}">
                                <DataTemplate x:DataType="pages:OnnxModelRuntimeSelection">
                                    <Label HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Padding="4"
                                           Content="{Binding ModelInfo, Converter={StaticResource OnnxModelInfoWrapperToModelSizeCtr} }" />
                                </DataTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:DataType="pages:OnnxModelRuntimeSelection" Header="{DynamicResource 'lang.kitopia.download_model'}" Width="160" MinWidth="160">
                                <DataTemplate x:DataType="pages:OnnxModelRuntimeSelection">
                                    <Panel Margin="12,8" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource 'lang.kitopia.bundled'}" IsVisible="{Binding ModelInfo.Model.IsBundled}"
                                                   FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <controls:DownloadButton DataContext="{Binding ModelInfo.Model, DataType={x:Type pages:OnnxModelRuntimeSelection}}"
                                                                 x:DataType="onnx:OnnxModelInfo"
                                                                 IsVisible="{Binding !IsBundled}"
                                                                 NeedDownload="{Binding NeedDownload}"
                                                                 CanDownload="{Binding CanDownload}"
                                                                 IsDownloading="{Binding IsDownloading}"
                                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                                 Progress="{Binding Progress}"
                                                                 DownloadCommand="{Binding DownloadCommand}"
                                                                 CancelCommand="{Binding CancelCommand}" />
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>

        </Grid>
        </ScrollViewer>
    </Panel>

</UserControl>
