<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:Kitopia.Desktop.Features.ViewModel.Pages;assembly=Kitopia.Desktop.Features"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="pages:SettingPageViewModel"
             x:Class="Kitopia.Desktop.Pages.SettingPage">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="{DynamicResource SemiThicknessExtraLoose}" RowSpacing="16">
        <!-- 1. Header: Preferences & Configuration + Title + Subtitle -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
            <StackPanel Grid.Column="0">
                <TextBlock Text="偏好与配置" Theme="{DynamicResource KitopiaPageKickerText}" />
                <TextBlock Name="TextBlock" Text="设置" Theme="{DynamicResource KitopiaPageTitleText}" />
                <TextBlock Text="自定义全局行为、外观界面、快捷键与插件功能设置。"
                           Theme="{DynamicResource KitopiaPageSubtitleText}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Name="SettingsScrollViewer">
            <StackPanel VerticalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Name="StackPanel" />
        </ScrollViewer>
    </Grid>


</UserControl>
