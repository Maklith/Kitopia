<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:plugin="clr-namespace:Kitopia.Desktop.Features.ViewModel.Pages.plugin;assembly=Kitopia.Desktop.Features"
             xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="plugin:PluginSettingViewModel"
             x:Class="Kitopia.Desktop.Pages.PluginSettingSelectPage">
    <UserControl.Resources>

    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*" Margin="{DynamicResource SemiThicknessExtraLoose}" RowSpacing="16">
        <!-- 1. Header: Plugin options + Title + Subtitle -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
            <StackPanel Grid.Column="0">
                <TextBlock Text="插件选项" Theme="{DynamicResource KitopiaPageKickerText}" />
                <TextBlock Text="{Binding PluginName}" Theme="{DynamicResource KitopiaPageTitleText}" />
                <TextBlock Text="选择需要配置的插件模块或扩展设置页面。"
                           Theme="{DynamicResource KitopiaPageSubtitleText}" />
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MaxHeight="460"
                 ItemsSource="{Binding SettingItems}"
                 Background="Transparent">
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,4" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              BorderThickness="0"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              CornerRadius="10" />
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10"
                            Background="{DynamicResource KitopiaCardBackgroundBrush}"
                            BorderBrush="{DynamicResource KitopiaCardBorderBrush}"
                            BorderThickness="1"
                            BoxShadow="{DynamicResource KitopiaCardBoxShadow}"
                            Padding="20,16">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
                            </Transitions>
                        </Border.Transitions>
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="BorderBrush" Value="{DynamicResource KitopiaPrimaryBrush}" />
                                <Setter Property="BoxShadow" Value="{DynamicResource KitopiaCardHoverBoxShadow}" />
                            </Style>
                        </Border.Styles>
                        <Button HorizontalAlignment="Stretch" x:Name="Button"
                                Command="{Binding Path=$parent[ListBox].((plugin:PluginSettingViewModel)DataContext).NavigateCommand}"
                                CommandParameter="{Binding Key}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SemiColorText0}"
                                           VerticalAlignment="Center" />
                                <controls:FontIcon Grid.Column="1" Glyph="&#xf2b2;" FontSize="18"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
