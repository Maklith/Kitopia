<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:customScenario="clr-namespace:Kitopia.Desktop.Features.CustomScenario.ViewModels;assembly=Kitopia.Desktop.Features"
             xmlns:converter="clr-namespace:Kitopia.Desktop.Converter"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="customScenario:CustomScenariosManagerPageViewModel"
             x:Class="Kitopia.Desktop.Pages.CustomScenariosManagerPage">
    <UserControl.Resources>
        <converter:ReverseBoolToVisibilityConverter x:Key="reverseBoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*" Margin="{DynamicResource SemiThicknessExtraLoose}" RowSpacing="16">
        <!-- 1. Header: Automation & Workflows + Title + Subtitle + New Button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
            <StackPanel Grid.Column="0">
                <TextBlock Text="自动化与工作流" Theme="{DynamicResource KitopiaPageKickerText}" />
                <TextBlock Text="自定义情景" Theme="{DynamicResource KitopiaPageTitleText}" />
                <TextBlock Text="编排与执行自动化脚本与连续任务动作。"
                           Theme="{DynamicResource KitopiaPageSubtitleText}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="Primary"
                    Command="{Binding NewCustomScenariosCommand}"
                    Content="新建情景" Height="32" Padding="14,0" CornerRadius="6"
                    VerticalAlignment="Bottom" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding CustomScenarios}" Margin="4,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="320" Height="216"
                                Theme="{DynamicResource KitopiaPluginCard}" Margin="6">
                            <Panel>
                                <Grid RowDefinitions="*,Auto,Auto">
                                    <!-- Top: Icon + Info -->
                                    <Grid Grid.Row="0" ColumnDefinitions="56,*" ColumnSpacing="12">
                                        <Border Grid.Column="0" Width="52" Height="52"
                                                CornerRadius="12" ClipToBounds="True"
                                                Background="{DynamicResource KitopiaAvatarBackground}"
                                                VerticalAlignment="Top">
                                            <Image Width="44" Height="44"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource PathToImageConverter}">
                                                        <Binding Path="Icon" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Path=Name}"
                                                       FontWeight="SemiBold" FontSize="16"
                                                       Foreground="{DynamicResource SemiColorText0}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       Foreground="{DynamicResource SemiColorText1}"
                                                       FontSize="13" LineHeight="18"
                                                       Height="36" />
                                            <TextBlock Text="{Binding LastRun, StringFormat='上次执行: yyyy/MM/dd HH:mm:ss'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Grid.Row="1" Height="1"
                                            Background="{DynamicResource SemiColorBorder}"
                                            Margin="0,10,0,8" />

                                    <!-- Bottom Actions -->
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="编辑"
                                                    Padding="10,2" MinHeight="24" Height="24" FontSize="11" CornerRadius="6"
                                                    Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).ToTaskEditPageCommand}"
                                                    CommandParameter="{Binding }" />
                                            <Button Classes="Danger" Content="停止"
                                                    Padding="10,2" MinHeight="24" Height="24" FontSize="11" CornerRadius="6"
                                                    IsVisible="{Binding IsRunning}"
                                                    Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).StopCustomScenarioCommand}"
                                                    CommandParameter="{Binding }" />
                                            <Button Classes="Primary" Content="运行"
                                                    Padding="10,2" MinHeight="24" Height="24" FontSize="11" CornerRadius="6"
                                                    IsVisible="{Binding IsRunning,Converter={StaticResource reverseBoolToVisibilityConverter}}"
                                                    Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).RunCustomScenarioCommand}"
                                                    CommandParameter="{Binding }" />
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="删除"
                                                Theme="{DynamicResource KitopiaDangerSubtleButton}"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).RemoveCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                    </Grid>
                                </Grid>

                                <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1"
                                       IsVisible="{Binding !HasInit}">
                                    <Panel.Background>
                                        <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.4" />
                                    </Panel.Background>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Name}" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding InitError}" />
                                        <Button Classes="Danger" Content="删除" HorizontalAlignment="Center"
                                                CornerRadius="6"
                                                Command="{Binding Path=$parent[ItemsControl].((customScenario:CustomScenariosManagerPageViewModel)DataContext).RemoveCustomScenarioCommand}"
                                                CommandParameter="{Binding }" />
                                    </StackPanel>
                                </Panel>
                            </Panel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
