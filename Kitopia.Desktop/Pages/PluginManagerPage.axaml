<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:plugin="clr-namespace:Kitopia.Desktop.Features.ViewModel.Pages.plugin;assembly=Kitopia.Desktop.Features"

             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="plugin:PluginManagerPageViewModel"
             x:Class="Kitopia.Desktop.Pages.PluginManagerPage">

    <Panel>
        <ContentPresenter ZIndex="1" x:Name="DialogOvercover" />
        <Grid RowDefinitions="Auto,*" Margin="{DynamicResource SemiThicknessExtraLoose}" RowSpacing="16">
            <TextBlock Classes="H5" Theme="{DynamicResource TitleTextBlock}" Text="插件列表" />
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="300" Height="210"
                                    Theme="{DynamicResource KitopiaCard}" Margin="4">
                                <Panel>
                                    <Grid ColumnDefinitions="68,*"
                                          RowDefinitions="*,36"
                                          IsEnabled="{Binding !PluginLocalInfo.UnloadFailed}">
                                        <Image Grid.Column="0"
                                               Width="56" Height="56"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,4,0,0"
                                               Source="{Binding Icon}" />
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                            <Button Content="{Binding PluginBaseInfo.Name}"
                                                    Padding="0" MinHeight="0"
                                                    Theme="{DynamicResource BorderlessButton}"
                                                    HorizontalAlignment="Left"
                                                    FontWeight="SemiBold" FontSize="16"
                                                    Foreground="{DynamicResource SemiColorText0}"
                                                    Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).ShowPluginDetailCommand}"
                                                    CommandParameter="{Binding }" />
                                            <TextBlock Text="{Binding PluginBaseInfo.Description}"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       Foreground="{DynamicResource SemiColorText1}"
                                                       FontSize="{DynamicResource SemiFontSizeSmall}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding PluginBaseInfo.Version}"
                                                           FontSize="{DynamicResource SemiFontSizeSmall}"
                                                           Foreground="{DynamicResource SemiColorText2}" />
                                                <StackPanel Orientation="Horizontal" Spacing="2"
                                                            IsVisible="{Binding CanUpdate}">
                                                    <TextBlock Text="›"
                                                               Foreground="{DynamicResource SemiOrange4Color}" />
                                                    <Button Content="{Binding CanUpdateVersion}"
                                                            Padding="0" MinHeight="0"
                                                            Theme="{DynamicResource BorderlessButton}"
                                                            Foreground="{DynamicResource SemiOrange4Color}"
                                                            FontSize="{DynamicResource SemiFontSizeSmall}"
                                                            Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).ShowPluginVersionInfoCommand}"
                                                            CommandParameter="{Binding $self}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding AuthorName}"
                                                           FontSize="{DynamicResource SemiFontSizeSmall}"
                                                           Foreground="{DynamicResource SemiColorText2}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Spacing="8"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Classes="Secondary" Content="配置"
                                                    IsVisible="{Binding PluginLocalInfo.IsEnabled}"
                                                    Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).ToPluginSettingPageCommand}"
                                                    CommandParameter="{Binding }" />
                                            <ToggleButton Classes.Success="{Binding !PluginLocalInfo.IsEnabled}"
                                                          Classes.Danger="{Binding PluginLocalInfo.IsEnabled}"
                                                          FontSize="{DynamicResource SemiFontSizeSmall}"
                                                          IsChecked="{Binding PluginLocalInfo.IsEnabled,Mode=OneWay}"
                                                          Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).SwitchCommand}"
                                                          CommandParameter="{Binding}">
                                                <ToggleButton.Styles>
                                                    <Style Selector="ToggleButton[IsChecked=True]">
                                                        <Setter Property="Content" Value="禁用" />
                                                    </Style>
                                                    <Style Selector="ToggleButton[IsChecked=False]">
                                                        <Setter Property="Content" Value="启用" />
                                                    </Style>
                                                    <Style Selector="ToggleButton[IsChecked=False].Danger">
                                                        <Setter Property="Content" Value="卸载中" />
                                                    </Style>
                                                </ToggleButton.Styles>
                                            </ToggleButton>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Spacing="8"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Button Classes="Danger" Content="删除"
                                                    Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding }" />
                                            <Button Classes="Primary" Content="更新"
                                                    IsVisible="{Binding CanUpdate}"
                                                    Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).UpdateCommand}"
                                                    CommandParameter="{Binding }" />
                                        </StackPanel>
                                    </Grid>

                                    <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ZIndex="1"
                                           IsVisible="{Binding PluginLocalInfo.UnloadFailed}">
                                        <Panel.Background>
                                            <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.4" />
                                        </Panel.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="插件动态卸载失败，重启后完成卸载/更新" />
                                            <Button Classes="Primary" Content="重启"
                                                    Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).RestartAppCommand}" />
                                        </StackPanel>
                                    </Panel>
                                    <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ZIndex="1"
                                           IsVisible="{Binding PluginLocalInfo.LoadFailed}">
                                        <Panel.Background>
                                            <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.4" />
                                        </Panel.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="插件加载失败" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PluginLocalInfo.LoadFailedReason}"
                                                       TextWrapping="Wrap" MaxWidth="260"
                                                       FontSize="{DynamicResource SemiFontSizeSmall}" />
                                            <Button Classes="Danger" Content="删除" HorizontalAlignment="Center"
                                                    Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding }" />
                                        </StackPanel>
                                    </Panel>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
