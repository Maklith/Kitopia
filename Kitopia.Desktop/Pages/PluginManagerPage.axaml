<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:plugin="clr-namespace:Kitopia.Desktop.Features.ViewModel.Pages.plugin;assembly=Kitopia.Desktop.Features"
             xmlns:pluginHelper="clr-namespace:Kitopia.Desktop.Features.Services.Plugin;assembly=Kitopia.Desktop.Features"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="plugin:PluginManagerPageViewModel"
             x:Class="Kitopia.Desktop.Pages.PluginManagerPage">

    <Panel>
        <ContentPresenter ZIndex="1" x:Name="DialogOvercover" />
        <Grid RowDefinitions="Auto,*" Margin="{DynamicResource SemiThicknessExtraLoose}" RowSpacing="16">
            <!-- 1. Header: Local extensions + Title + Subtitle + Count -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="本地扩展" Theme="{DynamicResource KitopiaPageKickerText}" />
                    <TextBlock Text="已安装插件" Theme="{DynamicResource KitopiaPageTitleText}" />
                    <TextBlock Text="管理本地已安装的扩展与组件，支持配置、更新与状态切换。"
                               Theme="{DynamicResource KitopiaPageSubtitleText}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding Items.Count, StringFormat='共 {0} 个插件'}"
                           FontSize="13"
                           Foreground="{DynamicResource SemiColorText2}"
                           VerticalAlignment="Bottom" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="pluginHelper:PluginInfoUiHelper">
                            <Border Width="390" MinHeight="214"
                                    Theme="{DynamicResource KitopiaPluginCard}" Margin="6">
                                <Panel>
                                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                                          IsEnabled="{Binding !PluginLocalInfo.UnloadFailed, FallbackValue=True}">
                                        <!-- 1. Header: Icon/Initial + Name/NameSign + Status Tag + Details Link -->
                                        <Grid Grid.Row="0" ColumnDefinitions="40,*,Auto" VerticalAlignment="Top">
                                            <!-- Plugin Icon / Stamp (Web-aligned 40x40 rounded rectangle) -->
                                            <Border Grid.Column="0" Width="40" Height="40"
                                                    CornerRadius="8" ClipToBounds="True"
                                                    Background="{DynamicResource KitopiaAvatarBackground}"
                                                    VerticalAlignment="Center">
                                                <Panel>
                                                    <TextBlock Text="{Binding PluginInitial}"
                                                               Foreground="{DynamicResource KitopiaAvatarForeground}"
                                                               FontWeight="Bold"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding Icon}"
                                                           Width="40" Height="40"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </Panel>
                                            </Border>

                                            <!-- Name & NameSign -->
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <Button Padding="0" MinHeight="0"
                                                        Theme="{DynamicResource BorderlessButton}"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).ShowPluginDetailCommand}"
                                                        CommandParameter="{Binding }">
                                                    <Button.Styles>
                                                        <Style Selector="Button:pointerover TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource KitopiaPrimaryBrush}" />
                                                        </Style>
                                                    </Button.Styles>
                                                    <TextBlock Text="{Binding PluginBaseInfo.Name}"
                                                               FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{DynamicResource SemiColorText0}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="240" />
                                                </Button>

                                                <TextBlock Text="{Binding PluginBaseInfo.NameSign}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="240" />
                                            </StackPanel>

                                            <!-- Top-Right: Status Badge (Enabled / Disabled) -->
                                            <Panel Grid.Column="2" VerticalAlignment="Top">
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{DynamicResource KitopiaBadgeTagBackground}"
                                                        IsVisible="{Binding IsDownloading}">
                                                    <TextBlock Text="{Binding Download.StatusText}" FontSize="11" FontWeight="Medium"
                                                               Foreground="{DynamicResource KitopiaBadgeTagForeground}" />
                                                </Border>
                                                <Panel IsVisible="{Binding !IsDownloading}">
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            Background="{DynamicResource KitopiaBadgeSuccessBackground}"
                                                            IsVisible="{Binding PluginLocalInfo.IsEnabled}">
                                                        <TextBlock Text="已启用" FontSize="11" FontWeight="Medium"
                                                                   Foreground="{DynamicResource KitopiaBadgeSuccessForeground}" />
                                                    </Border>
                                                    <Border CornerRadius="4" Padding="6,2"
                                                            Background="{DynamicResource KitopiaBadgeNeutralBackground}"
                                                            IsVisible="{Binding !PluginLocalInfo.IsEnabled}">
                                                        <TextBlock Text="已禁用" FontSize="11" FontWeight="Medium"
                                                                   Foreground="{DynamicResource KitopiaBadgeNeutralForeground}" />
                                                    </Border>
                                                </Panel>
                                            </Panel>
                                        </Grid>

                                        <!-- 2. Middle: Description & Badges & Rating -->
                                        <StackPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding DescriptionShort}"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SemiColorText1}"
                                                       FontSize="12"
                                                       LineHeight="17" />
                                            <ItemsControl ItemsSource="{Binding Badges}" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="pluginHelper:PluginBadgeItem">
                                                        <Panel Margin="0,0,5,3">
                                                            <!-- Platform Badge (Neutral) -->
                                                            <Border Background="{DynamicResource KitopiaBadgeNeutralBackground}"
                                                                    CornerRadius="4" Padding="6,1.5" Height="19"
                                                                    IsVisible="{Binding !IsTag}">
                                                                <TextBlock Text="{Binding Text}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource KitopiaBadgeNeutralForeground}"
                                                                           VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Category / Tag Badge -->
                                                            <Border Background="{DynamicResource KitopiaBadgeTagBackground}"
                                                                    CornerRadius="4" Padding="6,1.5" Height="19"
                                                                    IsVisible="{Binding IsTag}">
                                                                <TextBlock Text="{Binding Text}"
                                                                           FontSize="11" FontWeight="Medium"
                                                                           Foreground="{DynamicResource KitopiaBadgeTagForeground}"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Rating Row -->
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,6,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="★"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SemiColorWarning}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding HasRatings}" />
                                                <TextBlock Text="☆"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SemiColorText3}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasRatings}" />

                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding HasRatings}">
                                                    <TextBlock Text="{Binding RatingScoreText}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SemiColorText0}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding RatingCount, StringFormat='· {0} 条评价'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText2}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="暂无评分"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasRatings}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 3. Divider -->
                                        <Border Grid.Row="2" Height="1"
                                                Background="{DynamicResource SemiColorBorder}"
                                                Margin="0,8,0,8" />

                                        <!-- 4. Footer: Author on left, Version on right -->
                                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <!-- Author -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                <Border Width="22" Height="22"
                                                        CornerRadius="11" ClipToBounds="True"
                                                        Background="{DynamicResource KitopiaAvatarBackground}">
                                                    <Panel>
                                                        <TextBlock Text="{Binding AuthorInitial}"
                                                                   Foreground="{DynamicResource KitopiaAvatarForeground}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Image Source="{Binding AuthorAvatar}"
                                                               Width="22" Height="22"
                                                               Stretch="UniformToFill"
                                                               IsVisible="{Binding AuthorAvatar, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </Panel>
                                                </Border>
                                                <TextBlock Text="{Binding AuthorName}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SemiColorText1}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="130" />
                                            </StackPanel>

                                            <!-- Version + CanUpdate badge -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" Spacing="2"
                                                            IsVisible="{Binding CanUpdate}"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="›" Foreground="{DynamicResource SemiColorWarning}" FontSize="12" />
                                                    <Button Content="{Binding CanUpdateVersion, StringFormat='v{0}'}"
                                                            Padding="0" MinHeight="0"
                                                            Theme="{DynamicResource BorderlessButton}"
                                                            Foreground="{DynamicResource SemiColorWarning}"
                                                            FontSize="11"
                                                            Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).ShowPluginVersionInfoCommand}"
                                                            CommandParameter="{Binding $self}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 5. Actions row: Config, Update, Toggle on left | Delete on right -->
                                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,8,0,0" VerticalAlignment="Center"
                                              IsVisible="{Binding !IsDownloading}">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="配置"
                                                        Padding="10,2" MinHeight="24" Height="24" FontSize="11" CornerRadius="6"
                                                        IsVisible="{Binding PluginLocalInfo.IsEnabled}"
                                                        Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).ToPluginSettingPageCommand}"
                                                        CommandParameter="{Binding }" />
                                                <Button Classes="Primary" Content="更新"
                                                        Padding="10,2" MinHeight="24" Height="24" FontSize="11" CornerRadius="6"
                                                        IsVisible="{Binding CanUpdate}"
                                                        Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).UpdateCommand}"
                                                        CommandParameter="{Binding }" />
                                                <ToggleButton Classes.Success="{Binding !PluginLocalInfo.IsEnabled}"
                                                              Classes.Danger="{Binding PluginLocalInfo.IsEnabled}"
                                                              Padding="10,2" MinHeight="24" Height="24" FontSize="11" CornerRadius="6"
                                                              IsVisible="{Binding CanSwitch}"
                                                              IsChecked="{Binding PluginLocalInfo.IsEnabled, Mode=OneWay}"
                                                              Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).SwitchCommand}"
                                                              CommandParameter="{Binding}">
                                                    <ToggleButton.Styles>
                                                        <Style Selector="ToggleButton[IsChecked=True]">
                                                            <Setter Property="Content" Value="禁用" />
                                                        </Style>
                                                        <Style Selector="ToggleButton[IsChecked=False]">
                                                            <Setter Property="Content" Value="启用" />
                                                        </Style>
                                                        <Style Selector="ToggleButton[IsChecked=False].Danger">
                                                            <Setter Property="Content" Value="卸载中" />
                                                        </Style>
                                                    </ToggleButton.Styles>
                                                </ToggleButton>
                                            </StackPanel>

                                            <!-- Subtle Danger Button on Right (like Image 1) -->
                                            <Button Grid.Column="1" Content="删除"
                                                    Theme="{DynamicResource KitopiaDangerSubtleButton}"
                                                    IsVisible="{Binding CanRemove}"
                                                    Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding }" />
                                        </Grid>
                                        <StackPanel Grid.Row="5" Spacing="4" Margin="0,8,0,0"
                                                    IsVisible="{Binding IsDownloading}">
                                            <TextBlock Text="{Binding Download.StatusText}" FontSize="12"
                                                       Foreground="{DynamicResource SemiColorText1}" />
                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Theme="{DynamicResource KitopiaPluginDownloadProgress}"
                                                         Value="{Binding Download.Percentage}"
                                                         IsIndeterminate="{Binding Download.IsIndeterminate}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ZIndex="2"
                                            IsVisible="{Binding PluginLocalInfo.UnloadFailed, FallbackValue=False, TargetNullValue=False}"
                                            CornerRadius="12">
                                        <Border.Background>
                                            <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.85" />
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                            <TextBlock Text="插件动态卸载失败，重启后完成卸载/更新" />
                                            <Button Classes="Primary" Content="重启"
                                                    Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).RestartAppCommand}" />
                                        </StackPanel>
                                    </Border>
                                    <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ZIndex="1"
                                            IsVisible="{Binding PluginLocalInfo.LoadFailed, FallbackValue=False, TargetNullValue=False}"
                                            CornerRadius="12">
                                        <Border.Background>
                                            <SolidColorBrush Color="{DynamicResource SemiBackground0Color}" Opacity="0.85" />
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                            <TextBlock Text="插件加载失败" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SemiColorDanger}" />
                                            <TextBlock Text="{Binding PluginLocalInfo.LoadFailedReason}"
                                                       TextWrapping="Wrap" MaxWidth="280"
                                                       FontSize="{DynamicResource SemiFontSizeSmall}" />
                                            <Button Classes="Danger" Content="删除" HorizontalAlignment="Center"
                                                    IsVisible="{Binding CanRemove}"
                                                    Command="{Binding Path=$parent[ItemsControl].((plugin:PluginManagerPageViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding }" />
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
