<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\KitopiaVersion.props" />
    <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <WindowsPackageType>None</WindowsPackageType>
        <EnableMsixTooling>true</EnableMsixTooling>
    </PropertyGroup>
    <PropertyGroup>
       
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))'">
        <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))'">
        <DefineConstants>$(DefineConstants);OSX</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
        <PackageReference Include="MSTest" Version="4.2.3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Kitopia.Desktop.Platform.Windows\Kitopia.Desktop.Platform.Windows.csproj" />
      <ProjectReference Include="..\Kitopia.Desktop.Platform.Linux\Kitopia.Desktop.Platform.Linux.csproj" />
      <ProjectReference Include="..\Kitopia.Desktop.Features\Kitopia.Desktop.Features.csproj" />
      <ProjectReference Include="..\Kitopia.Desktop\Kitopia.Desktop.csproj" />
      <ProjectReference Include="..\Kitopia.Feature\Kitopia.Feature.csproj" />
      <ProjectReference Include="..\Kitopia.Feature.Avalonia\Kitopia.Feature.Avalonia.csproj" />
      <ProjectReference Include="..\Mobile\Kitopia.Mobile\Kitopia.Mobile.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Fixtures/**/*.cs" />
        <ProjectReference Include="Fixtures/PluginLifecycle/PluginLifecycle.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="Fixtures/PluginUnload/PluginUnload.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <Target Name="CopyPluginLifecycleFixture" AfterTargets="Build">
        <ItemGroup>
            <PluginFixtureFiles Include="Fixtures/PluginLifecycle/bin/$(Configuration)/net10.0/*" />
            <PluginFixtureFiles Include="Fixtures/PluginUnload/bin/$(Configuration)/net10.0/PluginUnload.*" />
        </ItemGroup>
        <Copy SourceFiles="@(PluginFixtureFiles)" DestinationFolder="$(OutDir)PluginFixture" SkipUnchangedFiles="true" />
    </Target>
</Project>
