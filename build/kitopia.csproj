<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace></RootNamespace>
        <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
        <FalloutRootDirectory>..</FalloutRootDirectory>
        <FalloutScriptDirectory>..</FalloutScriptDirectory>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Fallout.Common" Version="10.4.0" />
        <PackageReference Include="NuGet.Configuration" Version="7.9.0" />
        <PackageReference Include="NuGet.Frameworks" Version="7.9.0" />
        <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
        <PackageReference Include="SharpCompress" Version="0.49.1" />
    </ItemGroup>

</Project>
