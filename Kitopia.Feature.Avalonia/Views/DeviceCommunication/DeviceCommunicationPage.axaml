<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lang="clr-namespace:Kitopia.Feature.Avalonia.Localization;assembly=Kitopia.Feature.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Kitopia.Feature.Avalonia.DeviceCommunication.Views"
             xmlns:vm="clr-namespace:Kitopia.Feature.Avalonia.DeviceCommunication.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
              x:Class="Kitopia.Feature.Avalonia.DeviceCommunication.Views.DeviceCommunicationPage"
              x:DataType="vm:DeviceCommunicationPageViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Kitopia.Feature.Avalonia/Views/DeviceCommunication/DeviceCommunicationTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource SemiThicknessBase}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ListColumnWidth}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{Binding ChatColumnWidth}" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Theme="{DynamicResource KitopiaCard}" IsVisible="{Binding IsListVisible}">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.device_chat'}" Classes="H5" Theme="{DynamicResource TitleTextBlock}" />
                    <TextBlock Text="{DynamicResource 'lang.kitopia.lan_conversations'}"
                               Foreground="{DynamicResource SemiColorText1}"
                               FontSize="{DynamicResource SemiFontSizeSmall}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceConversationItem">
                            <Border Margin="0,0,0,8" Padding="12"
                                    DragDrop.AllowDrop="True"
                                    DragDrop.DragOver="OnConversationItemFileDragOver"
                                    DragDrop.Drop="OnConversationItemFileDrop"
                                    Theme="{DynamicResource KitopiaCardBorderless}">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{DynamicResource 'lang.kitopia.edit_custom_name'}"
                                                  Command="{Binding $parent[ListBox].((vm:DeviceCommunicationPageViewModel)DataContext).EditCustomNameCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{DynamicResource 'lang.kitopia.clear_custom_name'}"
                                                  Command="{Binding $parent[ListBox].((vm:DeviceCommunicationPageViewModel)DataContext).ClearCustomNameCommand}"
                                                  CommandParameter="{Binding}" />
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Label Theme="{DynamicResource TagLabel}" Classes="Green"
                                               IsVisible="{Binding HasIpv6}"
                                               FontSize="{DynamicResource SemiFontSizeSmall}">IPv6</Label>
                                        <Label Theme="{DynamicResource TagLabel}"
                                               IsVisible="{Binding HasOperatingSystem}"
                                               FontSize="{DynamicResource SemiFontSizeSmall}"
                                               Content="{Binding OperatingSystemTagText}" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource SemiColorDanger}"
                                                Padding="6,2" CornerRadius="10"
                                                IsVisible="{Binding HasUnread}">
                                            <TextBlock Text="{Binding UnreadCountText}"
                                                       Foreground="White"
                                                       FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                        <TextBlock Text="{Binding LastMessagePreview}"
                                                   Foreground="{DynamicResource SemiColorText1}"
                                                   FontSize="{DynamicResource SemiFontSizeSmall}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="220" />
                                        <TextBlock Text="{lang:Lang &apos;lang.kitopia.computer_value&apos;, Value={Binding ComputerName}}"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   FontSize="11" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Ipv4AddressText}"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       FontSize="11"
                                                       IsVisible="{Binding HasIpv4}" />
                                            <TextBlock Text="{Binding Ipv6AddressText}"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       FontSize="11"
                                                       IsVisible="{Binding HasIpv6}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{lang:Lang &apos;lang.kitopia.tcp_port_value&apos;, Value={Binding TcpPort}}"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding LastMessageTimeText}"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               FontSize="11"
                                               VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{DynamicResource 'lang.kitopia.no_online_devices'}"
                           IsVisible="{Binding HasNoConversations}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText1}" />
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      IsVisible="{Binding !IsCompact}"
                      ResizeDirection="Columns"
                      Width="4"
                      Background="{DynamicResource SemiColorBorder}"
                      CornerRadius="2"
                      Margin="0,8" />

        <Border Grid.Column="2"
                Theme="{DynamicResource KitopiaCard}"
                IsVisible="{Binding IsChatVisible}"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="OnFileDragOver"
                DragDrop.DragLeave="OnFileDragLeave"
                DragDrop.Drop="OnFileDrop">
            <Grid RowDefinitions="*,Auto" RowSpacing="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                        <Button MinWidth="0" MinHeight="0" Padding="8,4"
                                Classes="Tertiary"
                                IsVisible="{Binding ShowBackButton}"
                                Command="{Binding BackToListCommand}"
                                VerticalAlignment="Top" Margin="0,0,8,0">
                            <TextBlock Text="‹" FontSize="20" VerticalAlignment="Center" />
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding CurrentConversationTitle}"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentConversationSubtitle}"
                                       Foreground="{DynamicResource SemiColorText1}"
                                       FontSize="{DynamicResource SemiFontSizeSmall}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource SemiColorFill0}"
                            CornerRadius="8" Padding="12">
                        <Grid>
                            <ScrollViewer x:Name="ConversationScrollViewer"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ConversationItemsControl"
                                              ItemsSource="{Binding CurrentMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <controls:ChatMessageTemplateSelector
                                            DefaultMessageTemplate="{StaticResource DefaultChatMessageTemplate}"
                                            FileMessageTemplate="{StaticResource FileChatMessageTemplate}" />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="{DynamicResource 'lang.kitopia.select_an_online_device_to_start_chatting'}"
                                       IsVisible="{Binding ShowConversationPlaceholder}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText1}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource SemiColorFill0}"
                        CornerRadius="8" Padding="10" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding MessageText}"
                                 PlaceholderText="{DynamicResource 'lang.kitopia.type_a_message'}"
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 MinHeight="36"
                                 VerticalAlignment="Stretch"
                                 IsEnabled="{Binding HasConversationSelected}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                                <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteSendCommand}" />
                            </TextBox.KeyBindings>
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource 'lang.kitopia.cut'}" Command="{Binding $parent[TextBox].Cut}" InputGesture="Ctrl+X" />
                                    <MenuItem Header="{DynamicResource 'lang.kitopia.copy'}" Command="{Binding $parent[TextBox].Copy}" InputGesture="Ctrl+C" />
                                    <MenuItem Header="{DynamicResource 'lang.kitopia.paste_and_send'}"
                                              Command="{Binding $parent[UserControl].((vm:DeviceCommunicationPageViewModel)DataContext).PasteSendCommand}"
                                              InputGesture="Ctrl+V" />
                                    <Separator />
                                    <MenuItem Header="{DynamicResource 'lang.kitopia.select_all'}" Command="{Binding $parent[TextBox].SelectAll}" InputGesture="Ctrl+A" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                        <Button Grid.Column="1" MinWidth="36" MinHeight="36"
                                Classes="Tertiary"
                                Command="{Binding SendFileCommand}"
                                IsEnabled="{Binding HasConversationSelected}">
                            <TextBlock Text="＋" FontSize="18" VerticalAlignment="Center" />
                        </Button>
                        <Button Grid.Column="2" MinWidth="36" MinHeight="36"
                                Classes="Primary"
                                Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding HasConversationSelected}">
                            <TextBlock Text="➤" FontSize="16" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="FileDropOverlay"
                Grid.Column="2"
                ZIndex="50"
                IsVisible="False"
                IsHitTestVisible="False"
                CornerRadius="8"
                BorderThickness="2"
                BorderBrush="{DynamicResource SemiColorPrimary}"
                Background="{DynamicResource SemiColorFill0}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                <TextBlock Text="{DynamicResource 'lang.kitopia.send_file'}"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentConversationTitle}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText1}" />
            </StackPanel>
        </Border>

        <Border x:Name="ImagePreviewOverlay"
                Grid.ColumnSpan="3"
                ZIndex="100"
                IsVisible="False"
                Focusable="True"
                Padding="12"
                Background="#F0000000"
                PointerPressed="OnImagePreviewOverlayPointerPressed"
                KeyDown="OnImagePreviewOverlayKeyDown">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock x:Name="ImagePreviewTitle"
                               Text="{DynamicResource 'lang.kitopia.image_preview_100'}"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button MinWidth="36"
                                MinHeight="36"
                                Padding="8"
                                Foreground="White"
                                Background="#33000000"
                                Click="OnImagePreviewZoomOutClicked"
                                ToolTip.Tip="{DynamicResource 'lang.kitopia.zoom_out'}">
                            <TextBlock Text="−" FontSize="18" />
                        </Button>
                        <Button MinHeight="36"
                                Padding="10,8"
                                Foreground="White"
                                Background="#33000000"
                                Click="OnImagePreviewResetZoomClicked"
                                ToolTip.Tip="{DynamicResource 'lang.kitopia.fit_to_window'}">
                            <TextBlock Text="{DynamicResource 'lang.kitopia.fit'}" />
                        </Button>
                        <Button MinWidth="36"
                                MinHeight="36"
                                Padding="8"
                                Foreground="White"
                                Background="#33000000"
                                Click="OnImagePreviewZoomInClicked"
                                ToolTip.Tip="{DynamicResource 'lang.kitopia.zoom_in'}">
                            <TextBlock Text="＋" FontSize="18" />
                        </Button>
                        <Button MinWidth="36"
                                MinHeight="36"
                                Padding="8"
                                Foreground="White"
                                Background="#33000000"
                                Click="OnImagePreviewCloseClicked"
                                ToolTip.Tip="{DynamicResource 'lang.kitopia.close_image_preview'}">
                            <TextBlock Text="✕" FontSize="18" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        ClipToBounds="True"
                        Background="Transparent">
                    <Canvas x:Name="ImagePreviewCanvas"
                            ClipToBounds="True"
                            Background="Transparent"
                            SizeChanged="OnImagePreviewCanvasSizeChanged"
                            PointerWheelChanged="OnImagePreviewPointerWheelChanged">
                        <Image x:Name="ImagePreviewContent"
                               Stretch="Fill"
                               Cursor="Hand"
                               PointerPressed="OnImagePreviewContentPointerPressed"
                               PointerMoved="OnImagePreviewContentPointerMoved"
                               PointerReleased="OnImagePreviewContentPointerReleased"
                               PointerCaptureLost="OnImagePreviewContentPointerCaptureLost" />
                    </Canvas>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
