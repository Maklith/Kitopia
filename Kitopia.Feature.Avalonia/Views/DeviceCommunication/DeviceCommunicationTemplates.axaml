<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Kitopia.Feature.Avalonia.DeviceCommunication.ViewModels">

    <SolidColorBrush x:Key="IncomingBubbleBrush" Color="{DynamicResource SemiBackground2Color}" Opacity="0.9" />
    <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="{DynamicResource SemiBlue5Color}" Opacity="0.86" />

    <DataTemplate x:Key="DefaultChatMessageTemplate" x:DataType="vm:DeviceChatMessageItem">
        <StackPanel Margin="0,0,0,8">
            <Border MaxWidth="420" Padding="10"
                    IsVisible="{Binding IsIncoming}"
                    Background="{StaticResource IncomingBubbleBrush}"
                    CornerRadius="10"
                    HorizontalAlignment="Left">
                <StackPanel Spacing="6">
                    <Image Source="{Binding ImagePreview}"
                           IsVisible="{Binding HasImage}"
                           MaxWidth="320" MaxHeight="320" Stretch="Uniform"
                           Cursor="Hand">
                        <Image.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="{DynamicResource 'lang.kitopia.enlarge'}"
                                          Command="{Binding PreviewImageCommand}"
                                          CommandParameter="{Binding .}" />
                                <MenuItem Header="{DynamicResource 'lang.kitopia.copy_image'}"
                                          Command="{Binding CopyImageCommand}"
                                          CommandParameter="{Binding .}" />
                            </MenuFlyout>
                        </Image.ContextFlyout>
                    </Image>
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                         IsVisible="{Binding HasText}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   IsVisible="{Binding HasState}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border MaxWidth="420" Padding="10"
                    IsVisible="{Binding IsOutgoing}"
                    Background="{StaticResource OutgoingBubbleBrush}"
                    CornerRadius="10"
                    HorizontalAlignment="Right">
                <StackPanel Spacing="6">
                    <Image Source="{Binding ImagePreview}"
                           IsVisible="{Binding HasImage}"
                           MaxWidth="320" MaxHeight="320" Stretch="Uniform"
                           Cursor="Hand">
                        <Image.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="{DynamicResource 'lang.kitopia.enlarge'}"
                                          Command="{Binding PreviewImageCommand}"
                                          CommandParameter="{Binding .}" />
                                <MenuItem Header="{DynamicResource 'lang.kitopia.copy_image'}"
                                          Command="{Binding CopyImageCommand}"
                                          CommandParameter="{Binding .}" />
                            </MenuFlyout>
                        </Image.ContextFlyout>
                    </Image>
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                         IsVisible="{Binding HasText}"
                                         Foreground="White" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="11"
                                   Foreground="White" Opacity="0.85" />
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="White" Opacity="0.85"
                                   IsVisible="{Binding HasState}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="FileChatMessageTemplate" x:DataType="vm:FileChatMessageItem">
        <Grid x:Name="FileMessageRoot" Margin="0,0,0,8">
            <Border Width="320" MaxWidth="{Binding #FileMessageRoot.Bounds.Width}" Padding="12"
                    IsVisible="{Binding IsIncomingFileOffer}"
                    Background="{StaticResource IncomingBubbleBrush}"
                    CornerRadius="8"
                    HorizontalAlignment="Left">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                        <Border Width="48" Height="48" CornerRadius="6"
                                Background="{DynamicResource SemiColorFill0}">
                            <Grid Margin="4">
                                <TextBlock Text="{Binding FileTypeText}"
                                           IsVisible="{Binding !HasFileIcon}"
                                           FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText1}" />
                                <Image Source="{Binding FileIcon}" Width="32" Height="32"
                                       IsVisible="{Binding HasFileIcon}" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                            <TextBlock Text="{Binding FileSizeText}"
                                       Foreground="{DynamicResource SemiColorText1}"
                                       FontSize="{DynamicResource SemiFontSizeSmall}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReceiveProgress}"
                                 Height="4" IsVisible="{Binding IsReceiving}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding StateText}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   IsVisible="{Binding HasState}" />
                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                          IsVisible="{Binding CanHandleIncomingOffer}">
                        <Button Classes="Primary" Content="{DynamicResource 'lang.kitopia.accept'}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding AcceptCommand}" CommandParameter="{Binding .}" />
                        <Button Grid.Column="1" Classes="Secondary" Content="{DynamicResource 'lang.kitopia.reject'}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Command="{Binding RejectCommand}" CommandParameter="{Binding .}" />
                    </Grid>
                </StackPanel>
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem Header="{DynamicResource 'lang.kitopia.open'}"
                                  IsEnabled="{Binding CanUseLocalFile}"
                                  Command="{Binding OpenCommand}"
                                  CommandParameter="{Binding .}" />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.save_as'}"
                                  IsEnabled="{Binding CanUseLocalFile}"
                                  Command="{Binding SaveAsCommand}"
                                  CommandParameter="{Binding .}" />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.copy_file'}"
                                  IsEnabled="{Binding CanUseLocalFile}"
                                  Command="{Binding CopyFileCommand}"
                                  CommandParameter="{Binding .}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.cancel_transfer'}"
                                  IsVisible="{Binding IsTransferActive}"
                                  Command="{Binding CancelCommand}"
                                  CommandParameter="{Binding .}" />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.view_details'}"
                                  Command="{Binding ViewDetailsCommand}"
                                  CommandParameter="{Binding .}" />
                    </MenuFlyout>
                </Border.ContextFlyout>
            </Border>

            <Border Width="320" MaxWidth="{Binding #FileMessageRoot.Bounds.Width}" Padding="12"
                    IsVisible="{Binding IsOutgoing}"
                    Background="{StaticResource OutgoingBubbleBrush}"
                    CornerRadius="8"
                    HorizontalAlignment="Right">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                        <Border Width="48" Height="48" CornerRadius="6" Background="#22FFFFFF">
                            <Grid Margin="4">
                                <TextBlock Text="{Binding FileTypeText}"
                                           IsVisible="{Binding !HasFileIcon}"
                                           FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" />
                                <Image Source="{Binding FileIcon}" Width="32" Height="32"
                                       IsVisible="{Binding HasFileIcon}" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}"
                                       Foreground="White" />
                            <TextBlock Text="{Binding FileSizeText}"
                                       Foreground="White" Opacity="0.85"
                                       FontSize="{DynamicResource SemiFontSizeSmall}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReceiveProgress}"
                                 Height="4" IsVisible="{Binding IsReceiving}" Foreground="White" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding StateText}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="White" Opacity="0.85" IsVisible="{Binding HasState}" />
                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="11"
                                   VerticalAlignment="Bottom"
                                   Foreground="White" Opacity="0.85" />
                    </Grid>
                </StackPanel>
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem Header="{DynamicResource 'lang.kitopia.cancel_transfer'}"
                                  IsVisible="{Binding IsTransferActive}"
                                  Command="{Binding CancelCommand}" CommandParameter="{Binding .}" />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.view_details'}"
                                  Command="{Binding ViewDetailsCommand}" CommandParameter="{Binding .}" />
                    </MenuFlyout>
                </Border.ContextFlyout>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
