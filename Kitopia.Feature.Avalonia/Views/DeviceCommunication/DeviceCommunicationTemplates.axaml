<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Kitopia.Feature.Avalonia.DeviceCommunication.ViewModels">

    <SolidColorBrush x:Key="IncomingBubbleBrush" Color="{DynamicResource SemiBackground2Color}" Opacity="0.9" />
    <SolidColorBrush x:Key="OutgoingBubbleBrush" Color="{DynamicResource SemiBlue5Color}" Opacity="0.86" />

    <DataTemplate x:Key="DefaultChatMessageTemplate" x:DataType="vm:DeviceChatMessageItem">
        <StackPanel Margin="0,0,0,8">
            <Border MaxWidth="420" Padding="10"
                    IsVisible="{Binding IsIncoming}"
                    Background="{StaticResource IncomingBubbleBrush}"
                    CornerRadius="10"
                    HorizontalAlignment="Left">
                <StackPanel Spacing="6">
                    <Image Source="{Binding ImagePreview}"
                           IsVisible="{Binding HasImage}"
                           MaxWidth="320" Stretch="Uniform"
                           Cursor="Hand">
                        <Image.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="{DynamicResource 'lang.kitopia.enlarge'}"
                                          Command="{Binding PreviewImageCommand}"
                                          CommandParameter="{Binding .}" />
                                <MenuItem Header="{DynamicResource 'lang.kitopia.copy_image'}"
                                          Command="{Binding CopyImageCommand}"
                                          CommandParameter="{Binding .}" />
                            </MenuFlyout>
                        </Image.ContextFlyout>
                    </Image>
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                         IsVisible="{Binding HasText}" />
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                IsVisible="{Binding CanHandleIncomingOffer}">
                        <Button Classes="Primary" Content="{DynamicResource 'lang.kitopia.accept'}"
                                Command="{Binding AcceptCommand}"
                                CommandParameter="{Binding .}" />
                        <Button Classes="Secondary" Content="{DynamicResource 'lang.kitopia.reject'}"
                                Command="{Binding RejectCommand}"
                                CommandParameter="{Binding .}" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding IsReceiving}">
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding ReceiveProgress}"
                                     Height="6" MinWidth="220" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   IsVisible="{Binding HasState}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border MaxWidth="420" Padding="10"
                    IsVisible="{Binding IsOutgoing}"
                    Background="{StaticResource OutgoingBubbleBrush}"
                    CornerRadius="10"
                    HorizontalAlignment="Right">
                <StackPanel Spacing="6">
                    <Image Source="{Binding ImagePreview}"
                           IsVisible="{Binding HasImage}"
                           MaxWidth="320" Stretch="Uniform"
                           Cursor="Hand">
                        <Image.ContextFlyout>
                            <MenuFlyout>
                                <MenuItem Header="{DynamicResource 'lang.kitopia.enlarge'}"
                                          Command="{Binding PreviewImageCommand}"
                                          CommandParameter="{Binding .}" />
                                <MenuItem Header="{DynamicResource 'lang.kitopia.copy_image'}"
                                          Command="{Binding CopyImageCommand}"
                                          CommandParameter="{Binding .}" />
                            </MenuFlyout>
                        </Image.ContextFlyout>
                    </Image>
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                         IsVisible="{Binding HasText}"
                                         Foreground="White" />
                    <StackPanel Spacing="4" IsVisible="{Binding IsReceiving}">
                        <ProgressBar Minimum="0" Maximum="1"
                                     Value="{Binding ReceiveProgress}"
                                     Height="6" MinWidth="220" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding TimeText}"
                                   FontSize="11"
                                   Foreground="White" Opacity="0.85" />
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="11"
                                   Foreground="White" Opacity="0.85"
                                   IsVisible="{Binding HasState}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="FileChatMessageTemplate" x:DataType="vm:FileChatMessageItem">
        <StackPanel Margin="0,0,0,8">
            <Border MaxWidth="420" Padding="0"
                    IsVisible="{Binding IsIncomingFileOffer}"
                    Background="{StaticResource IncomingBubbleBrush}"
                    CornerRadius="10"
                    HorizontalAlignment="Left"
                    Cursor="Hand">
                <StackPanel>
                    <Border Background="{DynamicResource SemiColorFill1}" CornerRadius="8" Padding="12" Margin="8">
                        <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                                <Border Width="64" Height="64" CornerRadius="6"
                                        Background="{DynamicResource SemiColorFill0}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding FileIcon}" Width="48" Height="48"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                    <TextBlock Text="{Binding FileSizeText}"
                                               Foreground="{DynamicResource SemiColorText1}"
                                               FontSize="{DynamicResource SemiFontSizeSmall}" />
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReceiveProgress}"
                                                 Height="4" IsVisible="{Binding IsReceiving}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="6" Margin="0,8,0,0"
                                        IsVisible="{Binding CanHandleIncomingOffer}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="Primary" Content="{DynamicResource 'lang.kitopia.accept'}"
                                            Command="{Binding AcceptCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Classes="Secondary" Content="{DynamicResource 'lang.kitopia.reject'}"
                                            Command="{Binding RejectCommand}"
                                            CommandParameter="{Binding .}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding StateText}" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       IsVisible="{Binding HasState}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,4,12,8">
                        <TextBlock Text="{Binding TimeText}" FontSize="11"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                </StackPanel>
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem Header="{DynamicResource 'lang.kitopia.open'}"
                                  Command="{Binding OpenCommand}"
                                  CommandParameter="{Binding .}" />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.save_as'}"
                                  Command="{Binding SaveAsCommand}"
                                  CommandParameter="{Binding .}" />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.copy_file'}"
                                  Command="{Binding CopyFileCommand}"
                                  CommandParameter="{Binding .}" />
                        <Separator />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.cancel_transfer'}"
                                  IsVisible="{Binding IsTransferActive}"
                                  Command="{Binding CancelCommand}"
                                  CommandParameter="{Binding .}" />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.view_details'}"
                                  Command="{Binding ViewDetailsCommand}"
                                  CommandParameter="{Binding .}" />
                    </MenuFlyout>
                </Border.ContextFlyout>
            </Border>

            <Border MaxWidth="420" Padding="0"
                    IsVisible="{Binding IsOutgoing}"
                    Background="{StaticResource OutgoingBubbleBrush}"
                    CornerRadius="10"
                    HorizontalAlignment="Right"
                    Cursor="Hand">
                <StackPanel>
                    <Border Background="#33FFFFFF" CornerRadius="8" Padding="12" Margin="8">
                        <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                            <Border Width="64" Height="64" CornerRadius="6"
                                    Background="#22FFFFFF"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{Binding FileIcon}" Width="48" Height="48"
                                       Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="280"
                                           Foreground="White" />
                                <TextBlock Text="{Binding FileSizeText}"
                                           Foreground="White" Opacity="0.85"
                                           FontSize="{DynamicResource SemiFontSizeSmall}" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReceiveProgress}"
                                             Height="4" IsVisible="{Binding IsReceiving}"
                                             Foreground="White" />
                                <TextBlock Text="{Binding StateText}" FontSize="11"
                                           Foreground="White" Opacity="0.85"
                                           IsVisible="{Binding HasState}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,4,12,8">
                        <TextBlock Text="{Binding TimeText}" FontSize="11"
                                   Foreground="White" Opacity="0.85" />
                    </StackPanel>
                </StackPanel>
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuItem Header="{DynamicResource 'lang.kitopia.cancel_transfer'}"
                                  IsVisible="{Binding IsTransferActive}"
                                  Command="{Binding CancelCommand}" />
                        <MenuItem Header="{DynamicResource 'lang.kitopia.view_details'}"
                                  Command="{Binding ViewDetailsCommand}" />
                    </MenuFlyout>
                </Border.ContextFlyout>
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
