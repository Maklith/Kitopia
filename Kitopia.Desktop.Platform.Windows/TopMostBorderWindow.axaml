<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kitopia.Desktop.Platform.Windows.TopMostBorderWindow"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Title="TopMostBorder">
    <Border BorderBrush="#FF0078D7" BorderThickness="5" Background="Transparent" />
</Window>