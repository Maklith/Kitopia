<u:UrsaWindow xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:u="https://irihi.tech/ursa"
              xmlns:vm="clr-namespace:KitopiaEx.BatchRename"
              xmlns:lang="clr-namespace:PluginCore.Localization;assembly=PluginCore"
              x:Class="KitopiaEx.BatchRename.BatchRenameWindow"
              x:DataType="vm:BatchRenameViewModel"
              Width="1120" Height="800" MinWidth="960" MinHeight="600"
              WindowStartupLocation="CenterScreen" IsFullScreenButtonVisible="False"
              Background="{DynamicResource RenameCanvasBrush}"
              Title="{DynamicResource lang.kitopiaex.batch_rename.title}">
    <u:UrsaWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="RenameCanvasBrush" Color="#F5F6F8" />
                    <SolidColorBrush x:Key="RenameControlBorder" Color="#D1D5DB" />
                    <SolidColorBrush x:Key="RenameAccentForeground" Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="RenameCanvasBrush" Color="#181818" />
                    <SolidColorBrush x:Key="RenameControlBorder" Color="#29FFFFFF" />
                    <SolidColorBrush x:Key="RenameAccentForeground" Color="#111827" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </u:UrsaWindow.Resources>
    <u:UrsaWindow.Styles>
        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="{DynamicResource FluentFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button, ToggleButton, TextBox, ComboBox, NumericUpDown">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Button.tool, ToggleButton.tool">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.standard, ToggleButton.standard">
            <Setter Property="Background" Value="{DynamicResource KitopiaCardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RenameControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.standard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource KitopiaPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource RenameAccentForeground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KitopiaPrimaryHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource RenameAccentForeground}" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KitopiaPrimaryActiveBrush}" />
        </Style>
        <Style Selector="Border.status">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeNeutralBackground}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Border.status TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeNeutralForeground}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.status.completed">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeSuccessBackground}" />
        </Style>
        <Style Selector="Border.status.completed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeSuccessForeground}" />
        </Style>
        <Style Selector="Border.status.running">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeCurrentBackground}" />
        </Style>
        <Style Selector="Border.status.failed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
        </Style>
    </u:UrsaWindow.Styles>
    <Grid Margin="24,12,24,24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <TextBlock Text="{DynamicResource lang.kitopiaex.batch_rename.title}" FontSize="24" FontWeight="SemiBold" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanEdit}">
                <Button Classes="standard" Click="AddFiles_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="&#xe4db;" />
                        <TextBlock Text="{DynamicResource lang.kitopiaex.batch_rename.add_files}" />
                    </StackPanel>
                </Button>
                <Button Classes="standard" Click="AddFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="&#xf418;" />
                        <TextBlock Text="{DynamicResource lang.kitopiaex.compression.add_folder}" />
                    </StackPanel>
                </Button>
                <Button Classes="tool standard" Command="{Binding RefreshPreviewCommand}"
                        ToolTip.Tip="{DynamicResource lang.kitopiaex.batch_rename.refresh}">
                    <TextBlock Classes="icon" Text="&#xf13d;" />
                </Button>
                <Button Classes="tool" Theme="{StaticResource KitopiaDangerSubtleButton}" Command="{Binding ClearCommand}"
                        ToolTip.Tip="{DynamicResource lang.kitopiaex.compression.clear}">
                    <TextBlock Classes="icon" Text="&#xf34c;" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="label" VerticalAlignment="Center"
                       Text="{DynamicResource lang.kitopiaex.compression.adding}" IsVisible="{Binding IsAdding}" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,300" ColumnSpacing="16">
            <Border Padding="16" CornerRadius="12" Background="{DynamicResource KitopiaCardBackgroundBrush}"
                    BorderBrush="{DynamicResource KitopiaCardBorderBrush}" BorderThickness="1"
                    BoxShadow="{DynamicResource KitopiaCardBoxShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12"
                      DragDrop.AllowDrop="True" DragDrop.DragOver="Files_DragOver" DragDrop.Drop="Files_Drop">
                    <Grid ColumnDefinitions="*,150,34,34,34" ColumnSpacing="6" IsEnabled="{Binding CanEdit}">
                        <TextBlock Classes="label" Text="{DynamicResource lang.kitopiaex.batch_rename.preview}" VerticalAlignment="Center" />
                        <ComboBox Name="SortModeComboBox" Grid.Column="1" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}"
                                  HorizontalAlignment="Stretch" ToolTip.Tip="{DynamicResource lang.kitopiaex.batch_rename.sort}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{lang:Lang Value={Binding}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ToggleButton Name="SortDescendingButton" Grid.Column="2" Classes="tool standard"
                                      IsChecked="{Binding SortDescending}" IsEnabled="{Binding IsSorted}"
                                      ToolTip.Tip="{DynamicResource lang.kitopiaex.batch_rename.sort_descending}">
                            <Grid>
                                <TextBlock Classes="icon" Text="&#xf812;" IsVisible="{Binding !SortDescending}" />
                                <TextBlock Classes="icon" Text="&#xf805;" IsVisible="{Binding SortDescending}" />
                            </Grid>
                        </ToggleButton>
                        <Button Name="MoveUpButton" Grid.Column="3" Classes="tool standard" Command="{Binding MoveUpCommand}"
                                ToolTip.Tip="{DynamicResource lang.kitopiaex.batch_rename.move_up}">
                            <TextBlock Classes="icon" Text="&#xf19b;" />
                        </Button>
                        <Button Name="MoveDownButton" Grid.Column="4" Classes="tool standard" Command="{Binding MoveDownCommand}"
                                ToolTip.Tip="{DynamicResource lang.kitopiaex.batch_rename.move_down}">
                            <TextBlock Classes="icon" Text="&#xf148;" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,94,34" ColumnSpacing="10" Margin="8,0">
                        <TextBlock Classes="label" Text="{DynamicResource lang.kitopiaex.batch_rename.original_name}" />
                        <TextBlock Grid.Column="1" Classes="label" Text="{DynamicResource lang.kitopiaex.batch_rename.new_name}" />
                        <TextBlock Grid.Column="2" Classes="label" Text="{DynamicResource lang.kitopiaex.compression.status}" />
                    </Grid>
                    <ListBox Name="FileList" Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="MinHeight" Value="66" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:BatchRenameItem">
                                <Grid ColumnDefinitions="*,*,94,34" ColumnSpacing="10" Height="58">
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" />
                                        <TextBlock Classes="label" Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding NewName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TargetPath}" />
                                        <TextBlock Classes="label" Text="{Binding Error}" IsVisible="{Binding HasError}"
                                                   Foreground="{DynamicResource SemiColorDanger}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Error}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="status" Classes.completed="{Binding IsCompleted}"
                                            Classes.running="{Binding IsRunning}" Classes.failed="{Binding HasError}">
                                        <TextBlock Text="{lang:Lang Value={Binding Status}}" TextWrapping="Wrap" />
                                    </Border>
                                    <Button Grid.Column="3" Classes="tool" Theme="{StaticResource BorderlessButton}"
                                            IsEnabled="{Binding $parent[u:UrsaWindow].((vm:BatchRenameViewModel)DataContext).CanEdit}"
                                            Command="{Binding $parent[u:UrsaWindow].((vm:BatchRenameViewModel)DataContext).RemoveCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource lang.kitopiaex.batch_rename.remove}">
                                        <TextBlock Classes="icon" Text="&#xf369;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Classes="label" Text="{DynamicResource lang.kitopiaex.batch_rename.empty}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" IsHitTestVisible="False" />
                    <TextBlock Grid.Row="3" Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Padding="16" CornerRadius="12" Background="{DynamicResource KitopiaCardBackgroundBrush}"
                    BorderBrush="{DynamicResource KitopiaCardBorderBrush}" BorderThickness="1"
                    BoxShadow="{DynamicResource KitopiaCardBoxShadow}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" IsEnabled="{Binding CanEdit}">
                        <TextBlock Classes="label" Text="{DynamicResource lang.kitopiaex.batch_rename.rules}" />
                        <CheckBox Name="KeepOriginalNameOption" IsChecked="{Binding KeepOriginalName}"
                                  Content="{DynamicResource lang.kitopiaex.batch_rename.keep_name}" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource lang.kitopiaex.batch_rename.base_name}" />
                            <TextBox Name="BaseNameInput" Text="{Binding BaseName}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource lang.kitopiaex.batch_rename.prefix}" />
                                <TextBox Name="PrefixInput" Text="{Binding Prefix}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{DynamicResource lang.kitopiaex.batch_rename.suffix}" />
                                <TextBox Name="SuffixInput" Text="{Binding Suffix}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsEnabled="{Binding KeepOriginalName}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource lang.kitopiaex.batch_rename.find}" />
                                <TextBox Name="FindTextInput" Text="{Binding FindText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{DynamicResource lang.kitopiaex.batch_rename.replace}" />
                                <TextBox Name="ReplaceTextInput" Text="{Binding ReplaceText}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="6">
                            <CheckBox Name="NumberingOption" IsChecked="{Binding AddNumber}"
                                      Content="{DynamicResource lang.kitopiaex.batch_rename.numbering}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsEnabled="{Binding AddNumber}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="{DynamicResource lang.kitopiaex.batch_rename.start_number}" />
                                    <NumericUpDown Minimum="0" Maximum="2147483647" FormatString="0" Value="{Binding StartNumber}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Classes="label" Text="{DynamicResource lang.kitopiaex.batch_rename.digits}" />
                                    <NumericUpDown Minimum="1" Maximum="10" FormatString="0" Value="{Binding NumberDigits}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{DynamicResource lang.kitopiaex.compression.output_directory}" />
                            <Grid ColumnDefinitions="*,34" ColumnSpacing="6">
                                <TextBox Text="{Binding OutputDirectory}" PlaceholderText="{DynamicResource lang.kitopiaex.batch_rename.source_directory}" />
                                <Button Grid.Column="1" Classes="tool standard" Click="OutputFolder_Click"
                                        ToolTip.Tip="{DynamicResource lang.kitopiaex.compression.choose_directory}">
                                    <TextBlock Classes="icon" Text="&#xf418;" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <Separator />
                        <CheckBox Name="CompressImagesOption" IsChecked="{Binding CompressImages}">
                            <TextBlock Text="{DynamicResource lang.kitopiaex.batch_rename.compress_images}" TextWrapping="Wrap" />
                        </CheckBox>
                        <StackPanel Name="CompressionOptions" Spacing="10" IsVisible="{Binding CompressImages}">
                            <TextBlock Classes="label" Text="{DynamicResource lang.kitopiaex.batch_rename.keep_images}" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource lang.kitopiaex.compression.format}" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{lang:Lang Value={Binding}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Name="LosslessOption" IsChecked="{Binding Lossless}" IsVisible="{Binding CanChooseLossless}"
                                      Content="{DynamicResource lang.kitopiaex.compression.lossless}" />
                            <TextBlock Text="{DynamicResource lang.kitopiaex.compression.quality_mode}" IsVisible="{Binding CanSetQuality}" />
                            <Grid Name="QualityOptions" ColumnDefinitions="*,82" ColumnSpacing="6" IsVisible="{Binding CanSetQuality}">
                                <Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Quality}" />
                                <NumericUpDown Grid.Column="1" Minimum="1" Maximum="100" FormatString="0'%'" Value="{Binding Quality}" />
                            </Grid>
                            <TextBlock Text="{DynamicResource lang.kitopiaex.compression.resize}" />
                            <NumericUpDown Minimum="1" Maximum="100" FormatString="0'%'" Value="{Binding ResizePercent}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="64" Foreground="{DynamicResource SemiColorDanger}" />
            <ProgressBar Grid.Row="1" Height="4" Minimum="0" Maximum="{Binding Items.Count}"
                         Value="{Binding ProcessedCount}" IsVisible="{Binding IsBusy}" />
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="tool standard" Click="OpenOutput_Click" IsEnabled="{Binding !IsEmpty}"
                            ToolTip.Tip="{DynamicResource lang.kitopiaex.compression.open_output}">
                        <TextBlock Classes="icon" Text="&#xf42e;" />
                    </Button>
                    <Button Classes="standard" Command="{Binding StartCancelCommand}" IsVisible="{Binding IsBusy}"
                            Content="{DynamicResource lang.kitopiaex.compression.cancel}" />
                    <Button Name="StartButton" Classes="accent" Command="{Binding StartCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xf669;" />
                            <TextBlock Text="{DynamicResource lang.kitopiaex.batch_rename.start}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</u:UrsaWindow>
