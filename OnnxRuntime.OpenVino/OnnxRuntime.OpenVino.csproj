<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>1.0.6</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <AppendTargetFrameworkToOutputPath>output</AppendTargetFrameworkToOutputPath>
        <OutputPath>$(LocalAppData)\Kitopia\plugins\kitopiaonnxruntimeopenvino\</OutputPath>
        <OutputPath Condition="'$(OnnxRuntimeOutputPath)' != ''">$(OnnxRuntimeOutputPath)</OutputPath>

    </PropertyGroup>

    <ItemGroup>
        <!-- Intel EP 1.7.0 uses experimental EPContext APIs removed in ORT 1.31. -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
        <PackageReference Include="Intel.ML.OnnxRuntime.EP.OpenVINO" Version="1.7.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\OnnxRuntime.Shared\RuntimeAvailabilityProbe.cs" Link="RuntimeAvailabilityProbe.cs" />
        <ProjectReference Include="..\Kitopia.Desktop.PluginSdk\Kitopia.Desktop.PluginSdk.csproj">
            <Private>false</Private>
            <ExcludeAssets>runtime;native</ExcludeAssets>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
      <None Update="manifest.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    </ItemGroup>

    <!-- OpenVINOEp.GetLibraryPath requires the package's native runtime directory. -->
    <Target Name="PreserveOpenVinoNativeLayout" AfterTargets="ComputeFilesToPublish">
        <ItemGroup>
            <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                                   Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'Intel.ML.OnnxRuntime.EP.OpenVINO' And '%(ResolvedFileToPublish.AssetType)' == 'native'">
                <RelativePath>%(ResolvedFileToPublish.PathInPackage)</RelativePath>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
