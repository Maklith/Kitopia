<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:plugin="clr-namespace:Kitopia.Desktop.Features.ViewModel.Pages.plugin;assembly=Kitopia.Desktop.Features"
             xmlns:plugin11="clr-namespace:Kitopia.Desktop.Features.Services.Plugin"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="590"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             x:DataType="plugin:PluginDetailViewModel"
             Width="950"
             Height="590"
             x:Class="Kitopia.Desktop.Features.UI.UiControls.Plugin.PluginDetail">

    <Border BorderThickness="0"
            CornerRadius="12"
            Background="{DynamicResource SemiColorBackground1}"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
            <!-- Modal Title Bar / Header with Close Button -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,14,20,10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="插件详情"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Name="CloseButton"
                        Theme="{DynamicResource BorderlessButton}"
                        Command="{Binding CloseDialogCommand}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        CornerRadius="6"
                        FontSize="14"
                        Foreground="{DynamicResource SemiColorText2}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Cursor="Hand"
                        Click="CloseButton_Click"
                        ToolTip.Tip="关闭"
                        Content="✕">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
                        </Style>
                        <Style Selector="Button:pressed /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>

            <!-- Scrollable Content with 3 Cards -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="24,4,24,20">
                    <!-- ============================================== -->
                    <!-- CARD 1: Basic Info & Author & Stats (Top Card) -->
                    <!-- ============================================== -->
                    <Border CornerRadius="12"
                            Background="{DynamicResource SemiColorBackground0}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="1"
                            Padding="24"
                            BoxShadow="0 1 3 0 #0F000000">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                            <!-- Left: Large 72x72 Plugin Avatar / Initial -->
                            <Border Grid.Column="0" Width="72" Height="72"
                                    CornerRadius="16" ClipToBounds="True"
                                    Background="#E0F2FE" VerticalAlignment="Top">
                                <Panel>
                                    <TextBlock Text="{Binding PluginInfo.PluginInitial}"
                                               Foreground="#1D4ED8"
                                               FontWeight="Bold"
                                               FontSize="28"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding PluginInfo.Icon}"
                                           Width="72" Height="72"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding PluginInfo.Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </Panel>
                            </Border>

                            <!-- Middle: Name, Status, NameSign, Author, Description, Platforms, Tags -->
                            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">
                                <!-- Name and Status Pill -->
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PluginInfo.PluginBaseInfo.Name}"
                                               FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource SemiColorText0}"
                                               VerticalAlignment="Center" />
                                    <Border CornerRadius="999" Padding="10,3"
                                            Background="#ECFDF5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PluginInfo.PublicationStatusText}"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="#047857" />
                                    </Border>
                                </StackPanel>

                                <!-- NameSign -->
                                <TextBlock Text="{Binding PluginInfo.PluginBaseInfo.NameSign}"
                                           FontSize="13" Foreground="{DynamicResource SemiColorText2}" />

                                <!-- Author row: Avatar + Name + @Handle (Clickable to search author) -->
                                <Button Command="{Binding SearchAuthorCommand}"
                                        CommandParameter="{Binding $parent[u:DialogControlBase]}"
                                        Padding="0" MinHeight="0"
                                        Theme="{DynamicResource BorderlessButton}"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        Margin="0,2,0,0">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover TextBlock.DetailAuthorName">
                                            <Setter Property="Foreground" Value="#2563EB" />
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="30" Height="30"
                                                CornerRadius="15" ClipToBounds="True"
                                                Background="#E0F2FE">
                                            <Panel>
                                                <TextBlock Text="{Binding PluginInfo.AuthorInitial}"
                                                           Foreground="#1D4ED8"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding PluginInfo.AuthorAvatar}"
                                                       Width="30" Height="30"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding PluginInfo.AuthorAvatar, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="DetailAuthorName"
                                                       Text="{Binding PluginInfo.AuthorName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SemiColorText0}" />
                                            <TextBlock Text="{Binding PluginInfo.AuthorHandle}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       IsVisible="{Binding PluginInfo.AuthorHandle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Short Description -->
                                <TextBlock Text="{Binding PluginInfo.DescriptionShort}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           LineHeight="20"
                                           Foreground="{DynamicResource SemiColorText1}"
                                           Margin="0,4,0,0" />

                                <!-- Platforms -->
                                <ItemsControl ItemsSource="{Binding PluginInfo.DisplayPlatforms}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="{DynamicResource SemiColorBackground2}"
                                                    CornerRadius="6" Padding="8,3">
                                                <TextBlock Text="{Binding .}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Tags row (if any) -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                                            IsVisible="{Binding PluginInfo.HasTags}">
                                    <TextBlock Text="标签"
                                               FontSize="11" FontWeight="Medium"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding PluginInfo.Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="plugin11:PluginTag">
                                                <Border Background="{DynamicResource KitopiaBadgeTagBackground}"
                                                        CornerRadius="4" Padding="7,2">
                                                    <TextBlock Text="{Binding Name, StringFormat='# {0}'}"
                                                               FontSize="11" FontWeight="Medium"
                                                               Foreground="{DynamicResource KitopiaBadgeTagForeground}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Statistics (最新版本 & 下载量 & 评分) -->
                            <StackPanel Grid.Column="2" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,0,0,0">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="最新版本" FontSize="12" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding PluginInfo.Version}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SemiColorText0}"
                                               HorizontalAlignment="Right" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="下载量" FontSize="12" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding PluginInfo.DownloadCounts}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SemiColorText0}"
                                               HorizontalAlignment="Right" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="评分" FontSize="12" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Right" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" Margin="0,2,0,0">
                                        <TextBlock Text="★" FontSize="13" Foreground="{DynamicResource SemiColorWarning}"
                                                   VerticalAlignment="Center" IsVisible="{Binding PluginInfo.HasRatings}" />
                                        <TextBlock Text="☆" FontSize="13" Foreground="{DynamicResource SemiColorText3}"
                                                   VerticalAlignment="Center" IsVisible="{Binding !PluginInfo.HasRatings}" />
                                        <TextBlock Text="{Binding PluginInfo.RatingScoreText}"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SemiColorText0}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding PluginInfo.HasRatings}" />
                                        <TextBlock Text="—"
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !PluginInfo.HasRatings}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding PluginInfo.RatingCount, StringFormat='{}{0} 条评价'}"
                                               FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                                               HorizontalAlignment="Right" Margin="0,2,0,0"
                                               IsVisible="{Binding PluginInfo.HasRatings}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============================================== -->
                    <!-- CARD 2: Detailed Description (详细介绍)        -->
                    <!-- ============================================== -->
                    <Border CornerRadius="12"
                            Background="{DynamicResource SemiColorBackground0}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="1"
                            Padding="24"
                            BoxShadow="0 1 3 0 #0F000000">
                        <StackPanel Spacing="10">
                            <TextBlock Text="插件介绍"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock Text="详细介绍"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SemiColorText0}" />
                            <Border Margin="0,6,0,0">
                                <mdxaml:MarkdownScrollViewer
                                    Markdown="{Binding PluginInfo.Description}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ============================================== -->
                    <!-- CARD 3: Version Timeline (版本时间线与记录)    -->
                    <!-- ============================================== -->
                    <Border CornerRadius="12"
                            Background="{DynamicResource SemiColorBackground0}"
                            BorderBrush="{DynamicResource SemiColorBorder}"
                            BorderThickness="1"
                            Padding="24"
                            BoxShadow="0 1 3 0 #0F000000">
                        <StackPanel Spacing="16">
                            <!-- Timeline Header -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="版本时间线"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource SemiColorText2}" />
                                    <TextBlock Text="全部版本与审核记录"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource SemiColorText0}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PluginInfo.TimelineVersionDetails.Count, StringFormat='共 {0} 个版本'}"
                                           FontSize="13" Foreground="{DynamicResource SemiColorText2}"
                                           VerticalAlignment="Bottom" />
                            </Grid>

                            <!-- Timeline Items -->
                            <ItemsControl ItemsSource="{Binding PluginInfo.TimelineVersionDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="plugin11:VersionDetail">
                                        <Grid ColumnDefinitions="24,*" Margin="0,0,0,20">
                                            <!-- Vertical line and dot indicator -->
                                            <Panel Grid.Column="0">
                                                <Border Width="2" Background="{DynamicResource SemiColorBorder}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Stretch" Margin="0,14,0,0" />
                                                <Border Width="12" Height="12" CornerRadius="6"
                                                        Background="{DynamicResource SemiColorText2}"
                                                        BorderBrush="White" BorderThickness="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                                                        BoxShadow="0 1 3 0 #20000000" IsVisible="{Binding IsDraft}" />
                                                <Border Width="12" Height="12" CornerRadius="6"
                                                        Background="{DynamicResource SemiColorText2}"
                                                        BorderBrush="White" BorderThickness="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                                                        BoxShadow="0 1 3 0 #20000000" IsVisible="{Binding IsWithdrawn}" />
                                                <Border Width="12" Height="12" CornerRadius="6"
                                                        Background="{DynamicResource SemiColorSuccess}"
                                                        BorderBrush="White" BorderThickness="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                                                        BoxShadow="0 1 3 0 #20000000" IsVisible="{Binding IsPublished}" />
                                                <Border Width="12" Height="12" CornerRadius="6"
                                                        Background="{DynamicResource SemiColorWarning}"
                                                        BorderBrush="White" BorderThickness="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                                                        BoxShadow="0 1 3 0 #20000000" IsVisible="{Binding IsPendingReview}" />
                                                <Border Width="12" Height="12" CornerRadius="6"
                                                        Background="{DynamicResource SemiColorDanger}"
                                                        BorderBrush="White" BorderThickness="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                                                        BoxShadow="0 1 3 0 #20000000" IsVisible="{Binding IsRejected}" />
                                            </Panel>

                                            <!-- Content -->
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                                                <!-- Header row: Version, Status chip, Current tag, Platform tags -->
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FormattedVersion}"
                                                                   FontSize="16" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SemiColorText0}"
                                                                   VerticalAlignment="Center" />
                                                        <Border CornerRadius="999" Padding="8,2"
                                                                Background="{DynamicResource KitopiaBadgeNeutralBackground}" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsDraft}">
                                                            <TextBlock Text="草稿" FontSize="11" FontWeight="Medium"
                                                                       Foreground="{DynamicResource KitopiaBadgeNeutralForeground}" />
                                                        </Border>
                                                        <Border CornerRadius="999" Padding="8,2"
                                                                Background="{DynamicResource KitopiaBadgeSuccessBackground}" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsPublished}">
                                                            <TextBlock Text="已发布" FontSize="11" FontWeight="Medium"
                                                                       Foreground="{DynamicResource KitopiaBadgeSuccessForeground}" />
                                                        </Border>
                                                        <Border CornerRadius="999" Padding="8,2"
                                                                Background="{DynamicResource KitopiaBadgeNeutralBackground}" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsWithdrawn}">
                                                            <TextBlock Text="已撤回" FontSize="11" FontWeight="Medium"
                                                                       Foreground="{DynamicResource KitopiaBadgeNeutralForeground}" />
                                                        </Border>
                                                        <Border CornerRadius="999" Padding="8,2"
                                                                Background="{DynamicResource KitopiaBadgeCurrentBackground}" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsPendingReview}">
                                                            <TextBlock Text="待审核" FontSize="11" FontWeight="Medium"
                                                                       Foreground="{DynamicResource KitopiaBadgeCurrentForeground}" />
                                                        </Border>
                                                        <Border CornerRadius="999" Padding="8,2"
                                                                Background="{DynamicResource KitopiaBadgeDangerBackground}" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsRejected}">
                                                            <TextBlock Text="已拒绝" FontSize="11" FontWeight="Medium"
                                                                       Foreground="{DynamicResource KitopiaBadgeDangerForeground}" />
                                                        </Border>
                                                        <Border CornerRadius="999" Padding="8,2"
                                                                Background="#EFF6FF" VerticalAlignment="Center"
                                                                IsVisible="{Binding IsCurrent}">
                                                            <TextBlock Text="当前版本"
                                                                       FontSize="11" FontWeight="Medium"
                                                                       Foreground="#2563EB" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Platforms -->
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DisplayPlatforms}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Background="{DynamicResource SemiColorBackground2}"
                                                                        CornerRadius="6" Padding="6,2">
                                                                    <TextBlock Text="{Binding .}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource SemiColorText2}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>

                                                <!-- Timestamp -->
                                                <TextBlock Text="{Binding FormattedCreateTime}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SemiColorText2}" />

                                                <!-- Candidate detail while a release is under review -->
                                                <Grid IsVisible="{Binding HasCandidateDetail}"
                                                      ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                                    <Border Grid.Column="0" BorderBrush="{DynamicResource SemiColorBorder}"
                                                            BorderThickness="1" CornerRadius="6" Padding="10">
                                                        <StackPanel>
                                                            <TextBlock Text="线上版本说明" FontSize="11"
                                                                       Foreground="{DynamicResource SemiColorText2}" />
                                                            <TextBlock Text="{Binding CurrentDetailDisplay}" TextWrapping="Wrap"
                                                                       FontSize="12" Foreground="{DynamicResource SemiColorText1}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" BorderBrush="{DynamicResource KitopiaBadgeTagForeground}"
                                                            BorderThickness="1" CornerRadius="6" Padding="10"
                                                            Background="{DynamicResource KitopiaBadgeTagBackground}">
                                                        <StackPanel>
                                                            <TextBlock Text="候选版本说明（待审核）" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource KitopiaBadgeTagForeground}" />
                                                            <TextBlock Text="{Binding CandidateDetailDisplay}" TextWrapping="Wrap"
                                                                       FontSize="12" Foreground="{DynamicResource SemiColorText1}"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- Detail / Notes -->
                                                <TextBlock Text="{Binding Detail}"
                                                           TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                                           Foreground="{DynamicResource SemiColorText1}" Margin="0,4,0,6"
                                                           IsVisible="{Binding !HasCandidateDetail}" />

                                                <!-- Action Buttons: 一键安装到 Kitopia -->
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                    <Button Classes="Primary"
                                                            Content="一键安装到 Kitopia"
                                                            FontSize="12" Padding="12,4" Height="28" MinHeight="28"
                                                            CornerRadius="6"
                                                            IsVisible="{Binding CanDownload}"
                                                            Command="{Binding Path=$parent[ItemsControl].((plugin:PluginDetailViewModel)DataContext).InstallVersionCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    <TextBlock Text="审核中，通过后公开" FontSize="12"
                                                               Foreground="{DynamicResource SemiColorWarning}"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsPendingReview}" />
                                                    <TextBlock Text="审核未通过，修改后可重新提交" FontSize="12"
                                                               Foreground="{DynamicResource SemiColorDanger}"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsRejected}" />
                                                    <TextBlock Text="已撤回" FontSize="12"
                                                               Foreground="{DynamicResource SemiColorText2}"
                                                               VerticalAlignment="Center" IsVisible="{Binding IsWithdrawn}" />
                                                </StackPanel>

                                                <!-- Folded audit details -->
                                                <Expander Header="{Binding ReviewHistoryText}"
                                                          IsVisible="{Binding HasReviewHistory}" Margin="0,3,0,0">
                                                    <StackPanel Spacing="8">
                                                        <ItemsControl ItemsSource="{Binding Events}" Margin="0,5,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="plugin11:VersionDetail">
                                                                    <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,1,0,0"
                                                                            Padding="0,8,0,0" Margin="0,3,0,0">
                                                                        <StackPanel Spacing="3">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                                                           FontWeight="SemiBold" Foreground="{DynamicResource SemiColorText1}" />
                                                                                <TextBlock Text="{Binding FormattedRecordTime}" FontSize="11"
                                                                                           Foreground="{DynamicResource SemiColorText2}" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"
                                                                                       Foreground="{DynamicResource SemiColorText1}"
                                                                                       IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                            <TextBlock Text="{Binding ReviewComment, StringFormat='审核意见：{0}'}"
                                                                                       TextWrapping="Wrap" FontSize="12"
                                                                                       Foreground="{DynamicResource SemiColorDanger}"
                                                                                       IsVisible="{Binding HasReviewComment}" />
                                                                            <TextBlock Text="{Binding FormattedReviewedTime}" FontSize="11"
                                                                                       Foreground="{DynamicResource SemiColorText2}"
                                                                                       IsVisible="{Binding HasReviewedAt}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <StackPanel Spacing="3" IsVisible="{Binding HasStandaloneReview}">
                                                            <TextBlock Text="{Binding ReviewComment, StringFormat='审核意见：{0}'}"
                                                                       TextWrapping="Wrap" FontSize="12"
                                                                       Foreground="{DynamicResource SemiColorDanger}"
                                                                       IsVisible="{Binding HasReviewComment}" />
                                                            <TextBlock Text="{Binding FormattedReviewedTime}" FontSize="11"
                                                                       Foreground="{DynamicResource SemiColorText2}"
                                                                       IsVisible="{Binding HasReviewedAt}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Bottom spacer to guarantee smooth scrolling past the bottom card -->
                    <Border Height="24" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
