<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Core.Window.TopMostActionWindow"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        Title="TopMostAction">
    <Button Name="CancelButton" Content="取消置顶" Cursor="Hand" Theme="{DynamicResource BorderlessButton}"  BorderThickness="1" CornerRadius="4" Padding="8,4" />
</Window>