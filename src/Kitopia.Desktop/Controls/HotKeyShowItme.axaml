<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Kitopia.Desktop.Controls">
    <Design.PreviewWith>
        <StackPanel>
            <controls:HotKeyShowItme Content="Ctrl" />
            <controls:HotKeyShowItme IsEnabled="False" Content="Ctrl" />
        </StackPanel>

    </Design.PreviewWith>

    <Style Selector="controls|HotKeyShowItme">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Cascadia Code, Segoe UI Variable, Segoe UI, -apple-system, sans-serif" />
        <Setter Property="Foreground" Value="{DynamicResource KitopiaKeycapForeground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Root"
                        Background="{DynamicResource KitopiaKeycapBackground}"
                        BorderBrush="{DynamicResource KitopiaKeycapBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="7,2"
                        MinHeight="25"
                        MinWidth="26"
                        BoxShadow="{DynamicResource KitopiaKeycapBoxShadow}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12" />
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ContentPresenter
                            x:Name="ControlIcon"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}"
                            IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="0,0,4,0"
                            Focusable="False" />

                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|HotKeyShowItme:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
</Styles>