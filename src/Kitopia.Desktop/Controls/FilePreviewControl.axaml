<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preview="clr-namespace:Kitopia.Desktop.Features.Search.Preview;assembly=Kitopia.Desktop.Features"
             xmlns:vm="clr-namespace:Kitopia.Desktop.Features.Search.ViewModels;assembly=Kitopia.Desktop.Features"
             x:Class="Kitopia.Desktop.Controls.FilePreviewControl"
             x:DataType="vm:MouseQuickWindowViewModel">
    <UserControl.Styles>
        <Style Selector="Button.preview-entry">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.preview-entry:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Name="NavigationBar" Padding="12,8"
                IsVisible="{Binding ShowNavigationBar}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Name="NavigateUpButton"
                        Theme="{DynamicResource BorderlessButton}"
                        Command="{Binding NavigateUpCommand}"
                        Padding="8,4" CornerRadius="6"
                        ToolTip.Tip="{DynamicResource 'lang.kitopia.navigate_up'}"
                        AutomationProperties.Name="{DynamicResource 'lang.kitopia.navigate_up'}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Width="12" Height="12"
                                  Data="M 7,1 L 1,7 7,13 8,12 3.5,7.5 15,7.5 15,6.5 3.5,6.5 8,2 Z" />
                        <TextBlock Text="{DynamicResource 'lang.kitopia.navigate_up'}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1"
                           Name="CurrentDirectoryText"
                           Text="{Binding CurrentDirectoryPath}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SemiColorText2}"
                           ToolTip.Tip="{Binding CurrentDirectoryPath}" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Name="ImageViewport" ClipToBounds="True"
              IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Image Name="ImagePreview" Source="{Binding PreviewImage}" Stretch="Uniform"
                   Width="{Binding #ImageViewport.Bounds.Width}" Height="{Binding #ImageViewport.Bounds.Height}"
                   RenderOptions.BitmapInterpolationMode="MediumQuality" RenderTransformOrigin="0%,0%" />
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="24" IsVisible="{Binding PreviewText, Converter={x:Static ObjectConverters.IsNotNull}}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontWeight="Normal"
                                 FontFamily="Cascadia Code, Consolas, Microsoft YaHei" FontSize="14" LineHeight="23"
                                 Foreground="{DynamicResource SemiColorText0}" />
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" Padding="12,8" IsVisible="{Binding Entries, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ItemsControl Name="EntriesList" ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="preview:FilePreviewEntry">
                        <Button Classes="preview-entry"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding $parent[UserControl].((vm:MouseQuickWindowViewModel)DataContext).OpenEntryCommand}"
                                CommandParameter="{Binding .}"
                                ToolTip.Tip="{Binding Name}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <PathIcon Width="18" Height="18" Foreground="{DynamicResource KitopiaPrimaryBrush}"
                                          IsVisible="{Binding IsDirectory}"
                                          Data="M 1,3 L 7,3 9,5 23,5 23,20 1,20 Z M 3,7 L 3,18 21,18 21,7 Z" />
                                <PathIcon Width="18" Height="18" Foreground="{DynamicResource SemiColorText2}"
                                          IsVisible="{Binding !IsDirectory}"
                                          Data="M 4,1 L 15,1 21,7 21,23 4,23 Z M 6,3 L 6,21 19,21 19,9 13,9 13,3 Z M 15,4 L 15,7 18,7 Z" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText0}" />
                                <TextBlock Grid.Column="2" Text="{Binding Details}" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText2}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ContentControl Grid.Row="1" Name="NativePreview" />
        <StackPanel Grid.Row="1" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="440" Margin="24">
            <PathIcon Width="48" Height="48" Foreground="{DynamicResource KitopiaPrimaryBrush}"
                      Data="M 4,1 L 15,1 21,7 21,23 4,23 Z M 6,3 L 6,21 19,21 19,9 13,9 13,3 Z M 15,4 L 15,7 18,7 Z" />
            <TextBlock Text="{Binding FileName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="{Binding Message}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource SemiColorText2}" />
            <StackPanel Spacing="12" HorizontalAlignment="Center"
                        IsVisible="{Binding IsArchiveExtractPromptVisible}">
                <CheckBox Name="DontAskArchiveExtractCheckBox"
                          Content="{DynamicResource 'lang.kitopia.do_not_ask_again'}"
                          IsChecked="{Binding DontAskArchiveExtractAgain}"
                          HorizontalAlignment="Center"
                          FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button Name="ConfirmArchiveExtractButton"
                            Content="{DynamicResource 'lang.kitopia.extract_and_preview'}"
                            Command="{Binding ConfirmArchiveExtractCommand}"
                            CornerRadius="6" Height="32" Padding="16,0"
                            FontSize="12" FontWeight="Medium"
                            Theme="{DynamicResource SolidButton}" Classes="Primary" />
                    <Button Name="CancelArchiveExtractButton"
                            Content="{DynamicResource 'lang.kitopia.cancel'}"
                            Command="{Binding CancelArchiveExtractCommand}"
                            CornerRadius="6" Height="32" Padding="16,0"
                            FontSize="12" FontWeight="Medium" />
                </StackPanel>
            </StackPanel>
            <Button Name="OpenUnsupportedFileButton"
                    Content="{DynamicResource 'lang.kitopia.open_file'}"
                    Command="{Binding OpenFileCommand}"
                    IsVisible="{Binding ShowOpenFileButton}"
                    HorizontalAlignment="Center"
                    CornerRadius="6" Height="32" Padding="16,0"
                    FontSize="12" FontWeight="Medium"
                    Theme="{DynamicResource SolidButton}" Classes="Primary" />
        </StackPanel>
        <StackPanel Grid.Row="1" IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="160" Height="3" />
            <TextBlock Text="{DynamicResource 'lang.kitopia.reading_file'}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="8,4"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{DynamicResource 'lang.kitopia.zoom'}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText2}" />
            <Slider Name="ImageZoom" Minimum="1" Maximum="4" Value="1" Width="100" SmallChange="0.25" />
        </StackPanel>
    </Grid>
</UserControl>
