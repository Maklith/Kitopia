<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"
             xmlns:vm="clr-namespace:Kitopia.Desktop.Features.ViewModel.Account;assembly=Kitopia.Desktop.Features"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="60"
             x:DataType="vm:AccountCardViewModel"
             x:Class="Kitopia.Desktop.Controls.AccountCardControl">

    <Border Background="{DynamicResource KitopiaCardBackgroundBrush}"
            BorderBrush="{DynamicResource KitopiaCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,10">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
            <!-- Left: Avatar -->
            <Border Grid.Column="0"
                    Width="32" Height="32"
                    CornerRadius="16"
                    ClipToBounds="True"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    Background="{DynamicResource KitopiaAvatarBackground}">
                <Panel>
                    <!-- Not Logged In Default Icon -->
                    <controls:FontIcon Glyph="&#xf5be;"
                                       FontSize="18"
                                       Foreground="{DynamicResource SemiColorText2}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsLoggedIn}" />

                    <!-- Logged In Initial Placeholder -->
                    <TextBlock Text="{Binding AvatarInitial}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource KitopiaAvatarForeground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsLoggedIn}" />

                    <!-- Logged In Image Avatar -->
                    <Image Source="{Binding AvatarBitmap}"
                           Width="32" Height="32"
                           Stretch="UniformToFill"
                           IsVisible="{Binding AvatarBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Panel>
            </Border>

            <!-- Center: Info Column -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <!-- Not Logged In State -->
                <TextBlock IsVisible="{Binding !IsLoggedIn}"
                               Text="{DynamicResource 'lang.kitopia.not_signed_in_to_kitopia'}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{DynamicResource 'lang.kitopia.sign_in_through_your_browser_to_sync_your_profile_and_manage_plugins'}"
                               Foreground="{DynamicResource SemiColorText0}" />

                <!-- Logged In State -->
                <StackPanel Spacing="2" IsVisible="{Binding IsLoggedIn}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SemiColorText0}"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1" Background="{DynamicResource KitopiaBadgeSuccessBackground}"
                                CornerRadius="4"
                                Padding="6,1.5"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding PrimaryRole}"
                                       Foreground="{DynamicResource KitopiaBadgeSuccessForeground}"
                                       FontSize="11"
                                       FontWeight="Medium" />
                        </Border>
                    </Grid>

                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SemiColorText2}">
                        <Run Text="@" /><Run Text="{Binding UserName}" /><Run Text="  ·  " /><Run Text="{Binding Email}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Right: Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Not Logged In Actions -->
                <Panel IsVisible="{Binding !IsLoggedIn}">
                    <!-- Normal Login Trigger -->
                    <Button Theme="{DynamicResource SolidButton}" Classes="Primary"
                            IsVisible="{Binding !IsLoggingIn}"
                            Command="{Binding LoginCommand}"
                            Height="30"
                            CornerRadius="6"
                            Padding="12,0"
                            VerticalContentAlignment="Center"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <controls:FontIcon Glyph="&#xf45a;" FontSize="15"
                                               Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{DynamicResource 'lang.kitopia.sign_in_with_browser'}" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Waiting in Browser State -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsLoggingIn}">
                        <TextBlock Text="{DynamicResource 'lang.kitopia.waiting_for_browser_authorization'}"
                                   FontSize="12"
                                   MaxWidth="180" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   VerticalAlignment="Center" />
                        <Button Content="{DynamicResource 'lang.kitopia.reopen'}"
                                Command="{Binding LoginCommand}"
                                Height="30"
                                CornerRadius="6"
                                Padding="10,0"
                                FontSize="12"
                                Cursor="Hand" />
                        <Button Content="{DynamicResource 'lang.kitopia.cancel'}"
                                Command="{Binding CancelLoginCommand}"
                                Height="30"
                                CornerRadius="6"
                                Padding="10,0"
                                FontSize="12"
                                Cursor="Hand" />
                    </StackPanel>
                </Panel>

                <!-- Logged In Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsLoggedIn}">
                    <Button Content="{DynamicResource 'lang.kitopia.manage_web_account'}"
                            Command="{Binding OpenWebAccountCommand}"
                            Height="32"
                            CornerRadius="6"
                            Padding="12,0"
                            FontSize="12"
                            FontWeight="Medium"
                            Cursor="Hand" />
                    <Button Content="{DynamicResource 'lang.kitopia.refresh'}"
                            Command="{Binding RefreshCommand}"
                            Height="32"
                            CornerRadius="6"
                            Padding="12,0"
                            FontSize="12"
                            FontWeight="Medium"
                            Cursor="Hand" />
                    <Button Content="{DynamicResource 'lang.kitopia.sign_out'}"
                            Command="{Binding LogoutCommand}"
                            Height="32"
                            CornerRadius="6"
                            Padding="12,0"
                            FontSize="12"
                            FontWeight="Medium"
                            Theme="{DynamicResource KitopiaDangerSubtleButton}"
                            Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
