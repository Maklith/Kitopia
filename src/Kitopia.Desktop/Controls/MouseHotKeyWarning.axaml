<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kitopia.Desktop.Controls"
             x:Class="Kitopia.Desktop.Controls.MouseHotKeyWarning"
             IsVisible="False">
    <UserControl.Styles>
        <Style Selector="controls|MouseHotKeyWarning.compact">
            <Setter Property="Template">
                <ControlTemplate>
                    <Button Name="WarningIndicator" Width="28" Height="28" Padding="6" CornerRadius="6"
                            Theme="{DynamicResource BorderlessButton}" Background="Transparent"
                            PointerEntered="WarningIndicator_OnPointerEntered"
                            AutomationProperties.Name="{DynamicResource lang.kitopia.hotkeys.mouse_unavailable}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Transient">
                                <Flyout.FlyoutPresenterTheme>
                                    <ControlTheme TargetType="FlyoutPresenter" BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="CornerRadius" Value="6" />
                                    </ControlTheme>
                                </Flyout.FlyoutPresenterTheme>
                                <ContentPresenter Content="{TemplateBinding Content}" MaxWidth="360" />
                            </Flyout>
                        </Button.Flyout>
                        <PathIcon Data="{DynamicResource NotificationCardWarningIconPathData}"
                                  Foreground="{DynamicResource KitopiaBadgeWarningForeground}" />
                    </Button>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
    <Border Padding="12" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource KitopiaBadgeWarningBackground}"
            BorderBrush="{DynamicResource KitopiaBadgeWarningBorder}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <PathIcon Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0"
                      Data="{DynamicResource NotificationCardWarningIconPathData}"
                      Foreground="{DynamicResource KitopiaBadgeWarningForeground}" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{DynamicResource lang.kitopia.hotkeys.mouse_unavailable}"
                           FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource KitopiaBadgeWarningForeground}" />
                <TextBlock Name="CaptureWarning" Text="{DynamicResource lang.kitopia.hotkeys.enable_mouse_capture}"
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText1}" />
                <TextBlock Name="HookWarning" Text="{DynamicResource lang.kitopia.hotkeys.mouse_hook_not_running}"
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText1}" />
                <Button Name="EnableCaptureButton" Content="{DynamicResource lang.kitopia.hotkeys.enable_mouse_capture_action}"
                        Click="EnableCaptureButton_OnClick" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Classes="Primary" Theme="{DynamicResource SolidButton}"
                        Height="28" Padding="12,0" CornerRadius="6" FontSize="12" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
