<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Kitopia.Desktop.Controls"
             xmlns:sharedControls="clr-namespace:Kitopia.Feature.Avalonia.Controls;assembly=Kitopia.Feature.Avalonia"
             x:Class="Kitopia.Desktop.Controls.MouseHotKeyWarning"
             IsVisible="False">
    <UserControl.Styles>
        <Style Selector="controls|MouseHotKeyWarning.compact">
            <Setter Property="Template">
                <ControlTemplate>
                    <sharedControls:HoverFlyoutButton Name="WarningIndicator" Theme="{DynamicResource KitopiaWarningIndicatorButton}"
                            AutomationProperties.Name="{DynamicResource lang.kitopia.hotkeys.mouse_unavailable}">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Transient"
                                    FlyoutPresenterTheme="{DynamicResource KitopiaWarningFlyoutPresenter}">
                                <ContentPresenter Content="{TemplateBinding Content}" MaxWidth="360" />
                            </Flyout>
                        </Button.Flyout>
                        <PathIcon Data="{DynamicResource NotificationCardWarningIconPathData}"
                                  Foreground="{DynamicResource KitopiaBadgeWarningForeground}" />
                    </sharedControls:HoverFlyoutButton>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
    <HeaderedContentControl Theme="{DynamicResource KitopiaWarningCard}"
                            Header="{DynamicResource lang.kitopia.hotkeys.mouse_unavailable}">
        <StackPanel Spacing="4">
            <TextBlock Name="CaptureWarning" Text="{DynamicResource lang.kitopia.hotkeys.enable_mouse_capture}"
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText1}" />
            <TextBlock Name="HookWarning" Text="{DynamicResource lang.kitopia.hotkeys.mouse_hook_not_running}"
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText1}" />
            <Button Name="EnableCaptureButton" Content="{DynamicResource lang.kitopia.hotkeys.enable_mouse_capture_action}"
                    Click="EnableCaptureButton_OnClick" HorizontalAlignment="Left" Margin="0,4,0,0"
                    Classes="Primary" Theme="{DynamicResource KitopiaWarningActionButton}" />
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
