<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Kitopia.Desktop.Controls"
             xmlns:pages="clr-namespace:Kitopia.Desktop.Features.ViewModel.Pages;assembly=Kitopia.Desktop.Features"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="620"
             x:DataType="pages:IndexStatusPageViewModel"
             x:Class="Kitopia.Desktop.Pages.IndexStatusPage">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="{DynamicResource SemiThicknessExtraLoose}" RowSpacing="16">
        <!-- 1. Header: Local search & models + Title + Subtitle -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource 'lang.kitopia.local_search_and_models'}" Theme="{DynamicResource KitopiaPageKickerText}" />
                <TextBlock Text="{DynamicResource 'lang.kitopia.file_indexing'}" Theme="{DynamicResource KitopiaPageTitleText}" />
                <TextBlock Text="{DynamicResource 'lang.kitopia.monitor_file_indexing_text_embeddings_and_image_processing'}"
                           Theme="{DynamicResource KitopiaPageSubtitleText}" />
            </StackPanel>
        </Grid>

        <!-- 2. Progress Card -->
        <Border Grid.Row="1" Theme="{DynamicResource KitopiaCard}" Padding="18">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.file_indexing_progress'}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorText0}" />
                    <TextBlock Grid.Column="1" Text="{Binding FileProgressText}"
                               FontSize="13"
                               Foreground="{DynamicResource SemiColorText1}" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <ProgressBar Height="8"
                                 CornerRadius="4"
                                 Foreground="{DynamicResource KitopiaPrimaryBrush}"
                                 Minimum="0"
                                 Maximum="{Binding ProgressMaximum}"
                                 Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" />
                    <Button Grid.Column="1"
                            Width="32" Height="32"
                            Padding="0" CornerRadius="6"
                            Command="{Binding ToggleIndexingCommand}"
                            ToolTip.Tip="{Binding IndexControlToolTip}">
                        <controls:FontIcon Glyph="{Binding IndexControlGlyph}" FontSize="16" />
                    </Button>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.current_stage'}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Grid.Column="1" Text="{Binding ActiveOperationText}" FontSize="13"
                               Foreground="{DynamicResource SemiColorText1}" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.current_file'}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CurrentItemText}"
                               FontSize="13"
                               Foreground="{DynamicResource SemiColorText1}"
                               TextWrapping="Wrap"
                               ToolTip.Tip="{Binding CurrentItemText}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Stat Cards -->
        <WrapPanel Grid.Row="2">
            <Border Theme="{DynamicResource KitopiaStatCard}" Width="156" Height="80" Margin="4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.total_items'}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding Status.TotalEntries}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource SemiColorText0}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Theme="{DynamicResource KitopiaStatCard}" Width="156" Height="80" Margin="4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.apps_and_plugins'}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding Status.ApplicationEntries}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource SemiColorText0}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Theme="{DynamicResource KitopiaStatCard}" Width="156" Height="80" Margin="4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.documents'}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding Status.DocumentEntries}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource SemiColorText0}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Theme="{DynamicResource KitopiaStatCard}" Width="156" Height="80" Margin="4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.images'}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding Status.ImageEntries}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource SemiColorText0}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Theme="{DynamicResource KitopiaStatCard}" Width="156" Height="80" Margin="4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.text_embeddings'}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding Status.TextVectorEntries}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource SemiColorText0}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Theme="{DynamicResource KitopiaStatCard}" Width="156" Height="80" Margin="4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 'lang.kitopia.image_embeddings'}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding Status.ImageVectorEntries}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource SemiColorText0}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- 4. Model & Control Details -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="0,4,0,0">
                <Border Theme="{DynamicResource KitopiaCard}" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                        <TextBlock Grid.Row="0" Text="{DynamicResource 'lang.kitopia.text_model'}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status.TextModel}" FontSize="13" Foreground="{DynamicResource SemiColorText0}" />
                        <TextBlock Grid.Row="1" Text="{DynamicResource 'lang.kitopia.image_model'}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status.ImageModel}" FontSize="13" Foreground="{DynamicResource SemiColorText0}" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource 'lang.kitopia.failed_images'}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Status.FailedImages}" FontSize="13" Foreground="{DynamicResource SemiColorText0}" />
                        <TextBlock Grid.Row="3" Text="{DynamicResource 'lang.kitopia.last_error'}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LatestErrorText}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource KitopiaBadgeDangerForeground}" />
                    </Grid>
                </Border>

                <WrapPanel>
                    <Button Margin="4" Content="{DynamicResource 'lang.kitopia.indexed_folders_and_files'}" CornerRadius="6" Height="32" Padding="14,0" Command="{Binding OpenManagedIndexSettingsCommand}" />
                    <Button Margin="4" Content="{DynamicResource 'lang.kitopia.everything_settings'}" CornerRadius="6" Height="32" Padding="14,0" Command="{Binding OpenEverythingSettingsCommand}" />
                    <Button Margin="4" Command="{Binding CancelIndexingCommand}" CornerRadius="6" Height="32" Padding="14,0" Content="{DynamicResource 'lang.kitopia.cancel_indexing'}" />
                    <Button Margin="4" Command="{Binding ConfirmResetAndRebuildCommand}" CornerRadius="6" Height="32" Padding="14,0" Content="{DynamicResource 'lang.kitopia.reset_and_rebuild_file_index'}" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
