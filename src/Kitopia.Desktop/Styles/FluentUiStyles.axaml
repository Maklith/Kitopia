<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <!-- Add Resources Here -->
    <FontWeight x:Key="TextBlockFontWeight">Bold</FontWeight>
    <FontWeight x:Key="ButtonDefaultFontWeight">Bold</FontWeight>
    <FontWeight x:Key="ExpanderHeaderFontWeight">Bold</FontWeight>
    <FontWeight x:Key="TextBlockTitleFontWeight">600</FontWeight>
    <Thickness x:Key="ButtonDefaultPadding">12 6</Thickness>

    <ControlTheme x:Key="KitopiaCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource KitopiaCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KitopiaCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource KitopiaCardBoxShadow}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource KitopiaCardHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KitopiaCardHoverBorderBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource KitopiaCardHoverBoxShadow}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="KitopiaCardBorderless" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource KitopiaCardBackgroundBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource KitopiaCardBoxShadow}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource KitopiaCardHoverBackgroundBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="KitopiaPluginCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource KitopiaCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KitopiaCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource KitopiaCardBoxShadow}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource KitopiaCardHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KitopiaCardHoverBorderBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource KitopiaCardHoverBoxShadow}" />
        </Style>
        <Style Selector="^.interactive:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="KitopiaPluginDownloadProgress" TargetType="ProgressBar"
                  BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource KitopiaPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource KitopiaBadgeNeutralBackground}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Style Selector="^:horizontal">
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="KitopiaStatCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource KitopiaCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KitopiaCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{DynamicResource KitopiaCardBoxShadow}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource KitopiaCardHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KitopiaCardHoverBorderBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource KitopiaCardHoverBoxShadow}" />
        </Style>
    </ControlTheme>



    <ControlTheme x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SemiFontSizeHeader6}" />
        <Setter Property="FontWeight" Value="{DynamicResource SemiFontWeightBold}" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    </ControlTheme>

    <ControlTheme x:Key="KitopiaPageKickerText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </ControlTheme>

    <ControlTheme x:Key="KitopiaPageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </ControlTheme>

    <ControlTheme x:Key="KitopiaPageSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </ControlTheme>

    <ControlTheme x:Key="KitopiaDangerSubtleButton" TargetType="Button" BasedOn="{StaticResource BorderlessButton}">
        <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeDangerForeground}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeDangerBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeDangerForeground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeDangerBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeDangerForeground}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="KitopiaDangerOutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource KitopiaCardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeDangerForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KitopiaBadgeDangerBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeDangerBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KitopiaBadgeDangerBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeDangerForeground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeDangerBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeDangerForeground}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="KitopiaLinkButton" TargetType="Button" BasedOn="{StaticResource BorderlessButton}">
        <Setter Property="Foreground" Value="{DynamicResource KitopiaPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource KitopiaPrimaryHoverBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="KitopiaBadgeTagButton" TargetType="Button" BasedOn="{StaticResource BorderlessButton}">
        <Setter Property="Background" Value="{DynamicResource KitopiaBadgeTagBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeTagForeground}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1.5" />
        <Setter Property="MinHeight" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KitopiaBadgeTagHoverBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource KitopiaBadgeTagForeground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
