<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add Resources Here -->
    <SolidColorBrush x:Key="KSemiColorBackground4" Opacity="0.35" Color="{StaticResource SemiBackground4Color}" />

    <!-- Kitopia Fluent Design System Tokens (Dark Mode) -->
    <Color x:Key="KitopiaAccentColor">#4CC2FF</Color>
    <Color x:Key="KitopiaAccentHoverColor">#3AA8E0</Color>
    <Color x:Key="KitopiaAccentActiveColor">#288DC2</Color>

    <SolidColorBrush x:Key="KitopiaPrimaryBrush" Color="{DynamicResource KitopiaAccentColor}" />
    <SolidColorBrush x:Key="KitopiaPrimaryHoverBrush" Color="{DynamicResource KitopiaAccentHoverColor}" />
    <SolidColorBrush x:Key="KitopiaPrimaryActiveBrush" Color="{DynamicResource KitopiaAccentActiveColor}" />
    <SolidColorBrush x:Key="KitopiaPrimaryLightBrush" Color="{DynamicResource KitopiaAccentColor}" Opacity="0.15" />

    <SolidColorBrush x:Key="KitopiaCardBackgroundBrush" Color="#242424" />
    <SolidColorBrush x:Key="KitopiaCardHoverBackgroundBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="KitopiaCardBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="KitopiaCardHoverBorderBrush" Color="#30FFFFFF" />
    <BoxShadows x:Key="KitopiaCardBoxShadow">0 1 3 0 #30000000, 0 2 8 0 #20000000</BoxShadows>
    <BoxShadows x:Key="KitopiaCardHoverBoxShadow">0 4 14 0 #50000000, 0 2 4 0 #30000000</BoxShadows>

    <!-- Badges & Tags -->
    <SolidColorBrush x:Key="KitopiaBadgeSuccessBackground" Color="#40107C41" />
    <SolidColorBrush x:Key="KitopiaBadgeSuccessForeground" Color="#6CE89F" />
    <SolidColorBrush x:Key="KitopiaBadgeCurrentBackground" Color="{DynamicResource KitopiaAccentColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="KitopiaBadgeCurrentForeground" Color="{DynamicResource KitopiaAccentColor}" />
    <SolidColorBrush x:Key="KitopiaBadgeNeutralBackground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="KitopiaBadgeNeutralForeground" Color="#D1D5DB" />
    <SolidColorBrush x:Key="KitopiaBadgeDangerBackground" Color="#40C42B1C" />
    <SolidColorBrush x:Key="KitopiaBadgeDangerForeground" Color="#FF9990" />
    <SolidColorBrush x:Key="KitopiaBadgeDangerBorder" Color="#59FF9990" />
    <SolidColorBrush x:Key="KitopiaBadgeTagBackground" Color="{DynamicResource KitopiaAccentColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="KitopiaBadgeTagHoverBackground" Color="{DynamicResource KitopiaAccentColor}" Opacity="0.22" />
    <SolidColorBrush x:Key="KitopiaBadgeTagForeground" Color="{DynamicResource KitopiaAccentColor}" />

    <SolidColorBrush x:Key="KitopiaAvatarBackground" Color="{DynamicResource KitopiaAccentColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="KitopiaAvatarForeground" Color="{DynamicResource KitopiaAccentColor}" />

    <!-- Fluent ToggleSwitch Accent Color -->
    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedBackground" Color="{DynamicResource KitopiaAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground" Color="{DynamicResource KitopiaAccentHoverColor}" />
    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground" Color="{DynamicResource KitopiaAccentActiveColor}" />

    <!-- Navigation / ListBox Item Hover & Select Tokens -->
    <SolidColorBrush x:Key="ListBoxItemPointeroverBackground" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="{DynamicResource KitopiaAccentColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="{DynamicResource KitopiaAccentColor}" Opacity="0.22" />

    <!-- Fluent Keycap (Keyboard KBD) Tokens -->
    <SolidColorBrush x:Key="KitopiaKeycapBackground" Color="#2A2A2D" />
    <SolidColorBrush x:Key="KitopiaKeycapHoverBackground" Color="#333337" />
    <SolidColorBrush x:Key="KitopiaKeycapBorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="KitopiaKeycapForeground" Color="#F8FAFC" />
    <BoxShadows x:Key="KitopiaKeycapBoxShadow">0 1 0 0 #18181B, 0 1 2 0 #40000000</BoxShadows>
    <BoxShadows x:Key="KitopiaKeycapHoverBoxShadow">0 1 0 0 #09090B, 0 2 4 0 #60000000</BoxShadows>
</ResourceDictionary>
