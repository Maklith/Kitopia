<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add Resources Here -->
    <SolidColorBrush x:Key="KSemiColorBackground4" Opacity="0.35" Color="{StaticResource SemiBackground4Color}" />

    <!-- Kitopia Fluent Design System Tokens (Light Mode) -->
    <Color x:Key="KitopiaAccentColor">#0064FA</Color>
    <Color x:Key="KitopiaAccentHoverColor">#0052D9</Color>
    <Color x:Key="KitopiaAccentActiveColor">#0041B2</Color>
    <Color x:Key="KitopiaAccentLightColor">#E8F3FF</Color>
    <Color x:Key="KitopiaAccentLightHoverColor">#CBE4FE</Color>

    <SolidColorBrush x:Key="KitopiaPrimaryBrush" Color="{DynamicResource KitopiaAccentColor}" />
    <SolidColorBrush x:Key="KitopiaPrimaryHoverBrush" Color="{DynamicResource KitopiaAccentHoverColor}" />
    <SolidColorBrush x:Key="KitopiaPrimaryActiveBrush" Color="{DynamicResource KitopiaAccentActiveColor}" />
    <SolidColorBrush x:Key="KitopiaPrimaryLightBrush" Color="{DynamicResource KitopiaAccentLightColor}" />

    <SolidColorBrush x:Key="KitopiaCardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KitopiaCardHoverBackgroundBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="KitopiaCardBorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="KitopiaCardHoverBorderBrush" Color="#22000000" />
    <BoxShadows x:Key="KitopiaCardBoxShadow">0 1 3 0 #0A000000, 0 2 8 0 #05000000</BoxShadows>
    <BoxShadows x:Key="KitopiaCardHoverBoxShadow">0 4 14 0 #12000000, 0 1 3 0 #08000000</BoxShadows>

    <!-- Badges & Tags -->
    <SolidColorBrush x:Key="KitopiaBadgeSuccessBackground" Color="#E6F7EC" />
    <SolidColorBrush x:Key="KitopiaBadgeSuccessForeground" Color="#107C41" />
    <SolidColorBrush x:Key="KitopiaBadgeCurrentBackground" Color="{DynamicResource KitopiaAccentLightColor}" />
    <SolidColorBrush x:Key="KitopiaBadgeCurrentForeground" Color="{DynamicResource KitopiaAccentColor}" />
    <SolidColorBrush x:Key="KitopiaBadgeNeutralBackground" Color="#F0F2F5" />
    <SolidColorBrush x:Key="KitopiaBadgeNeutralForeground" Color="#4B5563" />
    <SolidColorBrush x:Key="KitopiaBadgeDangerBackground" Color="#FDF3F2" />
    <SolidColorBrush x:Key="KitopiaBadgeDangerForeground" Color="#C42B1C" />
    <SolidColorBrush x:Key="KitopiaBadgeDangerBorder" Color="#59C42B1C" />
    <SolidColorBrush x:Key="KitopiaBadgeTagBackground" Color="{DynamicResource KitopiaAccentLightColor}" />
    <SolidColorBrush x:Key="KitopiaBadgeTagHoverBackground" Color="{DynamicResource KitopiaAccentLightHoverColor}" />
    <SolidColorBrush x:Key="KitopiaBadgeTagForeground" Color="{DynamicResource KitopiaAccentColor}" />

    <SolidColorBrush x:Key="KitopiaAvatarBackground" Color="{DynamicResource KitopiaAccentLightColor}" />
    <SolidColorBrush x:Key="KitopiaAvatarForeground" Color="{DynamicResource KitopiaAccentColor}" />

    <!-- Fluent ToggleSwitch Accent Color -->
    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedBackground" Color="{DynamicResource KitopiaAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground" Color="{DynamicResource KitopiaAccentHoverColor}" />
    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground" Color="{DynamicResource KitopiaAccentActiveColor}" />

    <!-- Navigation / ListBox Item Hover & Select Tokens -->
    <SolidColorBrush x:Key="ListBoxItemPointeroverBackground" Color="#0F000000" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="{DynamicResource KitopiaAccentLightColor}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="{DynamicResource KitopiaAccentLightHoverColor}" />

    <!-- Fluent Keycap (Keyboard KBD) Tokens -->
    <SolidColorBrush x:Key="KitopiaKeycapBackground" Color="#F8FAFC" />
    <SolidColorBrush x:Key="KitopiaKeycapHoverBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KitopiaKeycapBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="KitopiaKeycapForeground" Color="#0F172A" />
    <BoxShadows x:Key="KitopiaKeycapBoxShadow">0 1 0 0 #94A3B8, 0 1 2 0 #12000000</BoxShadows>
    <BoxShadows x:Key="KitopiaKeycapHoverBoxShadow">0 1 0 0 #64748B, 0 2 4 0 #18000000</BoxShadows>
</ResourceDictionary>
