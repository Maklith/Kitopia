<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:controls1="clr-namespace:Kitopia.Desktop.Controls"
        xmlns:pluginCore="clr-namespace:PluginCore;assembly=PluginCore"
        xmlns:converter1="clr-namespace:Kitopia.Desktop.Converter"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:inputData="clr-namespace:PluginCore.SearchWindow.InputData;assembly=PluginCore"
        xmlns:windows="clr-namespace:Kitopia.Desktop.Features.Search.ViewModels;assembly=Kitopia.Desktop.Features"
        xmlns:searchWindow="clr-namespace:Kitopia.Desktop.Converter.SearchWindow"
        xmlns:localization="clr-namespace:Kitopia.Feature.Localization;assembly=Kitopia.Feature"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="540"
        x:Class="Kitopia.Desktop.Windows.SearchWindow"
        x:DataType="windows:SearchWindowViewModel"
        Deactivated="w_Deactivated"
        Classes="acrylic"
        Classes.preview="{Binding IsPreviewMode}"
        Background="Transparent"
        Activated="w_Activated"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        Width="960"
        MaxWidth="960"
        MinWidth="960"
        MinHeight="180"
        MaxHeight="768"
        SizeToContent="Height"
        WindowDecorations="BorderOnly"

        KeyDown="InputElement_OnKeyDown"
        Topmost="True"
        CanResize="False"
        Closing="Window_OnClosing"
        Title="SearchWindow">
    <Window.Resources>
        <searchWindow:StarBoolToText x:Key="StarBoolToText" />
        <searchWindow:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <searchWindow:PathToImageConverter x:Key="PathToImageConverter" />
        <searchWindow:SearchItemToInfo x:Key="SearchItemToInfo" />
        <searchWindow:CanIgnoreCtr x:Key="CanIgnoreCtr" />
        <searchWindow:SymbolToVisible x:Key="SymbolToVisible" />
        <converter1:IntToIconSymbol x:Key="IntToIconSymbol" />
        <searchWindow:ItemNameMatchCtr x:Key="ItemNameMatchCtr" />
        <converter1:ControlContentSize x:Key="ControlContentSize" />
        <searchWindow:PreviewModeToGridLengthConverter x:Key="PreviewModeToGridLengthConverter" />
        <ControlTheme x:Key="SearchSelectionItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="PinnedSelectionItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="PinnedItemButton" TargetType="Button">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="Transparent"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="SearchItemButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="Transparent"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="ListBox#dataGrid Image.search-item-icon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
        </Style>
        <Style Selector="ListBox#dataGrid controls1|FontIcon.search-item-icon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="48" />
        </Style>
        <Style Selector="Window.preview ListBox#dataGrid Image.search-item-icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="Window.preview ListBox#dataGrid controls1|FontIcon.search-item-icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="28" />
        </Style>
        <Style Selector="ListBox#dataGrid TextBlock.search-item-title">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="Window.preview ListBox#dataGrid TextBlock.search-item-title">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="ListBox#dataGrid TextBlock.search-item-subtitle">
            <Setter Property="FontSize" Value="{DynamicResource SemiFontSizeSmall}" />
        </Style>
        <Style Selector="Window.preview ListBox#dataGrid TextBlock.search-item-subtitle">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Window.preview ListBox#dataGrid Button#Item">
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Window.preview > Panel">
            <Setter Property="MinHeight" Value="{Binding $parent[Window].MaxHeight}" />
        </Style>
    </Window.Styles>
    <Panel VerticalAlignment="Stretch">
        <Panel.Background>
            <DynamicResource ResourceKey="KitopiaWindowBackground" />
        </Panel.Background>
        <Grid RowDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">
            <Border BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                <StackPanel Spacing="8">
                    <Border Height="30">
                        <ScrollViewer PointerWheelChanged="HorizonScroll" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Center"
                                      VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding InputDatas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="inputData:InputData">
                                        <Button Classes="Small" Margin="4,0" VerticalAlignment="Center"
                                                Content="{Binding  InputType}" Height="22" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBox VerticalContentAlignment="Center" VerticalAlignment="Center"
                             PlaceholderText="{DynamicResource 'lang.kitopia.search'}" AcceptsReturn="False" KeyDown="tx_KeyDown"
                             Name="tx"
                             AcceptsTab="False" FontSize="24" ClearSelectionOnLostFocus="False"
                             Text="{Binding Search}">
                        <TextBox.InnerLeftContent>
                            <controls1:FontIcon Margin="10,0,0,0" HorizontalAlignment="Center"
                                                FontFamily="{StaticResource FluentFont}"
                                                Glyph="&#xf691;" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0">
                                <Border Name="SemanticSearchIndicator" IsVisible="{Binding IsSemanticSearching}"
                                        IsHitTestVisible="False" Height="28" Padding="8,0" CornerRadius="9999"
                                        Background="{DynamicResource KitopiaBadgeCurrentBackground}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ProgressBar Name="SemanticSearchProgress" Width="28" Height="3"
                                                     Theme="{DynamicResource KitopiaPluginDownloadProgress}"
                                                     IsIndeterminate="{Binding IsSemanticSearching}"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource 'lang.kitopia.semantic_searching'}"
                                                   Foreground="{DynamicResource KitopiaBadgeCurrentForeground}"
                                                   FontSize="12" FontWeight="Normal" MaxWidth="180"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button Theme="{DynamicResource BorderlessButton}" ToolTip.Tip="{DynamicResource 'lang.kitopia.toggle_list_preview'}"
                                        IsVisible="{Binding CanUsePreview}"
                                        Command="{Binding TogglePreviewModeCommand}">
                                    <controls1:FontIcon FontFamily="{StaticResource FluentFont}" Glyph="&#xf8cb;" />
                                </Button>
                            </StackPanel>
                        </TextBox.InnerRightContent>
                    </TextBox>

                    <u:Banner Focusable="False" Type="Warning" Content="{DynamicResource 'lang.kitopia.everything_is_not_running_document_search_is_unavailable'}"
                              IsVisible="{Binding !EverythingIsOk}"
                              CanClose="True" />
                    <u:Banner Focusable="False" Type="Information" Content="{DynamicResource 'lang.kitopia.selection_mode'}"
                              IsVisible="{Binding NowInSelectMode}"
                              CanClose="False" />

                    <Border IsVisible="{Binding ShowFileTypeFilter}" Height="40">
                        <ScrollViewer PointerWheelChanged="HorizonScroll" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Center"
                                      VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding FileTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="windows:FileTypeFilter">
                                        <ToggleButton Margin="4,0" ClickMode="Press"
                                                      IsCheckedChanged="ToggleButton_OnIsCheckedChanged"
                                                      VerticalAlignment="Center" Content="{Binding  FileType}" Height="32"
                                                      IsChecked="{Binding IsChecked}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Border IsVisible="{Binding ShowPinnedItems}"
                            HorizontalAlignment="Stretch" Padding="0,2">
                        <ListBox Name="PinnedList" ItemsSource="{Binding PinnedItems}"
                                 ItemContainerTheme="{StaticResource PinnedSelectionItem}"
                                 SelectionChanged="SearchItems_OnSelectionChanged"
                                 PointerWheelChanged="HorizonScroll"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="pluginCore:SearchViewItem">
                                    <Button Name="PinnedItem" Height="30" Padding="10,0"
                                            Focusable="False" IsTabStop="False"
                                            Theme="{StaticResource PinnedItemButton}"
                                            Command="{Binding $parent[ItemsControl].((windows:SearchWindowViewModel)DataContext).OpenFileCommand}"
                                            CommandParameter="{Binding .}"
                                            ToolTip.Tip="{Binding ItemDisplayName}">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{DynamicResource 'lang.kitopia.open'}"
                                                          Command="{Binding $parent[Window].((windows:SearchWindowViewModel)DataContext).OpenFileCommand}"
                                                          CommandParameter="{Binding .}" />
                                                <MenuItem Header="{DynamicResource 'lang.kitopia.run_as_administrator'}"
                                                          Command="{Binding $parent[Window].((windows:SearchWindowViewModel)DataContext).RunAsAdminCommand}"
                                                          CommandParameter="{Binding .}" />
                                                <MenuItem Header="{DynamicResource 'lang.kitopia.open_file_location'}"
                                                          Command="{Binding $parent[Window].((windows:SearchWindowViewModel)DataContext).OpenFolderCommand}"
                                                          CommandParameter="{Binding .}" />
                                                <MenuItem Header="{DynamicResource 'lang.kitopia.open_in_terminal'}"
                                                          Command="{Binding $parent[Window].((windows:SearchWindowViewModel)DataContext).OpenFolderInTerminalCommand}"
                                                          CommandParameter="{Binding .}" />
                                                <MenuItem Header="{DynamicResource 'lang.kitopia.pin'}" IsVisible="{Binding !IsPined}"
                                                          Command="{Binding $parent[Window].((windows:SearchWindowViewModel)DataContext).PinCommand}"
                                                          CommandParameter="{Binding .}" />
                                                <MenuItem Header="{DynamicResource 'lang.kitopia.unpin'}" IsVisible="{Binding IsPined}"
                                                          Command="{Binding $parent[Window].((windows:SearchWindowViewModel)DataContext).PinCommand}"
                                                          CommandParameter="{Binding .}" />
                                                <MenuItem Header="{DynamicResource 'lang.kitopia.favorite'}"
                                                          Command="{Binding $parent[Window].((windows:SearchWindowViewModel)DataContext).StarCommand}"
                                                          CommandParameter="{Binding .}" />
                                                <MenuItem Header="{DynamicResource 'lang.kitopia.ignore'}"
                                                          Command="{Binding $parent[Window].((windows:SearchWindowViewModel)DataContext).IgnoreItemCommand}"
                                                          CommandParameter="{Binding .}" />
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Panel Width="18" Height="18" VerticalAlignment="Center">
                                                <controls1:FontIcon Width="18" Height="18" FontSize="16"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                    IsVisible="{Binding IconSymbol, Converter={StaticResource SymbolToVisible}}"
                                                                    FontFamily="{StaticResource FluentFont}"
                                                                    Glyph="{Binding IconSymbol, Converter={StaticResource IntToIconSymbol}}" />
                                                <Image Width="18" Height="18"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource PathToImageConverter}">
                                                            <Binding Path="Icon" />
                                                            <Binding Path="." />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Panel>
                                            <TextBlock Text="{Binding ItemDisplayName}" FontSize="12"
                                                       VerticalAlignment="Center" TextAlignment="Left"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" MinHeight="0" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding IsPreviewMode, Converter={StaticResource PreviewModeToGridLengthConverter}, ConverterParameter=List}" />
                    <ColumnDefinition Width="{Binding IsPreviewMode, Converter={StaticResource PreviewModeToGridLengthConverter}, ConverterParameter=Divider}" />
                    <ColumnDefinition Width="{Binding IsPreviewMode, Converter={StaticResource PreviewModeToGridLengthConverter}, ConverterParameter=Preview}" />
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" Name="dataGrid"
                         IsVisible="{Binding !IsEverythingMode}"
                         ItemContainerTheme="{StaticResource SearchSelectionItem}"
                         ItemsSource="{Binding ItemsViewList,Mode=OneWay }"
                         SelectedItem="{Binding SelectedItem,Mode=TwoWay}"
                         SelectionChanged="SearchItems_OnSelectionChanged"
                         BorderThickness="0"
                         Padding="6,4,2,4"
                         Background="Transparent"
                         MinHeight="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pluginCore:SearchViewItem">
                            <Button HorizontalAlignment="Stretch"
                                    Focusable="False" IsTabStop="False"
                                    Name="Item"
                                    Theme="{StaticResource SearchItemButton}"
                                    Click="SearchItem_OnClick"
                                    CommandParameter="{Binding .}">
                                <ToolTip.Tip>
                                    <MultiBinding Converter="{StaticResource SearchItemToInfo}">
                                        <Binding Path="." />
                                        <ReflectionBinding Source="{x:Static localization:Lang.Current}" Path="Keys" />
                                    </MultiBinding>
                                </ToolTip.Tip>
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{DynamicResource 'lang.kitopia.run_as_administrator'}"
                                                  Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).RunAsAdminCommand}"
                                                  IsVisible="{Binding Path=FileType,Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='RunAsAdmin'}"
                                                  CommandParameter="{Binding .}" />
                                        <MenuItem Header="{DynamicResource 'lang.kitopia.open_file_location'}"
                                                  Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).OpenFolderCommand}"
                                                  IsVisible="{Binding Path=FileType,Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Folder'}"
                                                  CommandParameter="{Binding .}" />
                                        <MenuItem Header="{DynamicResource 'lang.kitopia.open_in_terminal'}"
                                                  Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).OpenFolderInTerminalCommand}"
                                                  IsVisible="{Binding Path=FileType,Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Console'}"
                                                  CommandParameter="{Binding .}" />
                                        <MenuItem Header="{Binding IsStared,Converter={StaticResource StarBoolToText},ConverterParameter='Star'}"
                                                  Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).StarCommand}"
                                                  IsVisible="{Binding Path=FileType,Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Star'}"
                                                  CommandParameter="{Binding .}" />
                                        <MenuItem Header="{DynamicResource 'lang.kitopia.ignore'}"
                                                  Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).IgnoreItemCommand}"
                                                  IsVisible="{Binding Path=FileType,Converter={StaticResource CanIgnoreCtr}}"
                                                  CommandParameter="{Binding .}" />
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <Grid HorizontalAlignment="Stretch"
                                      ColumnDefinitions="Auto,Auto,* ,Auto">
                                    <Grid.Width>
                                        <MultiBinding Converter="{StaticResource ControlContentSize}">
                                            <MultiBinding.Bindings>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter, Tree=Visual}"
                                                         Path="Bounds.Width" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter, Tree=Visual}"
                                                         Path="Padding" />
                                            </MultiBinding.Bindings>
                                        </MultiBinding>
                                    </Grid.Width>
                                    <Panel Width="28"
                                           IsVisible="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).IsPreviewMode, Converter={x:Static BoolConverters.Not}}">
                                        <controls1:PinButton KeyboardNavigation.TabNavigation="None" FontSize="26"
                                                             IsVisible="{Binding Path=FileType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Pin'}"
                                                             Tag="{Binding IsPined}"
                                                             IsChecked="{Binding IsPined,Mode=OneWay}"
                                                             Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).PinCommand}"
                                                             CommandParameter="{Binding}" Padding="2" />
                                    </Panel>

                                    <Image Grid.Column="1" HorizontalAlignment="Left" Focusable="False" Classes="search-item-icon"
                                           ZIndex="1">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource PathToImageConverter}">
                                                <Binding Path="Icon" />
                                                <Binding Path="." />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <controls1:FontIcon Grid.Column="1" Classes="search-item-icon"
                                                        IsVisible="{Binding IconSymbol, Converter={StaticResource SymbolToVisible}}"
                                                        FontFamily="{StaticResource FluentFont}"
                                                        Glyph="{Binding IconSymbol,Converter={StaticResource IntToIconSymbol}}" />

                                    <StackPanel Grid.Column="2" Margin="8,2" VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch">
                                        <TextBlock Classes="search-item-title" VerticalAlignment="Center" Margin="0" Focusable="False"
                                                   Foreground="{DynamicResource SemiColorText0}"
                                                   FontWeight="Normal" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ItemDisplayName}">
                                            <TextBlock.Inlines>
                                                <MultiBinding Converter="{StaticResource ItemNameMatchCtr}">
                                                    <Binding Path="PinyinItem" />
                                                    <Binding Path="." />
                                                </MultiBinding>
                                            </TextBlock.Inlines>
                                            <Run />
                                        </TextBlock>
                                        <controls1:SearchItemSubtitle Classes="search-item-subtitle"
                                                                     VerticalAlignment="Top" Margin="0"
                                                                     Foreground="{DynamicResource SemiColorText1}"
                                                                     FontWeight="Normal"
                                                                     TextTrimming="CharacterEllipsis"
                                                                     DataContext="{Binding .}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Focusable="False"
                                                HorizontalAlignment="Right" Spacing="4"
                                                IsVisible="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).IsPreviewMode, Converter={x:Static BoolConverters.Not}}">
                                        <Button KeyboardNavigation.TabNavigation="None"
                                                Theme="{DynamicResource BorderlessButton}"
                                                ToolTip.Tip="{DynamicResource 'lang.kitopia.run_as_administrator'}"
                                                IsVisible="{Binding Path=FileType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='RunAsAdmin'}"
                                                Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).RunAsAdminCommand}"
                                                CommandParameter="{Binding  }">
                                            <controls1:FontIcon FontFamily="{StaticResource FluentFont}"
                                                                FontWeight="Normal" FontSize="22"
                                                                Glyph="&#xF0B2;" />
                                        </Button>
                                        <Button KeyboardNavigation.TabNavigation="None"
                                                Theme="{DynamicResource BorderlessButton}"
                                                ToolTip.Tip="{DynamicResource 'lang.kitopia.open_containing_folder'}"
                                                IsVisible="{Binding Path=FileType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Folder'}"
                                                Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).OpenFolderCommand}"
                                                CommandParameter="{Binding}">
                                            <controls1:FontIcon FontFamily="{StaticResource FluentFont}"
                                                                FontWeight="Normal" FontSize="22"
                                                                Glyph="&#xF419;" />
                                        </Button>
                                        <Button KeyboardNavigation.TabNavigation="None"
                                                Theme="{DynamicResource BorderlessButton}"
                                                ToolTip.Tip="{DynamicResource 'lang.kitopia.open_containing_folder_in_terminal'}"
                                                IsVisible="{Binding Path=FileType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Console'}"
                                                Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).OpenFolderInTerminalCommand}"
                                                CommandParameter="{Binding}">
                                            <controls1:FontIcon FontFamily="{StaticResource FluentFont}"
                                                                FontSize="22"
                                                                FontWeight="Normal"
                                                                Glyph="&#xEE6F;" />
                                        </Button>
                                        <Button KeyboardNavigation.TabNavigation="None"
                                                Theme="{DynamicResource BorderlessButton}"
                                                ToolTip.Tip="{Binding IsStared,Converter={StaticResource StarBoolToText},ConverterParameter='Star'}"
                                                IsVisible="{Binding Path=FileType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Star'}"
                                                Command="{Binding $parent[ListBox].((windows:SearchWindowViewModel)DataContext).StarCommand}"
                                                CommandParameter="{Binding}">
                                            <Button.Resources>
                                                <searchWindow:StarIconCtr x:Key="StarIconCtr" />
                                            </Button.Resources>
                                            <controls1:FontIcon x:Name="Source" FontWeight="Normal" FontSize="22"
                                                                FontFamily="{Binding IsStared,Converter={StaticResource StarIconCtr},ConverterParameter='FM'}"
                                                                Glyph="{Binding IsStared,Converter={StaticResource StarIconCtr},ConverterParameter='F'}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <controls1:EverythingFileListControl Grid.Column="0" Name="everythingControl"
                                                    IsVisible="{Binding IsEverythingMode}"
                                                    ItemsSource="{Binding ItemsViewList}"
                                                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                                    OpenFileCommand="{Binding OpenFileCommand}"
                                                    RunAsAdminCommand="{Binding RunAsAdminCommand}"
                                                    OpenFolderCommand="{Binding OpenFolderCommand}"
                                                    OpenFolderInTerminalCommand="{Binding OpenFolderInTerminalCommand}"
                                                    PinCommand="{Binding PinCommand}"
                                                    StarCommand="{Binding StarCommand}"
                                                    IgnoreItemCommand="{Binding IgnoreItemCommand}"
                                                    LoadMoreCommand="{Binding LoadMoreEverythingCommand}" />

                <GridSplitter Grid.Column="1" Width="1" ResizeDirection="Columns"
                              IsVisible="{Binding IsPreviewMode}" Background="{DynamicResource SemiColorBorder}" />

                <Border Grid.Column="2" IsVisible="{Binding IsPreviewMode}"
                        MinHeight="0" ClipToBounds="True" Margin="2,4,8,6"
                        Background="{DynamicResource SemiColorBackground0}"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1"
                        Padding="8">
                    <controls1:FilePreviewControl Name="FilePreviewSurface" DataContext="{Binding FilePreview}" />
                </Border>
            </Grid>

            <Border Grid.Row="2" IsVisible="{Binding IsPreviewMode}" Padding="12,4"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Text="{Binding SelectedItem.ItemDisplayName}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedItem.ItemDisplayName}" />
                    <StackPanel Grid.Row="1" Margin="0,0,8,0">
                        <TextBlock Text="{Binding FilePreview.FileDetails}" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SemiColorText1}" />
                        <TextBlock Text="{Binding FilePreview.Notice}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePreview.Notice}"
                                   IsVisible="{Binding FilePreview.Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{DynamicResource SemiColorText1}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                               TextAlignment="Right"
                               Text="{Binding FilePreview.SelectedPath}" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePreview.SelectedPath}"
                               Foreground="{DynamicResource SemiColorText1}" />
                </Grid>
            </Border>
        </Grid>
    </Panel>
</Window>
