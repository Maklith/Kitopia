<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Core.ViewModel.Pages.device;assembly=Core"
             xmlns:discoveredDevice="clr-namespace:Kitopia.DeviceCommunication.Discovery;assembly=Kitopia.DeviceCommunication"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Core.UI.DeviceCommunication.DeviceDiscoveryPage"
             x:DataType="vm:DeviceDiscoveryPageViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="{DynamicResource SemiThicknessExtraLoose}">
        <Border Theme="{DynamicResource KitopiaCard}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="设备发现" Classes="H5" Theme="{DynamicResource TitleTextBlock}" />
                <TextBlock Text="正在扫描..."
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText1}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding DiscoveredDevices}" Margin="4,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="discoveredDevice:DiscoveredDevice">
                        <Border Margin="8" MinWidth="360" MaxWidth="420"
                                Theme="{DynamicResource KitopiaCard}"
                                PointerPressed="OnDeviceCardPointerPressed">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="修改备注名" Click="OnEditCustomNameClick" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Label Theme="{DynamicResource TagLabel}" Classes="Green"
                                           IsVisible="{Binding HasIpv6}">IPv6</Label>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="16" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding ComputerName, StringFormat='计算机名: {0}'}"
                                               Foreground="{DynamicResource SemiColorText1}"
                                               FontSize="{DynamicResource SemiFontSizeSmall}" />
                                    <TextBlock Text="{Binding Ipv4Address, StringFormat='IPv4: {0}'}"
                                               Foreground="{DynamicResource SemiColorText1}"
                                               FontSize="{DynamicResource SemiFontSizeSmall}"
                                               IsVisible="{Binding HasIpv4}" />
                                    <TextBlock Text="{Binding Ipv6Address, StringFormat='IPv6: {0}'}"
                                               Foreground="{DynamicResource SemiColorText1}"
                                               FontSize="{DynamicResource SemiFontSizeSmall}"
                                               IsVisible="{Binding HasIpv6}" />
                                    <TextBlock Text="{Binding TcpPort, StringFormat='TCP 端口: {0}'}"
                                               Foreground="{DynamicResource SemiColorText1}"
                                               FontSize="{DynamicResource SemiFontSizeSmall}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
